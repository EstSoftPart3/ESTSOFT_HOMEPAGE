<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%-- 구글 드라이브 폴더 고르기 창(공통). 신입면접 배치·각 화면 ⚙ 드라이브 설정이 쓴다. 서버: /admin/my/driveFoldersData.do --%>
<style>
	.pk-list { border: 1px solid rgba(17,17,17,.12); border-radius: 8px; max-height: 50vh; overflow-y: auto; }
	.pk-it { display: flex; align-items: center; gap: 10px; width: 100%; border: 0; border-bottom: 1px solid #f0f1f3; background: #fff; padding: 9px 12px; text-align: left; font-size: 13.5px; }
	.pk-it:last-child { border-bottom: 0; }
	.pk-it:hover, .pk-it:focus { background: #f6fbfd; }
	.pk-it.on { background: #eef9fc; font-weight: 700; }
	.pk-sw { width: 12px; height: 12px; border-radius: 3px; flex: none; background: #9aa4ac; }
	.pk-meta { margin-left: auto; font-size: 12px; color: #5f6b75; font-weight: 400; }
	.pk-crumb { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; font-size: 13px; margin-bottom: 8px; }
	.pk-crumb button { border: 0; background: none; padding: 0; color: #0b6e8a; font-weight: 600; }
	.pk-crumb b { color: #1f2328; }
	.pk-tabs { display: flex; gap: 4px; margin-bottom: 8px; }
	.pk-tabs button { border: 1px solid rgba(17,17,17,.12); background: #fff; border-radius: 999px; padding: 3px 12px; font-size: 12.5px; font-weight: 700; color: #5f6b75; }
	.pk-tabs button[aria-pressed=true] { background: #111; color: #fff; border-color: #111; }
	.pk-sel { font-size: 12.5px; background: #eef9fc; color: #0b6e8a; border-radius: 6px; padding: 6px 10px; margin-top: 8px; }
	.pk-empty { padding: 14px; color: #5f6b75; font-size: 13px; text-align: center; }
	.pk-path .p { color: #5f6b75; }
	.ib-alert { background: #fdeaea; color: #8a1c1c; border-radius: 8px; padding: 8px 12px; font-size: 13px; }
	.ib-alert a { font-weight: 700; }
	.ib-alert ol { font-size: 12.5px; } .ib-alert li { margin-bottom: 2px; }
	/* 다른 창 위에 뜬다: bootbox 는 화면에 따라 1075(deploy_common), 화면 가이드 투어는 1080 이라 그 사이 */
	#folderPick { z-index: 1078 !important; }
</style>
<script>
// 구글 오류 { code, msg, url } → 빨간 칸 내용. API 꺼짐이면 켜는 순서까지
function boGoogleErr($e, err, retry) {
	$e.empty().append($('<div>').text(err.msg));
	if (err.code === 'API_OFF') {
		var $ol = $('<ol class="mb-1 mt-1 pl-3">').appendTo($e);
		$ol.append($('<li>').append('앱 키를 만든 구글 계정(연결 계정과 다를 수 있음)으로 ')
			.append($('<a target="_blank" rel="noopener">').attr('href', err.url).text('켜러 가기 ↗')).append(' 를 누릅니다.'));
		$ol.append($('<li>').text('맨 위 프로젝트 이름이 앱 키를 만든 프로젝트인지 확인합니다(내 연동 1단계 앱 키 앞부분 = 콘솔 「사용자 인증 정보」의 클라이언트 ID).'));
		$ol.append($('<li>').text('파란 「사용」 버튼을 누릅니다. 결제 정보는 필요 없습니다. 「관리」가 보이면 이미 켜진 것이니 프로젝트를 다시 확인합니다.'));
		$ol.append($('<li>').text('1~2분 뒤 아래 「다시 시도」를 누릅니다.'));
	} else if (err.code === 'NOLINK' || err.code === 'EXPIRED' || err.code === 'SCOPE') {
		$e.append($('<a>').attr('href', '/admin/my/openGoogleLink.do?back=' + encodeURIComponent(location.pathname + location.search)).text('내 연동에서 연결 ›'));
	}
	if (retry) $e.append($('<div class="mt-1">').append($('<button type="button" class="btn btn-sm btn-outline-danger">').text('다시 시도').on('click', retry)));
	return $e;
}

// 폴더 경로 [{id, name}] 를 '내 드라이브 › 인사 › 이력서' 로 그린다(마지막만 진하게)
function boPathView($el, path) {
	$el.empty().addClass('pk-path');
	if (!path || !path.length) return $el;
	return $el.append($('<span class="p">').text(path.slice(0, -1).map(function(x) { return x.name; }).concat(['']).join(' › '))).append($('<b>').text(path[path.length - 1].name));
}

// 폴더 하나의 경로. done(path) 또는 failed(err)
function boFolderPath(id, screen, done, failed) {
	$.post('/admin/my/driveFoldersData.do', { parent: id, screen: screen || '' }, function(res) {
		if (res.error || res.googleError) return failed && failed(res.googleError || { msg: res.error });
		done(res.path || []);
	}, 'json').fail(function() { if (failed) failed({ msg: '폴더를 불러오지 못했습니다.' }); });
}

// 폴더 고르기 창. opts: { title, current(폴더 ID), screen(⚙ 화면이면 그 화면 권한으로), onPick(folder{id,name}, path) }
// 「이 폴더로」는 지금 들어와 있는 폴더(경로의 끝)를 고른다
var boFd = null;
function boFolderPick(opts) {
	if (!$('#folderPick').length) {
		$('body').append('<div class="modal fade" id="folderPick" tabindex="-1" role="dialog" aria-labelledby="folderPickTitle" aria-hidden="true"><div class="modal-dialog" role="document"><div class="modal-content">'
			+ '<div class="modal-header"><h5 class="modal-title" id="folderPickTitle"></h5><button type="button" class="close" data-dismiss="modal" aria-label="닫기"><span aria-hidden="true">&times;</span></button></div>'
			+ '<div class="modal-body"><div class="pk-tabs"><button type="button" data-mode="MY" aria-pressed="true">내 드라이브</button><button type="button" data-mode="SHARED" aria-pressed="false">공유 문서함</button></div>'
			+ '<div class="pk-crumb" id="fdCrumb"></div>'
			+ '<input type="search" id="fdFind" class="form-control form-control-sm mb-2" placeholder="폴더 이름 찾기(Enter)" aria-label="폴더 이름 찾기">'
			+ '<div class="pk-list" id="fdList"></div><div class="pk-sel" id="fdSel"></div></div>'
			+ '<div class="modal-footer"><span class="small text-muted mr-auto">폴더를 누르면 들어가고, 위 경로를 누르면 올라갑니다</span><button type="button" class="btn btn-sm btn-outline-secondary" data-dismiss="modal">취소</button><button type="button" class="btn btn-sm btn-primary" id="fdOk" disabled>이 폴더로</button></div>'
			+ '</div></div></div>');
		// ⚙ 설정 창 위에 겹쳐 뜰 때: 뒤 배경을 설정 창 위로, 닫힌 뒤엔 설정 창이 계속 스크롤되게
		$('#folderPick').on('shown.bs.modal', function() { $('.modal-backdrop').last().css('z-index', 1077); })
			.on('hidden.bs.modal', function() { if ($('.modal.show').length) $('body').addClass('modal-open'); });
		$('#folderPick').on('click', '.pk-tabs button', function() { boFd.mode = $(this).data('mode'); boFd.parent = ''; $('#fdFind').val(''); boFdList(); });
		$('#fdFind').on('keydown', function(e) {
			if (e.key !== 'Enter' || e.originalEvent.isComposing) return;
			e.preventDefault();
			var v = $.trim(this.value), m = v.match(/\/folders\/([\w-]{10,})/);
			if (m) { boFd.parent = m[1]; this.value = ''; boFdList(); } else boFdList(v);
		});
		$('#fdOk').on('click', function() {
			var here = boFd.path[boFd.path.length - 1];
			if (!here) return;
			$('#folderPick').modal('hide');
			boFd.onPick(here, boFd.path);
		});
	}
	boFd = { mode: 'MY', parent: opts.current || '', path: [], screen: opts.screen || '', onPick: opts.onPick };
	$('#folderPickTitle').text(opts.title || '폴더 고르기');
	$('#fdFind').val('');
	$('#folderPick').modal('show');
	boFdList();
}
function boFdList(q) {
	$('#folderPick .pk-tabs button').each(function() { $(this).attr('aria-pressed', $(this).data('mode') === boFd.mode); });
	$('#fdList').html('<div class="pk-empty">불러오는 중입니다.</div>');
	$.post('/admin/my/driveFoldersData.do', { parent: boFd.parent, mode: boFd.mode, q: q || '', screen: boFd.screen }, function(res) {
		if (res.error || res.googleError) { $('#fdList').empty().append(boGoogleErr($('<div class="ib-alert m-0">'), res.googleError || { msg: res.error }, function() { boFdList(q); })); return; }
		boFd.path = res.path || [];
		// 공유받은 폴더 안이면 '공유 문서함' 탭을 켠다
		if (boFd.path.length) boFd.mode = boFd.path[0].id ? 'MY' : 'SHARED';
		$('#folderPick .pk-tabs button').each(function() { $(this).attr('aria-pressed', $(this).data('mode') === boFd.mode); });
		var $c = $('#fdCrumb').empty();
		if (q) $c.append($('<b>').text('「' + q + '」 찾은 결과'));
		else if (!boFd.path.length) $c.append($('<b>').text(boFd.mode === 'SHARED' ? '공유 문서함' : '내 드라이브'));
		else boFd.path.forEach(function(x, i) {
			if (i) $c.append($('<span class="text-muted">').text('›'));
			if (i === boFd.path.length - 1) $c.append($('<b>').text(x.name));
			// '공유받은 폴더'(id 없음)를 누르면 공유 문서함 맨 위로
			else $c.append($('<button type="button">').text(x.name).on('click', function() { if (x.id) boFd.parent = x.id; else { boFd.mode = 'SHARED'; boFd.parent = ''; } boFdList(); }));
		});
		var $l = $('#fdList').empty();
		if (!res.result.length) $l.append($('<div class="pk-empty">').text(q ? '찾는 폴더가 없습니다.' : '하위 폴더가 없습니다.'));
		res.result.forEach(function(f) {
			$l.append($('<button type="button" class="pk-it">').append($('<span>').text('📁')).append($('<span>').text(f.name)).append($('<span class="pk-meta">').text('›'))
				.attr('aria-label', f.name + ' 폴더 열기').on('click', function() { boFd.parent = f.id; $('#fdFind').val(''); boFdList(); }));
		});
		var here = boFd.path[boFd.path.length - 1];
		if (here) $('#fdSel').empty().append('고를 폴더: ').append(boPathView($('<span>'), boFd.path));
		else $('#fdSel').text(q ? '찾은 폴더를 눌러 들어간 뒤 고르세요' : '폴더를 눌러 들어간 뒤 고르세요');
		$('#fdOk').prop('disabled', !here);
	}, 'json').fail(function() { $('#fdList').html('<div class="pk-empty">폴더를 불러오지 못했습니다.</div>'); });
}
</script>
