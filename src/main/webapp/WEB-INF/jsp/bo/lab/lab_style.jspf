<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%-- 연구일지·연구소 관리 공통 --%>
<style>
	.lab-team { background: #dff1f7; border: 2px solid #0b6e8a; border-radius: 8px; padding: 6px 10px; }
	.lab-team label { color: #084f64; font-weight: 700; margin-bottom: 2px; }
	.lab-team select { font-weight: 700; }
	.lab-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 10px; }
	.lab-head h4 { margin: 0 auto 0 0; font-size: 20px; font-weight: 700; }
	.lab-tabs { display: flex; flex-wrap: wrap; gap: 2px; border-bottom: 1px solid #ced4da; margin-bottom: 12px; }
	.lab-tabs button { background: none; border: 0; border-bottom: 3px solid transparent; padding: 9px 18px; color: #495057; }
	.lab-tabs button[aria-selected="true"] { color: #0b6e8a; border-bottom-color: #0b6e8a; font-weight: 700; }
	.lab-back { display: flex; justify-content: center; margin: 18px 0 8px; }
	.lab-back .btn { min-width: 120px; }
	.lab-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
	.lab-pill { display: inline-block; padding: 1px 10px; border-radius: 12px; font-size: 13px; background: #eef1f4; color: #343a40; }
	.lab-pill.SUBMITTED { background: #fff1dc; color: #7a4300; }
	.lab-pill.APPROVED { background: #dcecf8; color: #0a4a78; }
	.lab-pill.CLOSED { background: #0a4a78; color: #fff; }
	.lab-info th { width: 120px; background: #f3f6f8; font-weight: 600; }
	.lab-open { color: #0b6e8a; font-weight: 600; text-decoration: underline; }
</style>
