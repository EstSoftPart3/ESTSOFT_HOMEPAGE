<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%-- 면접·교육생 관리 공통 스크립트 --%>
<script>
$(document).ajaxError(function() { bootbox.alert('처리하지 못했습니다. 입력 길이를 줄이거나 다시 로그인한 뒤 시도해 주세요.'); });

// 공통코드관리의 HR_ 그룹. { 그룹: [{CD, NM}] }
var HR_CODES = null;
// 화면용 공통코드 전체. 페이지를 그릴 때 서버가 넣는다
<%@ include file="/WEB-INF/jsp/bo/hr/codes.jspf"%>
// 코드 그룹으로 셀렉트 선택지를 채운다. first 는 맨 앞에 붙일 [값, 이름](예: ['', '전체'])
function hrFillSelect(sel, grp, first) {
	var $s = $(sel).empty();
	if (first) $s.append($('<option>').val(first[0]).text(first[1]));
	hrAllCodes(grp).forEach(function(c) { $s.append($('<option>').val(c.CD).text(c.NM)); });
	return $s;
}

function hrSetCodes(list) {
	HR_CODES = {};
	(list || []).forEach(function(c) { (HR_CODES[c.GRP] = HR_CODES[c.GRP] || []).push(c); });
}

function hrCodeName(grp, cd) {
	if (!cd) return '';
	var found = (HR_CODES[grp] || []).filter(function(c) { return c.CD === cd; })[0];
	return found ? found.NM : cd;
}

// ── 목록 메모(쌓기만, 본인 것만 삭제). 서버는 BoMemoController ──
// 주소: hrMemoApi('/admin/staff/') → memoListData.do, hrMemoApi('/admin/hr/', 'interview') → interviewMemoListData.do
function hrMemoApi(prefix, name) {
	function u(s) { return prefix + (name ? name + s : s.charAt(0).toLowerCase() + s.slice(1)) + 'Data.do'; }
	return { list: u('MemoList'), save: u('SaveMemo'), del: u('DeleteMemo') };
}

// $box 에 메모 목록과 입력칸을 그린다. changed 는 메모가 늘거나 줄면 부른다(목록 건수 갱신)
function hrMemoFeed($box, api, sq, changed, focus) {
	hrPost(api.list, { TARGET_SQ: sq }, function(res) {
		function redraw() { hrMemoFeed($box, api, sq, changed, true); if (changed) changed(); }
		var $f = $('<div class="hr-memo-feed">');
		res.result.list.forEach(function(m) {
			var $who = $('<div class="who">').append($('<b>').text(m.EMPLY_NM || m.EMPLY_ID)).append($('<span>').text(m.REG_DT));
			if (m.EMPLY_ID === res.result.me) $who.append($('<button type="button" class="btn btn-sm btn-link p-0 ml-auto text-danger">삭제</button>').on('click', function() {
				hrPost(api.del, { MEMO_SQ: m.MEMO_SQ }, redraw);
			}));
			$f.append($('<div class="it">').append($who).append($('<div>').text(m.CONTENT)));
		});
		if (!res.result.list.length) $f.append('<div class="text-muted small mb-2">메모가 없습니다.</div>');
		var $ta = $('<textarea class="form-control form-control-sm enter-send" rows="2" maxlength="2000" aria-label="메모 입력" placeholder="메모 입력 · Enter 등록, Shift+Enter 줄바꿈 (작성자·일시는 자동)">');
		var $add = $('<button type="button" class="btn btn-sm btn-primary mt-1">남기기</button>').on('click', function() {
			if (!$.trim($ta.val())) { $ta.focus(); return; }
			$add.prop('disabled', true);
			hrPost(api.save, { TARGET_SQ: sq, CONTENT: $ta.val() }, redraw, function() { $add.prop('disabled', false); });
		});
		$ta.on('enter-send', function() { if (!$add.prop('disabled')) $add.click(); });
		$box.empty().append($f).append($ta).append($('<div class="text-right">').append($add));
		if (focus) $ta.focus();
	});
}

// 목록 칸의 💬 건수 버튼. 누르면 메모 창이 열린다
function hrMemoBtn(api, sq, cnt, title, changed) {
	cnt = Number(cnt || 0);
	return $('<button type="button" class="hr-memo-btn">').toggleClass('zero', !cnt).attr('aria-label', title + ' 메모 ' + cnt + '건').text('💬' + (cnt ? ' ' + cnt : ''))
		.on('click', function(e) {
			e.stopPropagation();
			var $box = $('<div>');
			bootbox.dialog({ title: title + ' 메모', message: $box, onEscape: true, backdrop: true }).on('shown.bs.modal', function() { $box.find('textarea').focus(); });
			hrMemoFeed($box, api, sq, changed);
		});
}

// ── 화면별 드라이브 설정 ⚙ (회사 공통, 서버 DriveConfService). 그 화면 권한이 있는 사람에게만 버튼이 생긴다 ──
function hrDriveGear(screen) {
	$.post('/admin/my/driveConfData.do', { screen: screen }, function(res) {
		if (!res || !res.result) return;
		var $b = $('<button type="button" class="btn btn-sm btn-outline-secondary hr-drive-gear ml-auto">').html('<i class="fas fa-cog" aria-hidden="true"></i> 드라이브 설정')
			.on('click', function() { hrDriveConf(screen); });
		$('.content-wrapper .card-header').first().addClass('d-flex align-items-center').append($b);
	});
}

// 이름표 예시 값. 서버가 실제로 넣는 형식과 같다(입사일 점, 올린날짜 8자리, 연월 YYYY-MM)
var HR_DRIVE_SAMPLE = { '성명': '홍길동', '입사일': '2026.03.02', '서류명': '주민등록등본', '올린날짜': '20261116', '원래이름': '노트북구매영수증', '연월': '2026-11', '과제명': 'AI 플랫폼 개발' };
// 화면별로 실제 만들어지는 경로 예시: [제목, [칸 키 또는 '키+.확장자' 또는 '@고정 글자']]
var HR_DRIVE_PATHS = {
	STAFF: [['교육생 폴더', ['ROOT', 'WAIT', 'TRAINEE']], ['정규직 서류', ['ROOT', 'REG', 'PERSON', 'DOCS', 'FILE+.pdf']], ['계약직·프리 이력카드', ['ROOT', 'CON', 'PERSON', 'WORD+.docx']], ['퇴사자', ['ROOT', 'LEFT', 'PERSON']]],
	EQUIP: [['구매영수증', ['ROOT', 'RECEIPT', 'FILE+.pdf']], ['기타 첨부', ['ROOT', 'ETC', 'FILE+.jpg']], ['서명한 대여증서', ['ROOT', 'SIGN', '@(서명한 증서 파일)']]],
	LAB: [['마감 PDF', ['@(과제 폴더)', 'SUB', 'FILE+.pdf']]],
	PARTNER: [['서류 글자 읽기', ['TEMP', '@(읽는 동안만 잠깐 생겼다 지워지는 파일)']]]
};
function hrDriveRender(pattern) {
	return String(pattern || '').replace(/\{([^{}]+)\}/g, function(all, k) { return (HR_DRIVE_SAMPLE[k] || '').replace(/\//g, '·'); }).trim();
}

// ⚙ 드라이브 설정 창(모든 화면 공통). 위: 📁 폴더 위치(드라이브를 열어 고름, 맨 위부터 전체 경로), 아래: 🏷 이름 규칙(예시), 끝: 이렇게 만들어집니다
function hrDriveConf(screen) {
	hrPost('/admin/my/driveConfData.do', { screen: screen }, function(res) {
		var $f = $('<div class="hr-dc">'), folderName = {}, fields = {}, rootPath = null, redraw = [];
		var $folders = $('<div class="hr-dc-list">'), $names = $('<div>');
		// 칸 하나의 지금 모습: 입력값, 비었으면 기본값. 폴더 칸은 고른 폴더 이름
		function shown(key) {
			var f = fields[key], v = $f.find('[name="' + key + '"]').val();
			if (!f) return '';
			if (f.KIND === 'folder') return folderName[key] || '(' + f.LABEL + ')';
			return hrDriveRender(v || f.DEFAULT);
		}
		function drawPaths() {
			var $p = $f.find('.hr-dc-paths').empty();
			(HR_DRIVE_PATHS[screen] || []).forEach(function(p) {
				var parts = p[1].map(function(k) {
					if (k.charAt(0) === '@') return k.substring(1);
					var ext = k.indexOf('+') > 0 ? k.substring(k.indexOf('+') + 1) : '';
					return shown(ext ? k.substring(0, k.indexOf('+')) : k) + ext;
				});
				$p.append($('<div class="hr-dc-path">').append($('<b>').text(p[0])).append($('<span>').text(parts.join(' › '))));
			});
		}
		res.result.fields.forEach(function(f) { fields[f.KEY] = f; });
		var root = fields.ROOT && fields.ROOT.KIND === 'folder' ? fields.ROOT : null; // 다른 폴더들이 기대는 최상위 폴더(있으면)
		res.result.fields.forEach(function(f) {
			var id = 'dc_' + f.KEY;
			if (f.KIND === 'folder') {
				// 폴더 칸: 드라이브를 열어 고른다. 값은 폴더 ID, 화면엔 맨 위부터 전체 경로
				var $in = $('<input type="hidden">').attr({ id: id, name: f.KEY }).val(f.VALUE);
				var $view = $('<div class="hr-dc-folder">').text('불러오는 중…'), $note = $('<div class="hr-dc-note">');
				var $pick = $('<button type="button" class="btn btn-sm btn-outline-primary">').text('폴더 고르기').attr('aria-label', f.LABEL + ' 고르기');
				var $reset = $('<button type="button" class="btn btn-sm btn-link px-1">').text('기본으로').attr('aria-label', f.LABEL + ' 기본으로').prop('hidden', !f.VALUE);
				var state = { path: null, name: null };
				// 고른 폴더면 전체 경로, 기본 이름이면 '최상위 › 이름'(없으면 만든다는 안내)
				var paint = function() {
					$note.empty().removeClass('ib-alert');
					$view.removeClass('text-warning');
					if (state.path && state.path.length) {
						folderName[f.KEY] = state.path[state.path.length - 1].name;
						boPathView($view, state.path);
					} else if (state.name) {
						folderName[f.KEY] = state.name;
						var base = root && f !== root && rootPath ? rootPath : null;
						boPathView($view, (base || []).concat([{ name: state.name }]));
						$note.text(f === root || !root ? '이 이름의 폴더를 드라이브에서 찾습니다. 직접 고르면 더 정확합니다.' : '최상위 폴더 안에서 이 이름으로 찾고, 없으면 처음 쓸 때 만듭니다.');
					} else {
						folderName[f.KEY] = '';
						$view.text('아직 고르지 않음').addClass('text-warning');
					}
					drawPaths();
				};
				redraw.push(paint);
				var load = function(folderId) {
					$view.text('경로를 불러오는 중…');
					boFolderPath(folderId, screen, function(p) {
						state = { path: p, name: null };
						if (f === root) { rootPath = p; redraw.forEach(function(r) { r(); }); } else paint();
					}, function(err) { state = { path: null, name: null }; paint(); boGoogleErr($note.addClass('ib-alert'), err, function() { $note.removeClass('ib-alert'); load(folderId); }); });
				};
				if (f.IS_ID) load(f.EFFECTIVE); else { state = { path: null, name: f.EFFECTIVE }; paint(); }
				$pick.on('click', function() {
					// 지금 폴더에서, 없으면 최상위 폴더에서 연다
					var start = $in.val() || (f.IS_ID ? f.EFFECTIVE : '') || (root && root.IS_ID && f !== root ? (root.VALUE || root.EFFECTIVE) : '');
					boFolderPick({ title: f.LABEL + ' 고르기', screen: screen, current: start,
						onPick: function(folder, path) {
							$in.val(folder.id); $reset.prop('hidden', false); state = { path: path, name: null };
							if (f === root) { rootPath = path; redraw.forEach(function(r) { r(); }); } else paint();
						} });
				});
				$reset.on('click', function() {
					$in.val(''); $reset.prop('hidden', true);
					// 기본이 이름이면 이름으로, 기본이 폴더(인사관리 등)면 저장 뒤 원래 폴더
					if (f.DEFAULT) { state = { path: null, name: f.DEFAULT }; paint(); } else { $view.text('저장하면 원래 폴더로 돌아갑니다'); $note.empty(); }
				});
				$folders.append($('<div class="hr-dc-item">')
					.append($('<div class="hr-dc-label">').attr('id', id + '_l').text(f.LABEL))
					.append($('<div class="hr-dc-main">').append($view).append($note))
					.append($('<div class="hr-dc-act">').append($reset).append($pick))
					.append($in));
				return;
			}
			var $g = $('<div class="form-group mb-2">').append($('<label class="small font-weight-bold mb-1">').attr('for', id).text(f.LABEL));
			var $txt = $('<input class="form-control form-control-sm" autocomplete="off">').attr({ id: id, name: f.KEY, maxlength: 300 }).val(f.VALUE).attr('placeholder', '기본: ' + (f.DEFAULT || '(없음)'));
			// 입력하는 대로 실제 이름 예시(비우면 기본값 기준)
			var $ex = $('<div class="hr-dc-ex">');
			var paintEx = function() { var r = hrDriveRender($txt.val() || f.DEFAULT); $ex.empty().append('예: ').append($('<b>').text(r || '(이름 없음)')); drawPaths(); };
			$txt.on('input', paintEx);
			$g.append($txt);
			if (f.TOKENS) {
				var $chips = $('<div class="mt-1">');
				f.TOKENS.split(',').forEach(function(t) {
					var k = t.replace(/[{}]/g, '');
					$chips.append($('<button type="button" class="btn btn-xs btn-outline-info mr-1">').text(t).attr({ title: '예: ' + HR_DRIVE_SAMPLE[k], 'aria-label': f.LABEL + '에 ' + t + ' 넣기 (예: ' + HR_DRIVE_SAMPLE[k] + ')' }).on('click', function() {
						var el = $txt[0], s = el.selectionStart == null ? el.value.length : el.selectionStart;
						if (!el.value) el.value = f.DEFAULT;
						else el.value = el.value.slice(0, s) + t + el.value.slice(el.selectionEnd == null ? s : el.selectionEnd);
						el.focus();
						paintEx();
					}));
				});
				$chips.append($('<span class="small text-muted">').text(f.TOKENS.split(',').map(function(t) { return t + ' = ' + HR_DRIVE_SAMPLE[t.replace(/[{}]/g, '')]; }).join(' · ')));
				$g.append($chips);
			}
			$g.append($ex);
			$names.append($g);
			setTimeout(paintEx);
		});
		if ($folders.children().length) $f.append('<div class="hr-dc-h">📁 폴더 위치 <span>드라이브를 열어 직접 고릅니다</span></div>').append($folders);
		if ($names.children().length) $f.append('<div class="hr-dc-h">🏷 이름 규칙 <span>이름표는 올릴 때 실제 값으로 바뀝니다 · 비우면 기본값</span></div>').append($names);
		$f.append($('<div class="hr-dc-box">').append('<div class="hr-dc-h m-0">이렇게 만들어집니다 <span>예시 값: 홍길동, 입사일 2026.03.02</span></div>').append('<div class="hr-dc-paths"></div>'));
		$f.append('<div class="small text-muted mt-2">바꾸면 새로 올리거나 옮기는 것부터 적용되고, 이미 있는 파일·폴더는 그대로입니다. 회사 공통 설정이라 누가 올려도 같은 규칙을 씁니다.</div>');
		setTimeout(drawPaths);
		// id 는 화면 가이드(EG.modals.hrDriveConf)가 이 창을 알아보는 데 쓴다
		bootbox.dialog({ title: res.result.title + ' · 드라이브 설정', message: $f, size: 'large', onEscape: true, buttons: {
			cancel: { label: '취소', className: 'btn-sm btn-outline-secondary' },
			ok: { label: '저장', className: 'btn-sm btn-primary', callback: function() {
				var data = { screen: screen };
				$f.find('input[name]').each(function() { data[this.name] = this.value; });
				hrPost('/admin/my/saveDriveConfData.do', data, function() { bootbox.hideAll(); hrToast('드라이브 설정을 저장했습니다.'); });
				return false;
			} }
		} }).attr('id', 'hrDriveConf');
	});
}

// 오른쪽 아래에 잠깐 뜨는 알림(드라이브 폴더 처리 결과 등)
function hrToast(msg) {
	var $t = $('#hrToast');
	if (!$t.length) $t = $('<div id="hrToast" role="status" aria-live="polite">').css({ position: 'fixed', right: '18px', bottom: '18px', zIndex: 2000, background: '#222', color: '#fff', fontSize: '13px', padding: '8px 14px', borderRadius: '6px', maxWidth: '420px', display: 'none' }).appendTo('body');
	$t.text(msg).stop(true, true).fadeIn(100).delay(4000).fadeOut(400);
}

function hrPost(url, data, done, failed) {
	$.post(url, data, function(res) {
		// [연동 필요:…] 는 include_bottom 의 boNeedLink 가 안내하고 내 연동으로 보낸다
		if (res.error) { if (res.error.indexOf('[연동 필요:') !== 0) bootbox.alert(res.error); if (failed) failed(); return; }
		if (res.driveNote) hrToast(res.driveNote); // 드라이브 폴더 만들기·옮기기 결과
		// 교육종료·중도이탈 전에 반납할 장비가 있으면 목록으로 확인받고 반납 승인(RETURN_YN=Y)을 붙여 다시 보낸다
		if (res.needReturn) {
			hrConfirmReturn(res.needReturn, function() {
				hrPost(url, $.isArray(data) ? data.concat([{ name: 'RETURN_YN', value: 'Y' }]) : typeof data === 'string' ? data + '&RETURN_YN=Y' : $.extend({}, data, { RETURN_YN: 'Y' }), done, failed);
			}, failed);
			return;
		}
		done(res);
	}).fail(function() { if (failed) failed(); });
}

function hrConfirmReturn(rents, ok, cancel) {
	var type = hrCodeMap('EQP_TYPE'), $b = $('<tbody>');
	rents.forEach(function(e) { $b.append($('<tr>').append($('<td>').text(e.EQP_NO), $('<td>').text(type[e.TYPE_CD] || e.TYPE_CD), $('<td>').text(e.MODEL_NM || '-'), $('<td>').text(e.START_DT || '-'))); });
	bootbox.confirm({
		title: '장비 반납을 확인하세요',
		message: $('<div>').append($('<p class="mb-2">').text('대여 중인 장비가 ' + rents.length + '대 있습니다. 확인을 누르면 오늘 날짜로 반납 처리하고 상태를 옮깁니다.'))
			.append($('<table class="table table-sm mb-0">').append('<thead><tr><th>장비번호</th><th>구분</th><th>모델</th><th>대여일</th></tr></thead>').append($b)),
		buttons: { confirm: { label: '반납하고 옮기기', className: 'btn-primary btn-sm' }, cancel: { label: '취소', className: 'btn-outline-secondary btn-sm' } },
		callback: function(yes) { if (yes) ok(); else if (cancel) cancel(); }
	});
}

// 날짜 입력칸은 날짜가 아닌 값을 빈칸으로 만들어 저장 때 지운다. 그런 값은 글자 입력으로 둔다
function hrInputType(type, val) {
	return type === 'date' && val && !/^\d{4}-\d{2}-\d{2}$/.test(val) ? 'text' : type || 'text';
}

// 종류에 맞는 입력칸. 종류: 'text', 'date', 'textarea', { code: 코드 그룹 }, { values: {값: 이름} }, { list: [[값, 이름]] }
function hrControl(type, val) {
	var $c;
	if (type === 'textarea') {
		$c = $('<textarea rows="3" class="form-control form-control-sm">');
	} else if (type && (type.code || type.values || type.list)) {
		$c = $('<select class="form-control form-control-sm">');
		if (type.code) {
			$c.append('<option value=""></option>');
			(HR_CODES[type.code] || []).forEach(function(o) { $c.append($('<option>').val(o.CD).text(o.NM)); });
		} else if (type.list) {
			type.list.forEach(function(o) { $c.append($('<option>').val(o[0]).text(o[1])); });
		} else {
			$.each(type.values, function(k, v) { $c.append($('<option>').val(k).text(v)); });
		}
		// 공통코드에서 삭제된 값도 빈칸으로 보이지 않게 넣는다
		if (val && !$c.find('option').filter(function() { return this.value === String(val); }).length) {
			$c.append($('<option>').val(val).text(val));
		}
	} else {
		$c = $('<input class="form-control form-control-sm">').attr('type', hrInputType(type, val));
	}
	return $c.val(val === undefined || val === null ? '' : val);
}

// 표 칸을 눌러 바로 고친다. opts: url, key: {키 이름: 값}, field, type, label, show(), value(), saved(새 값), paint($칸, 값)(선택: 글자 대신 그린다)
function hrEditable($td, opts) {
	function paint() { $td.empty(); if (opts.paint) opts.paint($td, opts.show()); else $td.text(opts.show() || ''); }
	function edit() {
		if ($td.find('.form-control').length) return;
		var before = opts.value(), $c = hrControl(opts.type, before).attr('aria-label', opts.label), closed = false;
		function finish(save) {
			if (closed) return;
			closed = true;
			var val = $.trim($c.val());
			if (!save || val === String(before === undefined || before === null ? '' : before)) { paint(); return; }
			$c.prop('disabled', true);
			hrPost(opts.url, $.extend({ FIELD: opts.field, VALUE: val }, opts.key), function() {
				opts.saved(val);
				paint();
			}, paint);
		}
		$td.empty().append($c);
		$c.on('blur', function() { finish(true); });
		$c.on('keydown', function(e) {
			if (e.key === 'Escape') { finish(false); $td.focus(); }
			// 여러 줄 칸(특이사항 등)은 Shift+Enter 로 줄바꿈
			else if (e.key === 'Enter' && !e.originalEvent.isComposing && !(opts.type === 'textarea' && e.shiftKey)) { e.preventDefault(); finish(true); $td.focus(); }
		});
		if ($c.is('select')) $c.on('change', function() { finish(true); });
		$c.focus();
	}
	paint();
	$td.addClass('hr-cell').attr({ tabindex: 0, title: '눌러서 바로 수정' }).on('click', edit)
		.on('keydown', function(e) { if (e.key === 'Enter' && e.target === this) { e.preventDefault(); edit(); } });
	return $td;
}

function hrTab(key, label, cnt, active) {
	return $('<button type="button" class="cate-tab" role="tab">').attr('data-tab', key).attr('aria-selected', active).toggleClass('active', active)
		.append($('<span>').text(label)).append($('<span class="cnt">').text(cnt));
}

function hrMultiOption(id, val, label, extra) {
	var boxId = id + '_' + val;
	return $('<div class="form-check form-check-inline">').toggleClass('hr-extra', !!extra)
		.append($('<input type="checkbox" class="form-check-input">').attr('id', boxId).val(val))
		.append($('<label class="form-check-label">').attr('for', boxId).text(label));
}

// FIELDS: [이름, 라벨, 칸 너비, 종류, 라벨 숨김]. 종류: 'textarea', 'date', { code: 코드 그룹 }, { multi: 코드 그룹 }, { values: {값: 이름} }, 없으면 글자 입력
function hrBuildFields(target, fields) {
	var $t = $(target);
	fields.forEach(function(f) {
		var id = 'f_' + f[0], type = f[3], $input;
		var $label = $('<label>').attr('for', id).toggleClass('sr-only', !!f[4]).text(f[1]);
		if (type && type.multi) {
			$input = $('<div role="group">').attr('aria-label', f[1]).attr('data-multi', f[0]).attr('id', id);
			(HR_CODES[type.multi] || []).forEach(function(c) { $input.append(hrMultiOption(id, c.CD, c.NM)); });
			$label.removeAttr('for');
		} else {
			if (type === 'textarea') {
				$input = $('<textarea rows="4" class="form-control form-control-sm">');
			} else if (type && type.code) {
				$input = $('<select class="form-control form-control-sm">').append('<option value=""></option>');
				(HR_CODES[type.code] || []).forEach(function(c) { $input.append($('<option>').val(c.CD).text(c.NM)); });
			} else if (type && type.values) {
				$input = $('<select class="form-control form-control-sm">');
				$.each(type.values, function(k, v) { $input.append($('<option>').val(k).text(v)); });
			} else {
				$input = $('<input class="form-control form-control-sm">').attr('type', type || 'text');
			}
			$input.attr({ id: id, name: f[0] });
		}
		$('<div class="mb-2">').addClass('col-md-' + f[2]).append($label).append($input).appendTo($t);
	});
}

function hrFillForm(form, fields, row) {
	$(form)[0].reset();
	// 지난번에 덧붙인 임시 선택지를 지운다
	$(form).find('.hr-extra').remove();
	fields.forEach(function(f) {
		var val = row[f[0]];
		if (f[3] === 'date') $(form).find('[name=' + f[0] + ']').attr('type', hrInputType('date', val));
		if (val === undefined || val === null) return;
		var $multi = $(form).find('[data-multi=' + f[0] + ']');
		if ($multi.length) {
			String(val).split(',').forEach(function(v) {
				var $box = $multi.find('input').filter(function() { return this.value === v; });
				// 공통코드에서 삭제된 값도 저장 때 지워지지 않게 선택지에 넣는다
				if (!$box.length) { $multi.append(hrMultiOption($multi.attr('id'), v, v, true)); $box = $multi.find('input').last(); }
				$box.prop('checked', true);
			});
			return;
		}
		var $el = $(form).find('[name=' + f[0] + ']');
		// 공통코드에서 삭제된 값도 빈칸으로 보여 저장 때 지워지지 않게 선택지에 넣는다
		if ($el.is('select') && !$el.find('option').filter(function() { return this.value === String(val); }).length) {
			$el.append($('<option class="hr-extra">').val(val).text(val));
		}
		$el.val(val);
	});
}

// 일반 입력값 + 여러 개 고르는 칸(코드를 쉼표로 이어 한 값으로 보낸다)
function hrFormData(form) {
	var data = $(form).serializeArray();
	$(form).find('[data-multi]').each(function() {
		var vals = $(this).find('input:checked').map(function() { return this.value; }).get();
		data.push({ name: $(this).attr('data-multi'), value: vals.join(',') });
	});
	return data;
}
</script>
