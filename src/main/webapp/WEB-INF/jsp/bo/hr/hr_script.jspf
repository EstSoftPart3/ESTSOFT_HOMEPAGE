<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%-- 면접·교육생 관리 공통 스크립트 --%>
<script>
$(document).ajaxError(function() { bootbox.alert('처리하지 못했습니다. 입력 길이를 줄이거나 다시 로그인한 뒤 시도해 주세요.'); });

// 공통코드관리의 HR_ 그룹. { 그룹: [{CD, NM}] }
var HR_CODES = null;
// 화면용 공통코드 전체. 페이지를 그릴 때 서버가 넣는다
<%@ include file="/WEB-INF/jsp/bo/hr/codes.jspf"%>
// 코드 그룹으로 셀렉트 선택지를 채운다. first 는 맨 앞에 붙일 [값, 이름](예: ['', '전체'])
function hrFillSelect(sel, grp, first) {
	var $s = $(sel).empty();
	if (first) $s.append($('<option>').val(first[0]).text(first[1]));
	hrAllCodes(grp).forEach(function(c) { $s.append($('<option>').val(c.CD).text(c.NM)); });
	return $s;
}

function hrSetCodes(list) {
	HR_CODES = {};
	(list || []).forEach(function(c) { (HR_CODES[c.GRP] = HR_CODES[c.GRP] || []).push(c); });
}

function hrCodeName(grp, cd) {
	if (!cd) return '';
	var found = (HR_CODES[grp] || []).filter(function(c) { return c.CD === cd; })[0];
	return found ? found.NM : cd;
}

// ── 목록 메모(쌓기만, 본인 것만 삭제). 서버는 BoMemoController ──
// 주소: hrMemoApi('/admin/staff/') → memoListData.do, hrMemoApi('/admin/hr/', 'interview') → interviewMemoListData.do
function hrMemoApi(prefix, name) {
	function u(s) { return prefix + (name ? name + s : s.charAt(0).toLowerCase() + s.slice(1)) + 'Data.do'; }
	return { list: u('MemoList'), save: u('SaveMemo'), del: u('DeleteMemo') };
}

// $box 에 메모 목록과 입력칸을 그린다. changed 는 메모가 늘거나 줄면 부른다(목록 건수 갱신)
function hrMemoFeed($box, api, sq, changed, focus) {
	hrPost(api.list, { TARGET_SQ: sq }, function(res) {
		function redraw() { hrMemoFeed($box, api, sq, changed, true); if (changed) changed(); }
		var $f = $('<div class="hr-memo-feed">');
		res.result.list.forEach(function(m) {
			var $who = $('<div class="who">').append($('<b>').text(m.EMPLY_NM || m.EMPLY_ID)).append($('<span>').text(m.REG_DT));
			if (m.EMPLY_ID === res.result.me) $who.append($('<button type="button" class="btn btn-sm btn-link p-0 ml-auto text-danger">삭제</button>').on('click', function() {
				hrPost(api.del, { MEMO_SQ: m.MEMO_SQ }, redraw);
			}));
			$f.append($('<div class="it">').append($who).append($('<div>').text(m.CONTENT)));
		});
		if (!res.result.list.length) $f.append('<div class="text-muted small mb-2">메모가 없습니다.</div>');
		var $ta = $('<textarea class="form-control form-control-sm enter-send" rows="2" maxlength="2000" aria-label="메모 입력" placeholder="메모 입력 · Enter 등록, Shift+Enter 줄바꿈 (작성자·일시는 자동)">');
		var $add = $('<button type="button" class="btn btn-sm btn-primary mt-1">남기기</button>').on('click', function() {
			if (!$.trim($ta.val())) { $ta.focus(); return; }
			$add.prop('disabled', true);
			hrPost(api.save, { TARGET_SQ: sq, CONTENT: $ta.val() }, redraw, function() { $add.prop('disabled', false); });
		});
		$ta.on('enter-send', function() { if (!$add.prop('disabled')) $add.click(); });
		$box.empty().append($f).append($ta).append($('<div class="text-right">').append($add));
		if (focus) $ta.focus();
	});
}

// 목록 칸의 💬 건수 버튼. 누르면 메모 창이 열린다
function hrMemoBtn(api, sq, cnt, title, changed) {
	cnt = Number(cnt || 0);
	return $('<button type="button" class="hr-memo-btn">').toggleClass('zero', !cnt).attr('aria-label', title + ' 메모 ' + cnt + '건').text('💬' + (cnt ? ' ' + cnt : ''))
		.on('click', function(e) {
			e.stopPropagation();
			var $box = $('<div>');
			bootbox.dialog({ title: title + ' 메모', message: $box, onEscape: true, backdrop: true }).on('shown.bs.modal', function() { $box.find('textarea').focus(); });
			hrMemoFeed($box, api, sq, changed);
		});
}

function hrPost(url, data, done, failed) {
	$.post(url, data, function(res) {
		if (res.error) { bootbox.alert(res.error); if (failed) failed(); return; }
		// 교육종료·중도이탈 전에 반납할 장비가 있으면 목록으로 확인받고 반납 승인(RETURN_YN=Y)을 붙여 다시 보낸다
		if (res.needReturn) {
			hrConfirmReturn(res.needReturn, function() {
				hrPost(url, $.isArray(data) ? data.concat([{ name: 'RETURN_YN', value: 'Y' }]) : typeof data === 'string' ? data + '&RETURN_YN=Y' : $.extend({}, data, { RETURN_YN: 'Y' }), done, failed);
			}, failed);
			return;
		}
		done(res);
	}).fail(function() { if (failed) failed(); });
}

function hrConfirmReturn(rents, ok, cancel) {
	var type = hrCodeMap('EQP_TYPE'), $b = $('<tbody>');
	rents.forEach(function(e) { $b.append($('<tr>').append($('<td>').text(e.EQP_NO), $('<td>').text(type[e.TYPE_CD] || e.TYPE_CD), $('<td>').text(e.MODEL_NM || '-'), $('<td>').text(e.START_DT || '-'))); });
	bootbox.confirm({
		title: '장비 반납을 확인하세요',
		message: $('<div>').append($('<p class="mb-2">').text('대여 중인 장비가 ' + rents.length + '대 있습니다. 확인을 누르면 오늘 날짜로 반납 처리하고 상태를 옮깁니다.'))
			.append($('<table class="table table-sm mb-0">').append('<thead><tr><th>장비번호</th><th>구분</th><th>모델</th><th>대여일</th></tr></thead>').append($b)),
		buttons: { confirm: { label: '반납하고 옮기기', className: 'btn-primary btn-sm' }, cancel: { label: '취소', className: 'btn-outline-secondary btn-sm' } },
		callback: function(yes) { if (yes) ok(); else if (cancel) cancel(); }
	});
}

// 날짜 입력칸은 날짜가 아닌 값을 빈칸으로 만들어 저장 때 지운다. 그런 값은 글자 입력으로 둔다
function hrInputType(type, val) {
	return type === 'date' && val && !/^\d{4}-\d{2}-\d{2}$/.test(val) ? 'text' : type || 'text';
}

// 종류에 맞는 입력칸. 종류: 'text', 'date', 'textarea', { code: 코드 그룹 }, { values: {값: 이름} }, { list: [[값, 이름]] }
function hrControl(type, val) {
	var $c;
	if (type === 'textarea') {
		$c = $('<textarea rows="3" class="form-control form-control-sm">');
	} else if (type && (type.code || type.values || type.list)) {
		$c = $('<select class="form-control form-control-sm">');
		if (type.code) {
			$c.append('<option value=""></option>');
			(HR_CODES[type.code] || []).forEach(function(o) { $c.append($('<option>').val(o.CD).text(o.NM)); });
		} else if (type.list) {
			type.list.forEach(function(o) { $c.append($('<option>').val(o[0]).text(o[1])); });
		} else {
			$.each(type.values, function(k, v) { $c.append($('<option>').val(k).text(v)); });
		}
		// 공통코드에서 삭제된 값도 빈칸으로 보이지 않게 넣는다
		if (val && !$c.find('option').filter(function() { return this.value === String(val); }).length) {
			$c.append($('<option>').val(val).text(val));
		}
	} else {
		$c = $('<input class="form-control form-control-sm">').attr('type', hrInputType(type, val));
	}
	return $c.val(val === undefined || val === null ? '' : val);
}

// 표 칸을 눌러 바로 고친다. opts: url, key: {키 이름: 값}, field, type, label, show(), value(), saved(새 값), paint($칸, 값)(선택: 글자 대신 그린다)
function hrEditable($td, opts) {
	function paint() { $td.empty(); if (opts.paint) opts.paint($td, opts.show()); else $td.text(opts.show() || ''); }
	function edit() {
		if ($td.find('.form-control').length) return;
		var before = opts.value(), $c = hrControl(opts.type, before).attr('aria-label', opts.label), closed = false;
		function finish(save) {
			if (closed) return;
			closed = true;
			var val = $.trim($c.val());
			if (!save || val === String(before === undefined || before === null ? '' : before)) { paint(); return; }
			$c.prop('disabled', true);
			hrPost(opts.url, $.extend({ FIELD: opts.field, VALUE: val }, opts.key), function() {
				opts.saved(val);
				paint();
			}, paint);
		}
		$td.empty().append($c);
		$c.on('blur', function() { finish(true); });
		$c.on('keydown', function(e) {
			if (e.key === 'Escape') { finish(false); $td.focus(); }
			// 여러 줄 칸(특이사항 등)은 Shift+Enter 로 줄바꿈
			else if (e.key === 'Enter' && !e.originalEvent.isComposing && !(opts.type === 'textarea' && e.shiftKey)) { e.preventDefault(); finish(true); $td.focus(); }
		});
		if ($c.is('select')) $c.on('change', function() { finish(true); });
		$c.focus();
	}
	paint();
	$td.addClass('hr-cell').attr({ tabindex: 0, title: '눌러서 바로 수정' }).on('click', edit)
		.on('keydown', function(e) { if (e.key === 'Enter' && e.target === this) { e.preventDefault(); edit(); } });
	return $td;
}

function hrTab(key, label, cnt, active) {
	return $('<button type="button" class="cate-tab" role="tab">').attr('data-tab', key).attr('aria-selected', active).toggleClass('active', active)
		.append($('<span>').text(label)).append($('<span class="cnt">').text(cnt));
}

function hrMultiOption(id, val, label, extra) {
	var boxId = id + '_' + val;
	return $('<div class="form-check form-check-inline">').toggleClass('hr-extra', !!extra)
		.append($('<input type="checkbox" class="form-check-input">').attr('id', boxId).val(val))
		.append($('<label class="form-check-label">').attr('for', boxId).text(label));
}

// FIELDS: [이름, 라벨, 칸 너비, 종류, 라벨 숨김]. 종류: 'textarea', 'date', { code: 코드 그룹 }, { multi: 코드 그룹 }, { values: {값: 이름} }, 없으면 글자 입력
function hrBuildFields(target, fields) {
	var $t = $(target);
	fields.forEach(function(f) {
		var id = 'f_' + f[0], type = f[3], $input;
		var $label = $('<label>').attr('for', id).toggleClass('sr-only', !!f[4]).text(f[1]);
		if (type && type.multi) {
			$input = $('<div role="group">').attr('aria-label', f[1]).attr('data-multi', f[0]).attr('id', id);
			(HR_CODES[type.multi] || []).forEach(function(c) { $input.append(hrMultiOption(id, c.CD, c.NM)); });
			$label.removeAttr('for');
		} else {
			if (type === 'textarea') {
				$input = $('<textarea rows="4" class="form-control form-control-sm">');
			} else if (type && type.code) {
				$input = $('<select class="form-control form-control-sm">').append('<option value=""></option>');
				(HR_CODES[type.code] || []).forEach(function(c) { $input.append($('<option>').val(c.CD).text(c.NM)); });
			} else if (type && type.values) {
				$input = $('<select class="form-control form-control-sm">');
				$.each(type.values, function(k, v) { $input.append($('<option>').val(k).text(v)); });
			} else {
				$input = $('<input class="form-control form-control-sm">').attr('type', type || 'text');
			}
			$input.attr({ id: id, name: f[0] });
		}
		$('<div class="mb-2">').addClass('col-md-' + f[2]).append($label).append($input).appendTo($t);
	});
}

function hrFillForm(form, fields, row) {
	$(form)[0].reset();
	// 지난번에 덧붙인 임시 선택지를 지운다
	$(form).find('.hr-extra').remove();
	fields.forEach(function(f) {
		var val = row[f[0]];
		if (f[3] === 'date') $(form).find('[name=' + f[0] + ']').attr('type', hrInputType('date', val));
		if (val === undefined || val === null) return;
		var $multi = $(form).find('[data-multi=' + f[0] + ']');
		if ($multi.length) {
			String(val).split(',').forEach(function(v) {
				var $box = $multi.find('input').filter(function() { return this.value === v; });
				// 공통코드에서 삭제된 값도 저장 때 지워지지 않게 선택지에 넣는다
				if (!$box.length) { $multi.append(hrMultiOption($multi.attr('id'), v, v, true)); $box = $multi.find('input').last(); }
				$box.prop('checked', true);
			});
			return;
		}
		var $el = $(form).find('[name=' + f[0] + ']');
		// 공통코드에서 삭제된 값도 빈칸으로 보여 저장 때 지워지지 않게 선택지에 넣는다
		if ($el.is('select') && !$el.find('option').filter(function() { return this.value === String(val); }).length) {
			$el.append($('<option class="hr-extra">').val(val).text(val));
		}
		$el.val(val);
	});
}

// 일반 입력값 + 여러 개 고르는 칸(코드를 쉼표로 이어 한 값으로 보낸다)
function hrFormData(form) {
	var data = $(form).serializeArray();
	$(form).find('[data-multi]').each(function() {
		var vals = $(this).find('input:checked').map(function() { return this.value; }).get();
		data.push({ name: $(this).attr('data-multi'), value: vals.join(',') });
	});
	return data;
}
</script>
