<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%-- 면접·교육생 관리 공통 스타일 (캘린더 스타일에 더한다) --%>
<style>
	.hr-row { cursor: pointer; }
	.hr-row:focus { outline: 2px solid #16d5ff; outline-offset: -2px; }
	.hr-memo { font-size: 12px; color: #666; max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.hr-skill { width: 52px; padding: 0 2px; height: 26px; font-size: 12px; }
	#editModal label { font-size: 12px; color: #555; margin-bottom: 2px; }
	.hr-cell { cursor: text; }
	.hr-cell:hover { background: rgba(22,213,255,.1); }
	.hr-cell:focus { outline: 2px solid #16d5ff; outline-offset: -2px; }
	.hr-cell .form-control { height: 26px; padding: 0 4px; font-size: 12px; min-width: 70px; }
	.hr-cell textarea.form-control { height: auto; min-width: 240px; padding: 4px; }
	.hr-new th { padding: 4px; background: #f6fbfd !important; font-weight: normal; }
	.hr-new .form-control { height: 26px; padding: 0 4px; font-size: 11px; min-width: 60px; }
	/* 날짜 입력칸이 좁으면 값이 잘려 비어 보인다 */
	.hr-new input[type=date], .hr-cell input[type=date] { min-width: 125px; }
	.hr-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px; }
	.hr-card-row { display: flex; gap: 6px; align-items: flex-start; margin-top: 2px; }
	.hr-card-label { flex: 0 0 56px; color: #888; font-size: 11px; line-height: 20px; }
	.hr-card-row .hr-cell { flex: 1 1 auto; min-width: 0; min-height: 20px; line-height: 20px; border-radius: 3px; padding: 0 3px; color: #222; }
	.hr-card-row .hr-cell:empty::before { content: '-'; color: #bbb; }
	.hr-card-row .hr-cell .form-control { min-width: 0; width: 100%; }
	.hr-card-row .hr-cell textarea.form-control { min-width: 0; }
	.hr-card-name-row .hr-cell { font-size: 13px; font-weight: 600; color: #111; }
	.hr-card-info { margin-top: 2px; }
	#skillArea { margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(17,17,17,.1); }
	.hr-sort { background: none; border: 0; padding: 0; font-weight: 600; color: inherit; white-space: nowrap; cursor: pointer; }
	.hr-sort-mark { font-size: 9px; color: #16a0c4; }
	.hr-filter th { padding: 4px; background: #fff !important; font-weight: normal; }
	.hr-filter .form-control { height: 26px; padding: 0 4px; font-size: 11px; min-width: 60px; }
	.hr-board { display: flex; gap: 12px; overflow-x: auto; align-items: flex-start; }
	.hr-lane { flex: 1 1 0; min-width: 270px; background: #eef1f4; border-radius: 10px; padding: 10px; }
	.hr-lane.is-over { outline: 2px dashed #16a0c4; outline-offset: -2px; background: #e3f6fb; }
	.hr-lane-head { display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 700; margin-bottom: 8px; }
	.hr-lane-body { display: flex; flex-direction: column; gap: 8px; min-height: 80px; max-height: 70vh; overflow-y: auto; }
	.hr-card { background: #fff; border-radius: 8px; padding: 9px 10px; box-shadow: 0 1px 2px rgba(0,0,0,.1); cursor: grab; font-size: 12px; color: #555; }
	.hr-card:focus { outline: 2px solid #16d5ff; }
	.hr-card.is-dragging { opacity: .45; }
	.hr-card-name { font-size: 13px; font-weight: 600; color: #111; }
	.hr-section { font-size: 13px; font-weight: 700; color: #111; margin: 14px 0 8px; padding-top: 12px; border-top: 1px solid rgba(17,17,17,.1); }
	.hr-section:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
	.hr-dash-head { width: 100%; background: none; border-width: 0 0 1px; text-align: left; color: inherit; }
	.hr-dash-head.collapsed .fa-chevron-up { transform: rotate(180deg); }
	.hr-dash-title { font-size: 13px; font-weight: 600; color: #111; }
	.hr-dash-cond { font-size: 11px; color: #555; }
	.hr-dash { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
	.hr-dash-item { flex: 1 1 110px; background: #f6fbfd; border-radius: 8px; padding: 8px 12px; }
	.hr-dash-label { font-size: 12px; color: #555; }
	.hr-dash-num { font-size: 20px; font-weight: 700; line-height: 1.3; color: #111; }
	.hr-dash-sub { font-size: 11px; color: #555; min-height: 16px; }
	td[data-tone=good] { background: #e6f6ea; color: #17692f; }
	td[data-tone=bad] { background: #fdeaea; color: #a32020; }
	td[data-tone=warn] { background: #fff5dc; color: #7a5600; }
	td[data-tone=info] { background: #e5f1fb; color: #165a8f; }
	td[data-tone=mute] { background: #f0f1f3; color: #5c6168; }
	/* 목록 메모 (hrMemoBtn·hrMemoFeed) */
	.hr-memo-btn { border: 1px solid #b9dbe6; background: #f3fbfd; color: #0b6e8a; border-radius: 10px; padding: 0 7px; font-size: 11.5px; font-weight: 700; }
	.hr-memo-btn.zero { opacity: .55; font-weight: 400; }
	.hr-memo-feed { max-height: 50vh; overflow-y: auto; }
	.hr-memo-feed .it { border: 1px solid rgba(17,17,17,.1); border-radius: 8px; padding: 8px 10px; margin-bottom: 8px; white-space: pre-wrap; }
	.hr-memo-feed .who { font-size: 11.5px; color: #5f6b75; display: flex; gap: 8px; align-items: center; white-space: normal; }
</style>
