<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%-- <script> 안에서 include. 화면용 공통코드(HR_·EQP_·LAB_·BONUS_·MEM_) [{GRP, CD, NM}] --%>
var HR_ALL_CODES = <%= new com.fasterxml.jackson.databind.ObjectMapper().writeValueAsString(org.springframework.web.context.support.WebApplicationContextUtils.getRequiredWebApplicationContext(application).getBean(com.eep.mapper.BoHrMapper.class).selectHrCodeList()).replace("</", "<\\/") %>;
function hrAllCodes(grp) { return HR_ALL_CODES.filter(function(c) { return c.GRP === grp; }); }
// 코드 그룹을 { 코드: 이름 } 으로
function hrCodeMap(grp) { var m = {}; hrAllCodes(grp).forEach(function(c) { m[c.CD] = c.NM; }); return m; }
