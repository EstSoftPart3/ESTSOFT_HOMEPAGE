<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%-- 투입현황·급여관리·매출/매입처 공통 스타일과 금액 카드 --%>
<style>
	.dp-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin-bottom: 12px; }
	.dp-kpi { background: #fff; border: 1px solid rgba(17,17,17,.08); border-radius: 10px; padding: 9px 12px; text-align: left; color: #111; }
	button.dp-kpi:hover, button.dp-kpi.active { border-color: #16a0c4; box-shadow: 0 0 0 2px rgba(22,213,255,.25); }
	.dp-kpi span { display: block; color: #5f6b75; font-size: 12px; }
	.dp-kpi b { font-size: 19px; font-variant-numeric: tabular-nums; }
	.dp-kpi.bad b { color: #a32020; } .dp-kpi.warn b { color: #7a5600; }
	.dp-pill { display: inline-block; padding: 0 8px; border-radius: 10px; font-size: 11px; font-weight: 700; white-space: nowrap; background: #eef1f4; color: #444; margin: 1px 3px 1px 0; }
	.dp-pill.rent { background: #dff3f9; color: #0b6e8a; } .dp-pill.bad { background: #fdeaea; color: #a32020; } .dp-pill.warn { background: #fff5dc; color: #7a5600; } .dp-pill.ok { background: #e6f6ea; color: #17692f; }
	.dp-num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
	.dp-name { background: none; border: 0; padding: 0; color: #0b6e8a; font-weight: 600; text-decoration: underline; cursor: pointer; }
	.dp-mute { color: #8a949c; }
	.dp-bar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 8px 14px; }
	.dp-bar .ml-auto { display: flex; gap: 6px; align-items: center; }
	#dpCard { position: fixed; z-index: 2000; pointer-events: none; display: none; }
	.dp-card { width: 430px; background: #fff; border: 1px solid #dfe5ea; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,.22); overflow: hidden; font-size: 12.5px; color: #15191d; }
	.dp-card-top { padding: 9px 12px; font-weight: 700; display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px solid #dfe5ea; }
	.dp-card-top span { color: #5f6b75; font-weight: 400; }
	.dp-sec { padding: 6px 0; border-bottom: 1px solid #dfe5ea; }
	.dp-sec div { display: flex; justify-content: space-between; gap: 8px; padding: 1px 12px; font-variant-numeric: tabular-nums; }
	.dp-sec .s { color: #5f6b75; font-size: 11px; }
	.dp-sec .big { font-weight: 700; }
	.dp-two { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid #dfe5ea; }
	.dp-two .dp-sec { border-bottom: 0; } .dp-two .dp-sec + .dp-sec { border-left: 1px solid #dfe5ea; }
	.dp-net { display: flex; justify-content: space-between; align-items: baseline; padding: 9px 12px; background: #e6f6ea; color: #17692f; font-weight: 700; }
	.dp-net b { font-size: 17px; font-variant-numeric: tabular-nums; }
	.dp-net.minus { background: #fdeaea; color: #a32020; }
	.dp-card.sm { width: 340px; }
	/* 정보 팝업(#dpInfo, 1065) 안에서 띄운 확인 창이 뒤에 가리지 않게 */
	.bootbox.modal { z-index: 1075 !important; }
	/* 시크릿: 시크릿 계정에게만 보이는 행과 칩 */
	tr.dp-secret > td { background-color: #f4effc; }
	.dp-secret-chip { display: inline-flex; gap: 6px; align-items: center; padding: 4px 10px; border-radius: 999px; border: 1px solid #6b3fa0; background: #f4effc; color: #6b3fa0; font-weight: 700; font-size: 12.5px; cursor: pointer; margin: 0; }
	.dp-pill[tabindex] { cursor: help; }
	.dp-info { border: 0; background: none; color: #0b6e8a; font-size: 13px; line-height: 1; padding: 0 3px; cursor: pointer; vertical-align: middle; }
	.dp-info:hover, .dp-info:focus { color: #06222b; outline: 2px solid #16d5ff; border-radius: 3px; }
</style>
<div id="dpCard" aria-hidden="true"></div>
<div class="modal fade" id="dpInfo" tabindex="-1" role="dialog" aria-labelledby="dpInfoTitle" aria-hidden="true" style="z-index:1065">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
			<div class="modal-header"><h5 class="modal-title" id="dpInfoTitle"></h5><button type="button" class="close" data-dismiss="modal" aria-label="닫기"><span aria-hidden="true">&times;</span></button></div>
			<div class="modal-body" id="dpInfoBody"></div>
		</div>
	</div>
</div>
<script>
var DP_PAY = [['BASE_AMT', '기본'], ['MEAL_AMT', '식대'], ['RESEARCH_AMT', '연구비'], ['DRIVE_AMT', '운전보조금'], ['CHILD_AMT', '자녀보육'], ['BONUS_AMT', '상여'], ['FUEL_AMT', '유류비']];
var DP_DED = [['NP_AMT', '국민연금'], ['HI_AMT', '건강보험'], ['LTC_AMT', '장기요양'], ['EI_AMT', '고용보험'], ['ACC_AMT', '산재보험'], ['IT_AMT', '소득세'], ['LIT_AMT', '지방소득세'],
	['NP_SETTLE', '국민연금 정산'], ['HI_SETTLE', '건강보험 정산'], ['EI_SETTLE', '고용보험 정산'], ['LTC_SETTLE', '장기요양 정산'], ['IT_SETTLE', '소득세 정산'], ['LIT_SETTLE', '지방소득세 정산'], ['MUTUAL_AMT', '상조회비'], ['ETC_DED', '기타공제']];

// 상여 조건 글자. STEPS = "개월:조건:금액,..."
// 상여 기준일·조건 이름은 공통코드 BONUS_BASE·BONUS_COND (hr_script 의 hrCodeMap)
function dpSteps(s) { return String(s || '').split(',').filter(Boolean).map(function(x) { var p = x.split(':'); return { m: +p[0], c: p[1], a: +p[2] }; }); }
function dpStepText(st) { return (st.m ? st.m + '개월' + (st.c !== 'NONE' ? ' ' + (hrCodeMap('BONUS_COND')[st.c] || st.c) : '') : '계약 시') + ' → ' + dpWon(st.a); }
function dpBaseText(b) { return (b.TARGET_CD === 'REFERRER' ? '추천한 인재의 ' : '') + (hrCodeMap('BONUS_BASE')[b.BASE_CD] || b.BASE_CD); }
function dpWon(v) { return v === null || v === undefined || v === '' ? '—' : Number(v).toLocaleString('ko-KR'); }
function dpEsc(s) { return $('<div>').text(s === null || s === undefined ? '' : String(s)).html(); }
function dpLine(k, v, cls) { return '<div class="' + (cls || '') + '"><span>' + dpEsc(k) + '</span><span>' + dpEsc(v) + '</span></div>'; }
// 수습은 수습해제일까지 남은 날을 붙인다: 수습(D-57)
function dpProbLeft(type, end) { var d = type === 'PROBATION' && end ? moment(end).diff(moment().startOf('day'), 'days') : -1; return d >= 0 ? '(D-' + d + ')' : ''; }
// 수습→정규 전환은 한 계약이다. 같은 달 수습·정규 건이 함께 있으면 둘을 한 건으로 센다
function dpProbReg(types) { return types.indexOf('PROBATION') >= 0 && types.indexOf('REGULAR') >= 0; }
function dpYmLabel(ym) { return ym ? ym.substring(0, 4) + '년 ' + Number(ym.substring(5)) + '월' : ''; }
// 확인 사항 키워드 칩. 마우스를 올리거나 Tab 으로 고르면 계산·근거가 뜬다. flag: { K, D }
function dpFlag(flag) {
	var $p = $('<span class="dp-pill" tabindex="0">').addClass(/공제없음|대장차/.test(flag.K) ? 'bad' : 'warn').text(flag.K).attr('aria-label', flag.K + ': ' + flag.D);
	dpHover($p, $p, function() {
		return '<div class="dp-card sm"><div class="dp-card-top">' + dpEsc(flag.K) + '</div><div class="dp-sec">'
			+ String(flag.D).split('\n').map(function(l) { return '<div><span>' + dpEsc(l) + '</span></div>'; }).join('') + '</div></div>';
	});
	return $p;
}
// 작은 ⓘ 버튼. 누르면 open() 이 dpInfo 로 팝업을 띄운다
function dpInfoBtn(label, open) {
	return $('<button type="button" class="dp-info">').attr({ 'aria-label': label, title: label }).text('ⓘ').on('click', function(e) { e.stopPropagation(); open(); });
}
// rows: [[이름, 값]] 또는 jQuery 내용
function dpInfo(title, body) {
	$('#dpInfoTitle').text(title);
	var $b = $('#dpInfoBody').empty();
	if (body instanceof $) $b.append(body);
	else $b.append($('<table class="table table-sm mb-0">').append(body.map(function(r) { return $('<tr>').append($('<th class="text-muted font-weight-normal" style="width:140px">').text(r[0])).append($('<td>').text(r[1] || '—')); })));
	$('#dpInfo').modal('show');
}
// 이 파일은 jQuery(include_bottom)보다 먼저 읽히므로 문서가 다 읽힌 뒤에 붙인다
document.addEventListener('DOMContentLoaded', function() {
	$(document).on('shown.bs.modal', '#dpInfo', function() { $('.modal-backdrop').last().css('z-index', 1062); })
		.on('hidden.bs.modal', '#dpInfo', function() { if ($('.modal.show').length) $('body').addClass('modal-open'); });
});
function dpPlace(x, y) {
	var $c = $('#dpCard'), w = $c.outerWidth(), h = $c.outerHeight();
	$c.css({ left: Math.max(8, Math.min(x + 16, window.innerWidth - w - 8)), top: Math.max(8, Math.min(y + 12, window.innerHeight - h - 8)) });
}
function dpShow(html, x, y) { $('#dpCard').html(html).show(); dpPlace(x, y); }
function dpHide() { $('#dpCard').hide(); }
// html(): 카드 HTML 또는 Promise. 마우스와 키보드 초점 모두 연다
function dpHover($row, $focus, html) {
	var token = 0;
	function open(x, y) {
		var my = ++token, h = html();
		if (!h) return;
		if (typeof h === 'string') { dpShow(h, x, y); return; }
		h.then(function(v) { if (my === token && v) dpShow(v, x, y); });
	}
	$row.on('mouseenter', function(e) { open(e.clientX, e.clientY); }).on('mousemove', function(e) { if ($('#dpCard').is(':visible')) dpPlace(e.clientX, e.clientY); })
		.on('mouseleave', function() { token++; dpHide(); });
	$focus.on('focus', function() { var r = this.getBoundingClientRect(); open(r.left, r.bottom); }).on('blur', function() { token++; dpHide(); });
}
</script>
