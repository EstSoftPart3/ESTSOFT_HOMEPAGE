<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>


  <!-- Navbar -->
  <nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <!-- Left navbar links -->
    <ul class="navbar-nav">
      <li class="nav-item">
        <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
      </li>
      <li class="nav-item d-none d-sm-inline-block">      		
        <a href="#" class="nav-link">Home</a>
      </li>
    </ul>

    <form class="form-inline ml-3">
      <div class="input-group input-group-sm">
        <input class="form-control form-control-navbar" type="search" placeholder="Search" aria-label="Search">
        <div class="input-group-append">
          <button class="btn btn-navbar" type="submit">
            <i class="fas fa-search"></i>
          </button>
        </div>
      </div>
    </form>
	
    <!-- Right navbar links -->
    <%-- 관리자 계정용 홈페이지/관리자 화면 전환 토글 (FO navbar.jspf 와 같은 모양). 이 include 엔 JSTL 이 보장되지 않아 EL 로만 숨긴다 --%>
    <div class="mode-switch ml-auto" role="group" aria-label="화면 전환" ${sessionScope.emplyAuthCheck == '2' ? '' : 'hidden'}>
      <a href="/eep/mainPage.do" class="mode-switch-item"><i class="fas fa-home"></i> 홈페이지</a>
      <a href="/admin/home.do" class="mode-switch-item active" aria-current="page"><i class="fas fa-cog"></i> 관리자</a>
    </div>
    <style>
    .mode-switch { display: inline-flex; align-self: center; padding: 3px; gap: 2px; border-radius: 999px; background: #F2F8FE; border: 1px solid rgba(17,17,17,.08); white-space: nowrap; }
    .mode-switch[hidden] { display: none; }
    .mode-switch-item { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; font-size: 13px; font-weight: 600; line-height: 1; color: #555; text-decoration: none; transition: background-color .15s, color .15s; }
    .mode-switch-item:hover { color: #111; background: rgba(22,213,255,.18); text-decoration: none; }
    .mode-switch-item.active { color: #fff; background: #111; box-shadow: 0 1px 3px rgba(0,0,0,.2); pointer-events: none; }
    .mode-switch-item:focus-visible { outline: 2px solid #16D5FF; outline-offset: 2px; }
    </style>

  </nav>
  <!-- /.navbar -->

  <!-- Main Sidebar Container -->
  <aside class="main-sidebar sidebar-dark-primary elevation-4">
    <!-- Brand Logo -->
    <a href="#" class="brand-link">
      <img src="/resources/img/logo.png"
           alt="AdminLTE Logo"
           class="brand-image elevation-12">
      <span class="brand-text font-weight-light" style="font-size: 16px;">주식회사 이에스티소프트</span><br>
      <span class="brand-text font-weight-light" style="font-size: 12px;">&nbsp;&nbsp;&nbsp;&nbsp;
      	${loginInfo.loginInfo[0].emplyNm}(${loginInfo.loginInfo[0].emplyId})님 접속
      	&nbsp;&nbsp;<button type="button" class="btn-sm-sm btn-danger" onclick="logout();">logout</button>
      	<button type="button" class="btn-sm-sm btn-secondary" title="비밀번호 변경" aria-label="비밀번호 변경" onclick="location.href='/eep/account/changePassword.do'; return false;"><i class="fas fa-key"></i></button>
      </span>
    </a>
    
	
    <!-- Sidebar -->
    <div class="sidebar">
      <!-- Sidebar user (optional) -->
     <!--  <div class="user-panel mt-3 pb-3 mb-3 d-flex" style="display:none">
        <div class="image">
          <img src="/resources/dist/img/user2-160x160.jpg" class="img-circle elevation-2" alt="User Image">
        </div>
        <div class="info">
          <a href="#" class="d-block">SWORDBASS</a>
        </div>
      </div> -->

      <!-- Sidebar Menu -->
      <nav class="mt-2">
        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
         
          <li class="nav-header"></li>
          	<%-- 硫붾돱? 沅뚰븳? boLoggerInterceptor 媛 ?ｋ뒗 boMenus 濡?洹몃┛?? 愿由??붾㈃: 怨꾩젙 諛?沅뚰븳 > 硫붾돱 愿由?--%>
          	<c:forEach var="group" items="${boMenus}">
          	<li class="nav-item has-treeview menu-open">
	            <a href="#" class="nav-link">
	              <i class="nav-icon fas <c:out value="${group.ICON_NM}"/>"></i>
	              <p class="sTitle"><c:out value="${group.MENU_NM}"/><i class="right fas fa-angle-left"></i></p>
	            </a>
	            <ul class="nav nav-treeview">
	              <c:forEach var="item" items="${group.children}">
	              <li class="nav-item">
	                <a href="<c:out value="${item.MENU_URL}"/>" class="nav-link"<c:if test="${item.NEW_WIN_YN == 'Y'}"> target="_blank" rel="noopener"</c:if>>
	                  <i class="far fa-circle nav-icon sTitle"></i>
	                  <p class="sTitle"><c:out value="${item.MENU_NM}"/><c:if test="${item.NEW_WIN_YN == 'Y'}"> <i class="fas fa-external-link-alt" style="font-size:10px;"></i></c:if></p>
	                </a>
	              </li>
	              </c:forEach>
	            </ul>
          	</li>
          	</c:forEach>

			</ul>
		</nav>
		<!-- /.sidebar-menu -->
	</div>
	<!-- /.sidebar -->
</aside>

<%-- 현재 화면의 메뉴 동그라미를 채우고 그 그룹만 펼친다. 게시글 상세처럼 메뉴에 없는 화면은 같은 폴더의 메뉴를 쓴다 --%>
<script>
(function() {
	// 스크롤해도 상단·왼쪽 메뉴를 고정한다. 모든 BO 화면이 이 파일을 쓰므로 body 클래스를 여기서 붙인다. 로고 영역이 두 줄이라 메뉴 시작 위치를 실제 높이로 맞춘다
	document.body.classList.add('layout-fixed', 'layout-navbar-fixed');
	var brandHeight = document.querySelector('aside .brand-link').offsetHeight, menu = document.querySelector('aside .sidebar');
	menu.style.marginTop = brandHeight + 'px';
	menu.style.height = 'calc(100vh - ' + brandHeight + 'px)';
	menu.style.overflowY = 'auto';
	[].forEach.call(document.querySelectorAll('aside .has-treeview.menu-open'), function(li) { li.classList.remove('menu-open'); });
	var links = [].slice.call(document.querySelectorAll('aside .nav-treeview a.nav-link'));
	var path = location.pathname, dir = path.substring(0, path.lastIndexOf('/') + 1);
	var current = links.filter(function(a) { return a.pathname + a.search === path + location.search; })[0]
		|| links.filter(function(a) { return a.pathname === path; })[0]
		|| links.filter(function(a) { return a.pathname.indexOf(dir) === 0; })[0];
	if (current) {
		var icon = current.querySelector('.nav-icon');
		icon.classList.remove('far');
		icon.classList.add('fas');
		current.setAttribute('aria-current', 'page');
		current.closest('.has-treeview').classList.add('menu-open');
	}
})();
</script>

