<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>


  <!-- Navbar -->
  <nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <!-- Left navbar links -->
    <ul class="navbar-nav">
      <li class="nav-item">
        <%-- 펼침: « 메뉴 접기 / 접힘: 파란 바탕 » 메뉴 펴기. 아이콘은 반 바퀴 돌며 바뀐다 --%>
        <a class="nav-link bo-push" data-widget="pushmenu" data-enable-remember="true" href="#" role="button" title="메뉴 접기/펴기" aria-label="왼쪽 메뉴 접기/펴기"><i class="fas fa-angle-double-left bo-push-ico" aria-hidden="true"></i><span class="bo-push-txt"></span></a>
      </li>
      <li class="nav-item">
        <%-- 뒤로: 탭 안에서 넘어간 화면이 있으면 그 탭 안에서, 없으면 직전에 보던 탭으로(bo-tabs.js) --%>
        <button type="button" id="boBack" class="bo-back" disabled aria-label="뒤로" title="뒤로 갈 화면이 없습니다"><i class="fas fa-arrow-left" aria-hidden="true"></i><span class="bo-back-txt">뒤로</span></button>
      </li>
    </ul>

    <%-- 연 화면 탭(작업표시줄). bo-tabs.js 가 채운다 --%>
    <div id="boTabs" class="bo-tabs" role="tablist" aria-label="열린 화면"></div>

    <!-- Right navbar links -->
    <%-- 관리자 계정용 홈페이지/관리자 화면 전환 토글 (FO navbar.jspf 와 같은 모양). 이 include 엔 JSTL 이 보장되지 않아 EL 로만 숨긴다 --%>
    <div class="mode-switch ml-auto" role="group" aria-label="화면 전환" ${sessionScope.emplyAuthCheck == '2' ? '' : 'hidden'}>
      <a href="/eep/mainPage.do" class="mode-switch-item"><i class="fas fa-home"></i> 홈페이지</a>
      <a href="/admin/home.do" class="mode-switch-item active" aria-current="page"><i class="fas fa-cog"></i> 관리자</a>
    </div>
    <style>
    .mode-switch { display: inline-flex; align-self: center; padding: 3px; gap: 2px; border-radius: 999px; background: #F2F8FE; border: 1px solid rgba(17,17,17,.08); white-space: nowrap; }
    .mode-switch[hidden] { display: none; }
    .sidebar-collapse .main-sidebar:not(:hover) .nav-treeview { display: none !important; }
    /* 상단: 로고 한 줄 고정 높이, 접속자는 메뉴 위 별도 칸 */
    .main-sidebar .brand-link { height: calc(3.5rem + 1px); white-space: nowrap; overflow: hidden; }
    .main-sidebar .brand-link .brand-text { font-size: 15px; font-weight: 600; color: #fff; }
    .layout-fixed .main-sidebar .sidebar { margin-top: calc(3.5rem + 1px); height: calc(100vh - 3.5rem - 1px); overflow-y: auto; overflow-x: hidden; }
    .bo-user { display: flex; align-items: center; gap: 8px; margin: 10px 4px 6px; padding: 8px 8px; border-radius: 8px; background: rgba(255,255,255,.06); white-space: nowrap; }
    .bo-user-icon { font-size: 26px; color: #9aa4ad; flex: 0 0 auto; width: 2.1rem; text-align: center; }
    .bo-user-info { flex: 1 1 auto; min-width: 0; display: grid; line-height: 1.25; }
    .bo-user-info b { color: #fff; font-size: 13px; overflow: hidden; text-overflow: ellipsis; }
    .bo-user-info small { color: #9aa4ad; font-size: 11px; overflow: hidden; text-overflow: ellipsis; }
    .bo-user-btn { flex: 0 0 auto; width: 28px; height: 28px; border: 0; border-radius: 6px; background: rgba(255,255,255,.08); color: #c2c7d0; font-size: 12px; }
    .bo-user-btn:hover { background: rgba(255,255,255,.18); color: #fff; }
    .bo-user-btn.bo-logout:hover { background: #dc3545; }
    .bo-user-btn:focus-visible { outline: 2px solid #16D5FF; outline-offset: 1px; }
    .sidebar-collapse .main-sidebar:not(:hover) .bo-user { justify-content: center; background: none; padding-inline: 0; }
    .sidebar-collapse .main-sidebar:not(:hover) .bo-user > :not(.bo-user-icon) { display: none; }
    /* 단계 구분: 1단계 굵은 흰 글씨, 2단계 실선 안내선 아래 작은 아이콘, 3단계 점선 안내선 아래 점 */
    .nav-sidebar .sTitle { height: auto; }
    .nav-sidebar > .nav-item > .nav-link p.sTitle { font-size: 13.5px; font-weight: 600; color: #f1f3f5; }
    .nav-sidebar > .nav-item > .nav-treeview { margin: 2px 0 8px 1.55rem; border-left: 1px solid rgba(255,255,255,.14); }
    .nav-sidebar .nav-treeview > .nav-item > .nav-link { padding: .4rem .6rem; margin-left: 4px; width: calc(100% - 8px); }
    .nav-sidebar .nav-treeview > .nav-item > .nav-link p.sTitle { font-size: 13px; font-weight: 400; color: #c9d0d6; }
    .nav-sidebar .nav-treeview > .nav-item > .nav-link > .nav-icon { font-size: 12px; width: 1.2rem; margin-right: .35rem; }
    .nav-sidebar .nav-treeview .nav-treeview { margin: 0 0 4px 1.3rem; border-left: 1px dashed rgba(255,255,255,.2); }
    .nav-sidebar .nav-treeview .nav-treeview > .nav-item > .nav-link p.sTitle { font-size: 12.5px; color: #a9b3bc; }
    .nav-sidebar .nav-treeview .nav-treeview > .nav-item > .nav-link > .nav-icon { font-size: 6px; width: .9rem; }
    .nav-sidebar .nav-sidebar .has-treeview.menu-open > .nav-link p.sTitle, .nav-sidebar .nav-treeview .menu-open > .nav-link p.sTitle { color: #fff; font-weight: 600; }
    .sidebar-collapse .main-sidebar:not(:hover) .nav-sidebar > .nav-item > .nav-treeview { margin: 0; border: 0; }
    .nav-sidebar a.nav-link.bo-current, .nav-sidebar a.nav-link.bo-current:hover { background: #fff !important; color: #111 !important; box-shadow: 0 1px 3px rgba(0,0,0,.3); }
    /* 단계별 글자색 규칙이 글자에 직접 걸려 있어 글자와 아이콘에도 직접 지정한다 */
    .nav-sidebar a.nav-link.bo-current p.sTitle, .nav-sidebar a.nav-link.bo-current .nav-icon { color: #111 !important; font-weight: 700 !important; }
    .nav-sidebar a.nav-link.bo-parent { color: #fff !important; font-weight: 600; }
    .sidebar-collapse .main-sidebar:not(:hover) .nav-sidebar > .nav-item > a.bo-parent { box-shadow: inset 4px 0 0 #fff; }
    .sidebar-collapse .main-sidebar:not(:hover) .nav-sidebar > .nav-item > a.bo-parent .nav-icon { color: #fff !important; }
    .mode-switch-item { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; font-size: 13px; font-weight: 600; line-height: 1; color: #555; text-decoration: none; transition: background-color .15s, color .15s; }
    .mode-switch-item:hover { color: #111; background: rgba(22,213,255,.18); text-decoration: none; }
    .mode-switch-item.active { color: #fff; background: #111; box-shadow: 0 1px 3px rgba(0,0,0,.2); pointer-events: none; }
    .mode-switch-item:focus-visible { outline: 2px solid #16D5FF; outline-offset: 2px; }
    /* 메뉴 접기/펴기 버튼 */
    .main-header .bo-push { display: inline-flex; align-items: center; gap: 6px; margin: 0 4px; padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(17,17,17,.12); color: #444 !important; font-size: 12.5px; font-weight: 600; white-space: nowrap; transition: background-color .25s, color .25s, border-color .25s; }
    .main-header .bo-push:hover { background: #eef9fc; border-color: #0b6e8a; color: #0b6e8a !important; }
    .bo-push-ico { transition: transform .35s cubic-bezier(.65, 0, .35, 1); }
    .bo-push-txt::after { content: '메뉴 접기'; }
    .sidebar-collapse .main-header .bo-push { background: #0b6e8a; border-color: #0b6e8a; color: #fff !important; box-shadow: 0 2px 6px rgba(11,110,138,.35); }
    .sidebar-collapse .bo-push-ico { transform: rotate(180deg); }
    .sidebar-collapse .bo-push-txt::after { content: '메뉴 펴기'; }
    @media (max-width: 575px) { .bo-push-txt { display: none; } }
    .bo-back { display: inline-flex; align-items: center; gap: 6px; margin: 8px 2px 0; padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(17,17,17,.12); background: #fff; color: #444; font-size: 12.5px; font-weight: 600; white-space: nowrap; transition: background-color .2s, color .2s, border-color .2s; }
    .bo-back:hover:not(:disabled), .bo-back:focus-visible { background: #eef9fc; border-color: #0b6e8a; color: #0b6e8a; outline: none; }
    .bo-back:hover:not(:disabled) .fa-arrow-left { transform: translateX(-2px); }
    .bo-back .fa-arrow-left { transition: transform .2s; }
    .bo-back:disabled { opacity: .4; cursor: default; }
    @media (max-width: 575px) { .bo-back-txt { display: none; } }
    /* 연 화면 탭(bo-tabs.js) */
    .bo-tabs { flex: 1 1 auto; min-width: 0; align-self: stretch; display: flex; align-items: flex-end; gap: 3px; padding: 7px 8px 0; margin-right: 8px; overflow-x: auto; overflow-y: hidden; scrollbar-width: thin; }
    .bo-tab { flex: 0 0 auto; display: inline-flex; align-items: center; max-width: 190px; height: 36px; padding: 0 4px 0 2px; border: 1px solid rgba(17,17,17,.12); border-bottom: 0; border-radius: 8px 8px 0 0; background: #f2f4f6; }
    .bo-tab .t { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border: 0; background: none; padding: 0 6px 0 10px; height: 100%; font-size: 12.5px; color: #444; }
    .bo-tab .x { flex: 0 0 auto; border: 0; background: none; color: #9aa4ac; font-size: 11px; width: 22px; height: 22px; border-radius: 5px; padding: 0; }
    .bo-tab .x:hover, .bo-tab .x:focus-visible { background: #e2e6ea; color: #111; }
    .bo-tab:hover { background: #e9edf0; }
    .bo-tab.on { background: #fff; box-shadow: inset 0 3px 0 #0b6e8a; position: relative; top: 1px; }
    .bo-tab.on .t { color: #0b6e8a; font-weight: 700; }
    .bo-tab.dot .t::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #e0a800; margin-right: 6px; vertical-align: middle; }
    .bo-tab .t:focus-visible { outline: 2px solid #16D5FF; outline-offset: -2px; }
    .bo-tab-select { display: none; }
    @media (max-width: 767px) { .bo-tab { display: none; } .bo-tab-select { display: block; max-width: 55vw; } .bo-tabs { align-items: center; padding: 0 6px; } }
    .bo-frames { display: none; position: fixed; top: calc(3.5rem + 1px); right: 0; bottom: 0; left: 250px; z-index: 1030; background: #f4f6f9; transition: left .3s ease-in-out; }
    .sidebar-collapse .bo-frames { left: 4.6rem; }
    @media (max-width: 991.98px) { .bo-frames { left: 0 !important; } }
    body.bo-in-frame { overflow: hidden; }
    body.bo-in-frame .bo-frames { display: block; }
    body.bo-in-frame #egOpen { display: none; }
    .bo-frame { display: none; width: 100%; height: 100%; border: 0; }
    .bo-frame.on { display: block; }
    .bo-tab-menu { position: fixed; z-index: 1100; min-width: 180px; padding: 4px 0; background: #fff; border: 1px solid rgba(17,17,17,.12); border-radius: 8px; box-shadow: 0 6px 18px rgba(0,0,0,.14); font-size: 13px; }
    .bo-tab-menu button { display: block; width: 100%; text-align: left; border: 0; background: none; padding: 6px 14px; color: #222; }
    .bo-tab-menu button:hover:not([disabled]), .bo-tab-menu button:focus-visible { background: #eef9fc; outline: none; }
    .bo-tab-menu button[disabled] { color: #aab2b9; }
    .bo-tab-menu hr { margin: 4px 0; }
    .bo-tab-toast { position: fixed; top: 64px; right: 16px; z-index: 1100; max-width: 360px; padding: 8px 12px; border-radius: 8px; background: #111; color: #fff; font-size: 12.5px; box-shadow: 0 4px 12px rgba(0,0,0,.2); }
    </style>

  </nav>
  <!-- /.navbar -->

  <!-- Main Sidebar Container -->
  <aside class="main-sidebar sidebar-dark-primary elevation-4">
    <!-- Brand Logo -->
    <a href="/admin/home.do" class="brand-link">
      <img src="/resources/img/logo.png" alt="" class="brand-image">
      <span class="brand-text">주식회사 이에스티소프트</span>
    </a>

    <!-- Sidebar -->
    <div class="sidebar">
      <div class="bo-user">
        <i class="fas fa-user-circle bo-user-icon" aria-hidden="true"></i>
        <div class="bo-user-info"><b><c:out value="${loginInfo.loginInfo[0].emplyNm}"/></b><small><c:out value="${loginInfo.loginInfo[0].emplyId}"/></small></div>
        <button type="button" class="bo-user-btn" title="비밀번호 변경" aria-label="비밀번호 변경" onclick="location.href='/eep/account/changePassword.do';"><i class="fas fa-key" aria-hidden="true"></i></button>
        <button type="button" class="bo-user-btn bo-logout" title="로그아웃" aria-label="로그아웃" onclick="logout();"><i class="fas fa-sign-out-alt" aria-hidden="true"></i></button>
      </div>

      <!-- Sidebar Menu -->
      <nav class="mt-2">
        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
         
          <li class="nav-header"></li>
          	<%-- 硫붾돱? 沅뚰븳? boLoggerInterceptor 媛 ?ｋ뒗 boMenus 濡?洹몃┛?? 愿由??붾㈃: 怨꾩젙 諛?沅뚰븳 > 硫붾돱 愿由?--%>
          	<c:forEach var="group" items="${boMenus}">
          	<li class="nav-item has-treeview">
	            <a href="#" class="nav-link">
	              <i class="nav-icon fas <c:out value="${group.ICON_NM}"/>"></i>
	              <p class="sTitle"><c:out value="${group.MENU_NM}"/><i class="right fas fa-angle-left"></i></p>
	            </a>
	            <ul class="nav nav-treeview">
	              <c:forEach var="item" items="${group.children}">
	              <c:choose>
	              <c:when test="${not empty item.children}">
	              <li class="nav-item has-treeview">
	                <a href="#" class="nav-link">
	                  <i class="${empty item.ICON_NM ? 'far fa-folder-open' : 'fas'} <c:out value="${item.ICON_NM}"/> nav-icon sTitle"></i>
	                  <p class="sTitle"><c:out value="${item.MENU_NM}"/><i class="right fas fa-angle-left"></i></p>
	                </a>
	                <ul class="nav nav-treeview">
	                  <c:forEach var="leaf" items="${item.children}"><%@ include file="/WEB-INF/jsp/bo/boinclude/include_left_leaf.jspf"%></c:forEach>
	                </ul>
	              </li>
	              </c:when>
	              <c:otherwise><c:set var="leaf" value="${item}"/><%@ include file="/WEB-INF/jsp/bo/boinclude/include_left_leaf.jspf"%></c:otherwise>
	              </c:choose>
	              </c:forEach>
	            </ul>
          	</li>
          	</c:forEach>

			</ul>
		</nav>
		<!-- /.sidebar-menu -->
	</div>
	<!-- /.sidebar -->
</aside>

<%-- 현재 화면이 든 그룹·묶음만 펼치고 나머지는 접은 뒤 현재 화면의 메뉴를 강조한다. 게시글 상세처럼 메뉴에 없는 화면은 같은 폴더의 메뉴를 쓴다 --%>
<script>
(function() {
	// 스크롤해도 상단·왼쪽 메뉴를 고정한다. 모든 BO 화면이 이 파일을 쓰므로 body 클래스를 여기서 붙인다
	document.body.classList.add('layout-fixed', 'layout-navbar-fixed');
	// AdminLTE 는 window load 뒤에 접은 상태를 복원해 화면 전환마다 펼쳐졌다 접히므로 그리기 전에 먼저 적용한다
	if (localStorage.getItem('remember.lte.pushmenu') === 'sidebar-collapse') document.body.classList.add('sidebar-collapse');
	[].forEach.call(document.querySelectorAll('aside .has-treeview'), function(li) { li.classList.remove('menu-open'); });
	var links = [].slice.call(document.querySelectorAll('aside .nav-treeview a.nav-link:not([href="#"])'));
	var path = location.pathname, dir = path.substring(0, path.lastIndexOf('/') + 1);
	// 한 메뉴가 여러 하위 폴더를 묶을 때(게시판 관리 → /admin/board/notice/ 등) 한 단계 위 폴더로도 찾는다. /admin/ 자체는 제외
	var parent = dir.replace(/[^\/]+\/$/, '');
	var current = links.filter(function(a) { return a.pathname + a.search === path + location.search; })[0]
		|| links.filter(function(a) { return a.pathname === path; })[0]
		|| links.filter(function(a) { return a.pathname.indexOf(dir) === 0; })[0]
		|| (parent.split('/').length > 3 ? links.filter(function(a) { return a.pathname.indexOf(parent) === 0 && a.pathname.lastIndexOf('/') === parent.length - 1; })[0] : null);
	if (current) {
		var icon = current.querySelector('.nav-icon');
		icon.classList.remove('far');
		icon.classList.add('fas');
		current.setAttribute('aria-current', 'page');
		current.classList.add('bo-current');
		for (var li = current.closest('.has-treeview'); li; li = li.parentElement.closest('.has-treeview')) {
			li.classList.add('menu-open');
			li.children[0].classList.add('bo-parent');
		}
	}
})();
</script>

