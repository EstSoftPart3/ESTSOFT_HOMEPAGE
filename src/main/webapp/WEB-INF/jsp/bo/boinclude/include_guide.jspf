	['#btnStep', '단계 추가', '필요한 만큼 더해요'],
	['#bModal .modal-footer .btn-primary', '저장', '다음 급여 계산부터 들어가요']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/partner_list.jsp'}">
