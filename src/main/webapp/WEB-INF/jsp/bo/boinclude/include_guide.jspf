<c:when test="${guidePath eq '/WEB-INF/jsp/bo/hr/interview_list.jsp'}">
EG.page = [
	['#btnDash', '검색 기준 통계', '화면 맨 아래 대시보드 버튼을 누르면 지금 검색 조건에 맞는 면접 인원·참석·합격·입사 수가 팝업으로 떠요.\n보고 내용 복사를 누르면 메신저에 바로 붙여 넣을 수 있는 문장으로 복사돼요.'],
	['#yearSel', '기간 고르기', '연도·월·주차를 고르면 그 기간 면접자만 보여요. 통계도 같이 바뀌어요.'],
	['#keyword', '찾기', '이름·연락처·메모를 모든 연도에서 찾아요.\n필터를 펼치면 경로·참석·통보·입사 여부를 골라 더 좁혀요.'],
	['#tabs', '구분 탭', '진행 상태별로 나눠 봐요. 숫자는 각 상태의 인원이에요.'],
	['#fHire', '신입 · 경력', '구분으로 신입·경력 면접자만 골라 봐요. 위 통계 제목과 보고 복사 제목도 「신입 채용현황」·「경력 채용현황」으로 바뀌어요.\n목록의 구분 칸을 누르면 바로 바꿀 수 있고, 새로 등록하면 신입이 기본이에요.\n신입은 상세 창에서 「교육생으로 등록」, 경력은 「대기자로 등록」을 눌러요. 경력직은 교육생을 거치지 않고 직원관리 대기 탭에 소속 「경력직」으로 들어가요.'],
	['#viewSwitch', '목록 · 캘린더', '표로 볼지 구글 캘린더처럼 주간·월간 달력으로 볼지 골라요. 고른 보기는 다음에 열 때도 그대로예요.\n캘린더에는 검색어·필터·구분 탭이 같이 적용돼요. 위에서 월을 고르면 그 달의 월별 보기로, 주차를 고르면 그 주의 주별 보기로 가고, 달력의 화살표·오늘·주별·월별 버튼으로 넘기면 위의 연도·월·주차와 통계도 같이 바뀌어요.'],
	['#calView', '캘린더로 등록 · 옮기기', '빈 시간을 누르면 그 날짜·시간이 채워진 새 면접자 창이 열려요.\n이력서 PDF를 원하는 시간 칸에 끌어 놓으면 이름·연락처·성별·나이·주소·학력·경력·신입/경력 중 읽을 수 있는 값을 채워(초록 칸) 창을 열어요. 경력 기간이 적힌 이력서는 경력으로 잡히니 저장 전에 확인해요.\n저장을 눌러야 등록되고, 그때 이력서도 구글 드라이브의 면접일자·이름 폴더에 올라가요. 상세 창 오른쪽 위의 「이력서 보기」로 다시 볼 수 있어요. 파일이 없으면 버튼이 「이력서 등록」으로 바뀌고, 눌러서 PDF를 고르면 올라가요. 포트폴리오도 옆의 버튼으로 똑같이 등록하고 봐요. 암호가 걸린 PDF는 암호를 해제한 뒤 다시 놓아요.\n일정 제목은 [구분] 이름 · 참석 · 결과예요. 일정을 끌어 다른 시간에 놓으면 면접일시가 확인 없이 바로 바뀌고, 누르면 상세 창이 열려요.\n면접일이 바뀌면 드라이브의 이력서 이름 폴더도 새 날짜 폴더로 옮겨지고, 면접자를 삭제하면 그 폴더는 드라이브 휴지통으로 가요.'],
	['[onclick="addRow();"]', '면접자 등록', '표에 새 줄을 넣어 면접자를 등록해요.\n캘린더 연동(면접 배치)이 켜져 있으면 신입·경력 면접 일정이 자동으로 들어오기도 해요. 제목에 [경력]이 있으면 구분이 경력으로 들어가요.'],
	['#listBody .hr-memo-btn', '메모', '💬 를 누르면 그 면접자 메모 창이 열려요. 예전 비고 내용도 여기로 옮겨져 있어요.'],
	['#listBody .btn-outline-secondary', '상세', '면접 정보·결과를 자세히 보고 고쳐요. 입사가 정해지면 거기서 교육생으로 넘겨요.']
];
