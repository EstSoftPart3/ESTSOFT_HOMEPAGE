	['#subGridCodeList', '세부 코드', '실제 선택 목록에 나오는 값이에요. 줄을 눌러 이름·순서를 고쳐요.\n쓰고 있는 코드를 바꾸면 그 목록을 쓰는 화면이 같이 바뀌어요.'],
	['#btnAddsubGridCodeList', '세부 코드 추가', '선택 목록에 값을 하나 더 넣어요.']
];
</c:when>
</c:choose>
</script>
