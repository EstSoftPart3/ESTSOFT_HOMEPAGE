<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%-- 관리자 화면 가이드 단계. 화면은 JSP 경로로 고른다. 투어 동작은 include_guide_core.jspf.
     시크릿 단계는 시크릿 계정(secretViewer)에게만, 시크릿 탭(계정 카드·인사카드)은 그 탭이 보이는 슈퍼관리자(superUser)에게도 출력한다.
     화면의 버튼·칸·팝업을 바꾸면 여기 단계도 같이 고친다(대상이 없어진 단계는 조용히 건너뛰어져서 눈에 안 띈다) --%>
<c:set var="guidePath" value="${pageContext.request.servletPath}"/>
<script>
var EG = { page: [], modals: {} };
<c:choose>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/home/home.jsp'}">
EG.page = [
	['aside a.bo-home', '관리자 홈', '로그인하거나 왼쪽 메뉴의 홈을 누르면 이 화면이 열려요.\n내가 권한을 가진 메뉴의 카드만 보이고, 열 때 한 번 불러와요(새로고침으로 다시 불러와요).'],
	['#boLinks', '구글 드라이브·캘린더 연결', '회사 공용 구글 연결 상태예요. 모든 계정이 이 연결 하나를 같이 써요.\n연결·해제는 시스템 관리자만 해요(「연결」→ 회사 계정 고르고 허용). 초록 점과 메일이 보이면 연결된 거예요.'],
	['#hmKpis', '숫자 한눈에 보기', '재직·투입 중·대기·이번 주 면접·교육 진행 인원이에요.\n숫자 칸을 누르면 그 화면이 해당 탭으로 열려요(대기 → 투입현황 대기 현황).'],
	['#hmUpdCard', '최근 업데이트', '최근에 바뀐 기능 5건이에요. 줄을 누르면 바뀐 화면과 수정·테스트·주의할 것이 팝업으로 나와요.\n💬 표시는 피드백으로 반영된 건이고 옆에 요청한 사람이 보여요.'],
	['#hmCalCard .fc-toolbar', '📅 일정 캘린더', '신입·경력 면접, 투입·철수, 교육 시작·인터뷰, 입사·퇴사, 급여 지급일, 모집 인터뷰·마감처럼 우리 시스템에 등록된 날짜 중 내가 볼 수 있는 화면의 것만 한 달력에 모았어요(구글 캘린더 일정은 넣지 않아요).\n오른쪽 월·주·일 버튼으로 보기를 바꾸고, ‹ › 로 앞뒤로 넘겨요. 일정을 누르면 그 업무 화면(인사카드·투입 상세·면접 상세·교육생 상세·모집 상세)과 똑같은 팝업이 홈 위에 떠서 바로 보고 고칠 수 있어요.'],
	['#hmCalendar .fc-day-grid', '날짜 칸', '월 보기는 날짜 칸에 그날 일정이 모두 보여요(더보기 없음).\n주마다 높이는 그 주에서 일정이 가장 많은 날에 맞춰지고, 일정이 없는 주는 날짜만 있는 얇은 줄로 나와요.'],
	['#hmCalChips', '일정 종류 골라 보기', '색깔 칩이 일정 종류예요(내 할 일·신입면접·경력면접·철수·인터뷰 등). 누르면 그 종류가 달력에서 숨겨지고 다시 누르면 나와요.\n보고 싶은 것만 켜 두면 되고, 칩 옆 숫자는 그 종류의 일정 수예요. 고른 상태는 다음에 열 때도 기억해요.'],
	['#hmTaskAdd', '내 할 일', '나만 보는 할 일이에요(흰 바탕 보라 테두리). 「＋ 할 일」을 누르거나 달력 빈 칸을 누르면 등록하고, 여러 날짜(주·일 보기는 시간대)를 끌어 고르면 그 기간으로 등록돼요. 주·일 보기에서는 마우스 옆에 그 자리 시:분이 보여요(30분 단위).\n시간·메모·반복(매일·매주 요일·매월)을 넣을 수 있고, 내 할 일은 끌어서 다른 날로 옮기거나 끝을 끌어 기간을 늘여요. 반복 할 일을 고칠 때는 이 날만·이후 모두·전체 중에서 골라요.'],
	['#hmWeekCard', '이번 주 할 일', '이번 주(일~토) 내 할 일 목록이에요. 체크하면 완료(취소선), 제목을 누르면 수정 창이 열려요.'],
	['#hmWgTab', '⚙ 위젯 배치', '화면 오른쪽 가운데 「⚙ 위젯」을 누르면 위젯 메뉴가 열려요. 스마트폰 홈처럼 홈은 가로 8칸 × 세로 칸이에요.\n체크로 위젯을 보이거나 숨기고, ⠿⠿ 를 끌어(또는 ↑↓ 키) 순서를 바꾸고, 크기 칩(예: 1×5)을 누르면 나오는 칸 격자를 훑어 크기를 골라요. 위젯마다 최소 크기가 있고 내용이 많으면 위젯 안에서 스크롤돼요.\n모두 바로 내 계정에 저장되고, 「↺ 초기화」는 처음 배치로 되돌려요.'],
	['#hmTodoCard', '오늘 확인할 일', '급여 확인 필요, 철수 임박, 수습 해제, 내 결재 차례, 장비·계정 정리할 것을 모아 보여 줘요.\n0건인 항목은 숨겨지고, 줄 끝 › 를 누르면 그 화면의 그 목록으로 가요.'],
	['#hmCards .hm-link', '이름·번호를 누르면 바로가기', '파란 굵은 글씨는 그 사람·장비·면접자 상세로 바로 가요(직원은 인사카드, 면접자는 상세 창).\n바로가기는 위쪽 화면 탭으로 열려서 대시보드는 그대로 남아 있어요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/deploy_list.jsp'}">
EG.page = [
	['#ymBox', '여기서 달을 바꿔요', '◀ ▶ 를 누르거나 달력에서 고르면 그 달에 하루라도 일한 사람만 표에 나와요.\n지난달 투입 내역을 볼 때도 여기서 달만 바꾸면 돼요.'],
	['#btnAdd', '새 투입은 여기!', '누르면 표에 빈 입력 줄이 생겨요. 고객사·프로젝트·기간·단가를 채우고 Enter 를 누르면 저장돼요.\nTab 으로 다음 칸, Esc 로 취소해요.'],
	['#views', '보고 싶은 목록 고르기', '투입 현황: 지금 현장에 나가 있는 사람\n대기 현황: 재직 중인데 투입이 없는 사람(외부업체 제외)\n철수 임박: 이번 달·다음 달에 끝나는 사람\n내근직: 투입 상세 팝업에서 내근직을 켠 사람(다른 목록에서는 빠져요)\n휴직: 투입 상세 팝업에서 휴직 기간을 넣은 사람. 종료일이 지나면 원래 목록으로 돌아가요\n숫자는 각 목록의 인원이에요. 투입 상세 팝업의 철수 처리를 누르면 철수일이 들어가고 대기 현황으로 옮겨져요.'],
	<c:if test="${secretViewer}">['#secretBox', '시크릿 직원', '시크릿 직원은 시크릿 계정에게만 보이고, 다른 관리자 화면·합계·엑셀에서는 아예 빠져요.\n이 칩을 끄면 잠깐 숨길 수 있어요. 화면을 다른 사람과 같이 볼 땐 꺼 두세요.', 1],</c:if>
	['#chks', '눌러서 켜고 끄기', '고용형태 칩을 눌러 켜고 꺼요. 켜 둔 형태만 표에 나와요. 칩 이름과 순서는 공통코드에서 정해요.\n전체 선택/해제 버튼으로 한 번에 바꿀 수 있어요.'],
	['[data-view="timeline"]', '타임라인으로 보기', '표 대신 사람별 투입 기간을 막대 그래프로 보여 줘요.\n누가 언제 끝나고 비는지 한눈에 볼 때 좋아요. 표 버튼을 누르면 돌아와요.'],
	['.dp-bar', '이름으로 찾기', '검색창에 성명·프로젝트·고객사 일부만 쳐도 바로 걸러져요.\n옆 목록으로 고객사·매출처·근무지역·등급을 골라 더 좁힐 수 있어요.'],
	['#dpHead', '머리글로 정렬·순서 바꾸기', '머리글의 ↕ 를 누르면 그 칸 기준으로 정렬돼요.\n머리글을 좌우로 끌면 칸 순서가 바뀌고 내 계정에 저장돼요. 원래대로는 컬럼 순서 초기화.'],
	['#dpHead th[data-c="SALE_PRICE"]', '매출단가 · 계약단가', '연두색이 매출단가(받는 돈), 주황색이 계약단가(주는 돈)예요.\n그 달에 일부만 근무하면 월 금액에 줄이 그어지고 일할 금액이 같이 보여요. 🤝 는 고객사 직접계약이고, 눌러서 넣거나 고쳐요.'],
	['#dpHead .dp-pay-tog', '급여 같이 보기', '표 오른쪽 회색 칸은 기준월 급여예요(급여 권한이 있을 때만). 이 버튼으로 접고 펴요.\n접으면 실지급·영업이익·확인 건수·메모/이력만, 펴면 급여관리와 같은 칸이 나오고 점선 칸은 눌러 바로 고쳐요. 수당·공제·손익 버튼으로 더 펼쳐요.\n💰 를 누르면 새 탭에서 그 사람의 급여 상세가 열려요. 대기·내근직·휴직 목록에도 같이 붙어요.'],
	['#dpBody .pl-dup-arrow', '같은 달 다른 계약', '이름 앞 ▸ 는 같은 달에 계약이 더 있다는 표시예요. 누르면 └ 줄로 펼쳐져요.\n수습과 정규는 한 줄로 합쳐서 정규(수습 D-n)로 보여요.'],
	['#dpBody .dp-name', '이름을 누르면', '그 사람의 투입 상세 팝업이 열려요.\n계약 정보를 고치거나, 지난 프로젝트 이력을 보거나, 철수 후 다음 투입을 등록할 수 있어요.'],
	['#altView a[href*="profileWord"]', '프로필 버전 · 지원 중 모집', '대기 현황의 「프로필 버전」 칩을 누르면 그 버전의 수행이력 워드를 받아요(순정·가필).\n「지원 중 모집」을 누르면 모집 관리에서 그 모집 상세가 열려요. 지원·인터뷰·투입확정은 모집 관리에서 해요.'],
	['#dpBody .pl-btn', '메모 · 수정 이력','표의 칸은 누르면 그 자리에서 바로 고쳐지고, 누가 언제 무엇을 바꿨는지 ✎ 이력에 자동으로 남아요.\n잘못 고쳤으면 이력에서 되돌리기를 누르세요. 💬 는 메모예요.']
];
EG.modals.detailModal = [
	['#detailFields', '계약 정보', '형태·등급·매출처·매입처·기간·단가를 여기서 고쳐요.\n고친 뒤 팝업 오른쪽 위 저장을 눌러야 표에 반영돼요.'],
	['#histBody', '지난 프로젝트', '이 사람이 지금까지 거쳐 온 투입 이력이에요.\n다음 현장을 고를 때 경력 참고용으로 보세요.'],
	['#dExtend', '같은 현장 연장', '계약이 이어지면 눌러서 새 철수일만 넣어요. 같은 투입 건의 철수일이 늘어나요.\n단가가 바뀌면 같이 넣고(급여 권한자만), 비우면 그대로예요. 수정 이력에 연장으로 남아요.'],
	['#detailModal .modal-footer .btn-outline-secondary', '철수하고 다음 현장으로', '지금 투입의 철수일과 다음 투입을 한 번에 등록해요.\n지금 계약 값이 미리 채워져서 바뀐 것만 고치면 돼요.'],
	['#detailModal .modal-footer .btn-primary', '다 고쳤으면 저장', '저장해야 표와 급여 계산에 반영돼요.\n바뀐 내용은 수정 이력에 남아요.'],
	['#detailModal .modal-footer .btn-outline-danger', '잘못 넣은 투입만 삭제', '실수로 넣은 투입 건을 지워요. 지우면 되돌릴 수 없어요.\n끝난 투입은 지우지 말고 철수일만 넣으세요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/recruit/recruit_list.jsp'}">
EG.page = [
	['#addBtn', '+ 모집 등록', '메일·카톡·문서 원문을 그대로 붙여 넣으면 바로 읽어서 고객사·사업명·등급·기간·근무지·기술을 채워요.\n못 읽은 칸은 주황 ? 로 남고 그대로 저장해도 돼요. 등록하면 드라이브에 모집 폴더가 생겨요.'],
	['.hr-drive-gear', '드라이브 설정', '모집 폴더를 만들 최상위 폴더와 폴더·워드 이름 규칙을 정해요(기본: 연도 › 월 › (등록일) 고객사_사업명).'],
	['#stChips', '상태로 거르기', '모집중·지원 진행·충원 완료·마감 칩으로 걸러요. 「⚠ 확인 필요만」을 켜면 못 읽은 칸이 있는 모집만 모아 봐요.'],
	['.rc-views', '보기 5가지', '카드·표·상태 보드(카드를 옆 칸으로 끌면 상태 변경)·달력(등록·마감·인터뷰·투입)·타임라인(투입 기간과 철수 임박 인원)으로 바꿔 봐요.\n고른 보기와 좌우 너비는 「보기 ▾」에 함께 저장돼요.'],
	['#rcSide', '대기자 패널', '투입현황의 대기자예요(대기·투입 예정·철수 임박 칩). 사람을 잡아 왼쪽 모집에 놓으면 지원 창이 떠요.\n🔍 전체 직원에서 찾기로 투입 중인 사람도 찾아 끌어 놓을 수 있어요. 프로필(수행이력 버전)이 없는 사람은 지원할 수 없어요.'],
	['#rcGrip', '너비 조절', '가운데 줄을 끌거나 ← → 키로 모집과 대기자 패널의 너비를 바꿔요.'],
	['#rcMain .rc-step', '진행 단계 바로 바꾸기', '지원자 칩을 누르면 서류검토 → 인터뷰대기 → 인터뷰확정 → 투입대기 → 투입확정, 탈락·취소 중에서 골라요.\n인터뷰확정은 일정 창(본인 회사 메일로 안내), 투입확정은 확인·추가 입력 창을 거쳐 투입현황에 투입 예정으로 등록돼요.'],
	['#rcMain .rc-card', '모집 카드', '누르면 상세가 열려요. 칸을 고치고 저장하거나, 원문에서 글자를 골라 못 읽은 칸을 채우고, 첨부를 올리고, 지원자 단계를 바꿔요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/pay_list.jsp'}">
EG.page = [
	['#ym', '급여 달 고르기', '◀ ▶ 로 급여를 계산할 달을 바꿔요.\n그 달의 투입·단가·상여가 자동으로 계산돼서 표에 나와요.'],
	['#payDt', '지급일 넣기', '이번 달 급여를 실제로 주는 날짜예요. 기본은 다음 달 15일이에요.\n급여명세서와 마감 기록에 같이 남아요.'],
	['#btnImport', '공제는 엑셀로 한 번에', '급여대장·사업소득대장 엑셀(.xls)을 올리면 사번·코드로 직원을 찾아 공제 금액만 채워 줘요.\n지급액은 덮어쓰지 않고 맞는지 대조만 해요.'],
	['#kpis', '이번 달 요약', '인원·지급 합계·손익 같은 숫자를 한눈에 보여 줘요. 다른 계약(매입) 합계는 따로 나와요.\n아래 표에서 켜 둔 구분 기준으로 계산돼요.'],
	['#chks', '눌러서 켜고 끄기', '고용형태 칩을 켜고 꺼서 보고 싶은 사람만 표에 남겨요.\n확인 사항 칩을 켜면 확인이 필요한 사람만 모아 볼 수 있어요.'],
	<c:if test="${secretViewer}">['#chks .pl-chip.secret', '시크릿 직원', '시크릿 직원의 급여는 시크릿 계정에게만 보이고, 다른 관리자에게는 행·합계·엑셀에서 모두 빠져요.\n칩을 끄면 잠깐 숨기고, 위 합계도 그만큼 빠져요.', 1],</c:if>
	['[data-t="show-allow"]', '칸 펼치기', '수당·공제·손익 칸은 평소엔 접혀 있어요. 같은 색 버튼이나 머리글의 색 띠를 누르면 자세한 칸이 펼쳐져요.\n다시 누르면 접혀요.'],
	['#lHead .pl-calc-btn', '🧮 자동 계산 칸', '머리글에 🧮 가 있는 칸은 자동으로 계산돼요. 🧮 에 마우스를 올리면 계산식이 보이고, 누르면 수습급여·식대 같은 계산 기준값을 고칠 수 있어요.\n기준값을 바꾸면 마감 안 된 달만 다시 계산돼요.'],
	['#pickAll', '줄 체크', '체크한 사람의 줄이 파란 테두리로 표시돼요. 여러 명을 눈으로 비교할 때 써요.\n보기용이라 저장되지 않고, 달을 바꾸면 풀려요.'],
	['#lBody .pl-dup-arrow', '같은 달 다른 계약', '이름 앞 ▸ 를 누르면 그 사람의 다른 계약 줄이 펼쳐져요.\n다른 계약(기타·외부)은 매입처에 주는 돈이라 우리 급여와 급여명세서에는 들어가지 않아요.'],
	['#lBody .dp-name', '이름을 누르면', '직원 상세 팝업이 열려서 투입·계약 정보를 같이 볼 수 있어요.\n금액이 왜 이렇게 나왔는지 확인할 때 써요.'],
	['#lBody .pl-btn', '메모 · 수정 이력', '점선 밑줄이 있는 칸은 눌러서 바로 고칠 수 있어요. 형태·고객사·근무기간·매출단가는 투입현황에서 고쳐요.\n누가 언제 바꿨는지 ✎ 이력에 남고, 거기서 되돌릴 수 있어요.'],
	['#btnClose', '다 확인했으면 마감', '마감하면 이 달 금액이 고정돼서 더 이상 바뀌지 않아요. 마감해야 급여명세서를 보낼 수 있어요.\n마감을 풀 때는 사유를 적어야 하고, 이력에 남아요.']
];
EG.modals.detailModal = [
	['#detailTabs', '보고 싶은 정보 고르기', '탭을 눌러 투입·계약·급여 정보를 바꿔 봐요.'],
	['#detailBody', '직원 상세', '이 사람의 투입 기간·단가·계약 내용이에요.\n급여 금액이 이상하면 여기서 원인을 찾아보세요.']
];
EG.modals.importModal = [
	['#importFiles', '엑셀 파일 고르기', '급여대장과 사업소득대장 파일(.xls)을 함께 골라요. 여러 개를 한 번에 고를 수 있어요.'],
	['#importResult', '미리 보기', '누가 어떤 직원으로 연결됐는지, 금액이 맞는지 먼저 보여 줘요.\n연결 안 된 사람이 있으면 사번·코드를 확인하세요.'],
	['#btnApply', '반영', '미리 보기가 맞으면 눌러요. 공제 금액만 들어가고 지급액은 그대로예요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/trade_all.jsp'}">
EG.page = [
	['#ym', '여기서 달을 바꿔요', '◀ ▶ 를 누르거나 달력에서 고르면 그 달의 투입·매출·매입·급여가 한 번에 나와요.'],
	['#kpis', '이번 달 한눈에', '매출·매입·급여·영업이익과 투입 인원, 철수 예정, 세금계산서 발급 현황이에요.\n아래에서 보기나 칩을 바꾸면 숫자도 같이 바뀌어요.'],
	['#views', '보고 싶은 것만 골라요', '전체·투입 중·철수 예정·대기·내근직·일반 건으로 줄을 걸러요.\n「거래처별」을 누르면 거래처 한 줄에 매출·매입·차액이 나란히 나와요.'],
	['#chks', '눌러서 켜고 끄기', '고용형태와 일반 건, 확인 필요 칩으로 보고 싶은 줄만 남겨요.\n맨 앞 버튼으로 한 번에 전체 선택·해제해요.'],
	['#taHead', '색 띠를 누르면 접혀요', '투입·매출·매입·급여·손익 색 띠를 누르면 그 묶음이 접히고 대표 칸 하나만 남아요.\n「모두 펴기 / 모두 접기」 버튼도 있고, 접은 상태는 이 브라우저에 기억돼요.'],
	['#taBody', '한 줄에 다 보여요', '사람 한 줄에 투입 → 매출 → 매입 → 급여 → 손익이 이어져요.\n점선 밑줄 금액은 눌러서 바로 고치고, 성명을 누르면 투입 상세와 급여 명세가 팝업으로 열려요.\n투입현황·급여관리와 같은 데이터라 어느 쪽에서 고쳐도 똑같이 바뀌어요.'],
	['#btnSale', '투입 말고 다른 매출·매입', '임대료·장비·용역처럼 투입에서 자동으로 나오지 않는 건은 「일반 매출」「일반 매입」으로 직접 넣어요.'],
	['#btnClosePay', '마감은 두 가지', '급여 마감과 매출·매입 마감이 따로예요.\n매출·매입을 마감하면 일반 건과 금액을 고칠 수 없고, 세금계산서 묶기·발급 표시는 계속 돼요.']
];
EG.modals.formModal = [
	['#PARTNER_SQ', '거래처 고르기', '등록된 거래처를 골라요.\n목록에 없으면 맨 아래 「직접 입력」을 고르고 이름을 적어요.'],
	['#AMT', '공급가액', '부가세를 뺀 금액을 적어요. 세액과 합계금액은 옆 칸에 자동으로 나와요.'],
	['#REPEAT_ON', '매달 반복', '임대료처럼 매달 같은 건은 체크하고 「언제까지」 달을 골라요.\n비워 두면 끌 때까지 매달 만들어요. 그 달 건을 지우면 반복도 그 달부터 멈춰요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/trade_list.jsp' and invoiceOnly}">
EG.page = [
	['#ym', '여기서 달을 바꿔요', '◀ ▶ 를 누르거나 달력에서 고르면 그 달의 매출 건만 나와요.\n세금계산서는 지난달 것을 끊으니까 처음에는 지난달이 열려 있어요.'],
	['#btnExcel', '엑셀로 내려받기', '지금 고른 달을 계산서 엑셀과 같은 칸 배치로 내려받아요.\n묶어 둔 대로 묶음마다 공급가액·세액·합계금액이 붙어 나와요.'],
	['#chips', '미발급·발급 완료', '칩을 꺼서 아직 발급하지 않은 계산서만, 또는 발급한 계산서만 볼 수 있어요.'],
	['#invBody', '계산서 묶기', '매출 건을 거래처별로 몇 행씩 묶는 곳이에요. 정렬과 「한 장에 몇 행」을 정해 「다시 묶기」를 누르고, 행을 끌거나 나누기·합치기로 장마다 행 수를 바꿔요.\n값 옆의 작은 복사 버튼은 그 값만, 「전체 복사」는 보이는 계산서를 한 번에 복사해요.\n건을 넣거나 금액을 고치는 일은 「매출·매입 현황」에서 해요.'],
	['#invBody', '전달 기준 자동 묶음', '이 달에 아직 묶은 적 없는 거래처는 전달 계산서와 같은 장·같은 순서로 자동으로 묶여 보여요(같은 투입 건·같은 반복 건만).\n거래처 이름 옆 「전달 기준 자동 묶음(저장 전)」 표시가 보이면 확인하고 「저장」을 눌러요. 행을 옮기거나 새 건을 넣어도 그 거래처 묶음이 함께 저장돼요.'],
	['#newBody', '새 건', '전달 계산서에 없던 건은 계산서 사이에 끼우지 않고 여기에 거래처별로 모아요.\n줄을 끌어 왼쪽 계산서의 원하는 줄·장 끝·「새 계산서」 칸에 놓거나, 줄 끝에서 「→ 계산서 n」을 고르면 들어가고 여기서 사라져요.\n모두 넣으면 「새 건 없음」이 보여요.'],
	['#invGrip', '폭 조절', '가운데 선을 끌면 계산서와 새 건 칸의 폭이 바뀌어요. ← → 키로도 움직이고, 두 번 누르면 반반으로 돌아가요.\n폭은 이 브라우저에 기억돼요. 좁은 화면에서는 위아래로 쌓여요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/trade_list.jsp'}">
EG.page = [
	['#ym', '여기서 달을 바꿔요', '◀ ▶ 를 누르거나 달력에서 고르면 그 달의 건만 나와요.\n세금계산서는 지난달 것을 끊으니까 처음에는 지난달이 열려 있어요.'],
	['#btnAdd', '투입 말고 다른 건은 여기!', '임대료·장비·용역처럼 투입에서 자동으로 나오지 않는 건을 직접 넣어요.\n거래처로 등록하지 않은 곳은 거래처 칸에서 「직접 입력」을 골라 이름만 적으면 돼요.'],
	<c:if test="${kind eq 'SALE'}">['#btnExcel', '엑셀로 내려받기', '지금 고른 달을 계산서 엑셀과 같은 칸 배치로 내려받아요.\n세금계산서 탭에서 묶어 둔 대로 묶음마다 공급가액·세액·합계금액이 붙어 나와요.'],</c:if>
	['#kpis', '이번 달 합계', '아래 표에 보이는 건의 건수·공급가액·세액·합계금액이에요.\n거래처나 구분 칩을 바꾸면 숫자도 같이 바뀌어요.'],
	['#chips', '눌러서 켜고 끄기', '투입은 투입현황에서 자동으로 나온 건, 나머지는 직접 넣은 건의 구분이에요.\n칩을 꺼서 보고 싶은 구분만 남기고, 전체 선택/해제 버튼으로 한 번에 바꿔요.'],
	<c:if test="${kind eq 'SALE'}">['#tabs', '내역과 세금계산서', '내역은 건을 한 줄씩 보는 표예요.\n세금계산서는 건을 거래처별로 몇 행씩 묶는 곳이에요. 정렬과 「한 장에 몇 행」을 정해 「다시 묶기」를 누르고, 행을 끌거나 나누기·합치기로 장마다 행 수를 바꿔요.\n값 옆의 작은 복사 버튼을 누르면 그 값만 복사돼서 홈택스에 바로 붙여 넣을 수 있어요.\n「전체 복사」는 지금 보이는 계산서를 「몇 년 몇 월 세금계산서 발급 건」 제목과 함께 한 번에 복사해요.'],</c:if>
	['#listBody', '건 목록', '투입 건은 금액을 누르면 이 달 금액만 고칠 수 있어요(비우면 계산 금액으로 돌아가요).\n직접 넣은 건은 품목을 눌러 고치고, 줄 끝 삭제 버튼으로 지워요.']
];
EG.modals.formModal = [
	['#PARTNER_SQ', '거래처 고르기', '등록된 거래처를 골라요.\n목록에 없으면 맨 아래 「직접 입력」을 고르고 이름을 적어요. 거래처 관리에 따로 등록하지 않아도 돼요.'],
	['#TYPE_NM', '구분', '임대료·장비·용역처럼 묶어 보고 싶은 이름을 적어요.\n전에 쓴 구분은 목록으로 나와서 고르기만 하면 돼요.'],
	['#AMT', '공급가액', '부가세를 뺀 금액을 적어요. 세액과 합계금액은 표에서 자동으로 계산돼요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/payslip_list.jsp'}">
EG.page = [
	['#ym', '급여 달 고르기', '명세서를 보낼 달을 골라요. 금액은 급여관리의 값 그대로예요.\n급여관리에서 마감된 달만 보내거나 내려받을 수 있어요. 미리보기는 언제든 돼요.'],
	['#btnConf', '보내는 메일 설정', '메일 제목과 내용 문구를 고치고, 내 메일로 시험 발송해 볼 수 있어요.\n보내는 Gmail 계정·앱 비밀번호는 시스템관리 › 메일 설정에서 정하고, 여기서는 상태만 보여요.'],
	['#chks', '눌러서 켜고 끄기', '고용형태와 발송 상태(미발송·보냄·실패) 칩으로 보고 싶은 사람만 남겨요.\n미발송만 켜면 아직 안 보낸 사람만 모아 볼 수 있어요.'],
	['#pickAll', '보낼 사람 체크', '명세서를 보낼 사람을 체크해요. 맨 위 체크박스는 지금 보이는 사람 전체를 한 번에 골라요.'],
	['#btnMail', '메일 보내기', '체크한 사람에게 PDF 명세서를 인사카드의 개인 메일로 보내요.\nPDF 는 암호가 걸려 있고, 암호는 받는 사람의 생년월일 8자리(예: 19900101)예요.'],
	['#btnZip', 'PDF 내려받기', '체크한 사람의 명세서를 압축 파일(zip)로 한 번에 받아요. 메일 대신 직접 전달할 때 써요.'],
	['#psBody .ps-log', '발송 결과', '마지막으로 보낸 결과예요. 누르면 그 사람에게 언제 누가 보냈는지 이력이 나와요.\n실패로 나오면 인사카드의 개인 메일 주소를 확인하세요.']
];
EG.modals.sendModal = [
	['#sendSummary', '보내기 전 확인', '몇 명에게 보내는지 보여 줘요. 보낼 수 없어서 빠진 사람이 있으면 몇 명 빠짐으로 알려 줘요.'],
	['#sendList', '받는 사람 목록', '한 명씩 차례로 보내고, 줄마다 성공·실패가 표시돼요.'],
