(function() {
	var $tour = document.getElementById('egTour'), hole = document.getElementById('egHole'), bubble = document.getElementById('egBubble'),
		path = document.getElementById('egPath'), fab = document.getElementById('egOpen'), steps = [], i = 0;
	// 화면이 바뀌어 대상이 없거나 숨어 있으면 그 단계는 건너뛴다
	function target(sel) {
		var el = document.querySelector(sel);
		return el && el.getClientRects().length && el.getBoundingClientRect().width ? el : null;
	}
	function build() {
		var modal = document.querySelector('.modal.show'), list;
		if (modal) {
			// 설명을 따로 안 만든 팝업은 공통 순서로
			list = EG.modals[modal.id] || [['#' + modal.id + ' .modal-body', '여기에 입력해요', '칸을 채우거나 내용을 확인해요'], ['#' + modal.id + ' .modal-footer', '저장 · 닫기', '끝났으면 여기서']];
			document.getElementById('egWhat').textContent = ($(modal).find('.modal-title').first().text() || '팝업') + ' 팝업';
		} else {
			list = EG.page.length ? EG.page.concat([['#egOpen', '팝업에서도 눌러 보세요', '열린 팝업 설명이 나와요']])
				: [['.main-sidebar', '왼쪽 메뉴', '내 권한에 있는 화면만 보여요'], ['#egOpen', '언제든 여기!', '화면마다 설명이 나와요']];
			document.getElementById('egWhat').textContent = ($('.bTitle').first().text() || '이 화면') + ' 화면';
		}
		return list.filter(function(s) { return target(s[0]); });
	}
	function open() {
		steps = build();
		if (!steps.length) return;
		i = 0; $tour.hidden = false; show(); document.getElementById('egNext').focus();
	}
	function close() { $tour.hidden = true; fab.focus(); }
	function show(still) {
		var s = steps[i], el = target(s[0]);
		if (!el) { steps.splice(i, 1); if (!steps.length) return close(); i = Math.min(i, steps.length - 1); return show(still); }
		var W = window.innerWidth, H = window.innerHeight, pad = 8, r = el.getBoundingClientRect();
		// 화면 밖일 때만 즉시 스크롤 (부드러운 스크롤 도중에 재면 위치가 어긋난다)
		if (!still && (r.top < 0 || r.bottom > H - 90)) { el.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'instant' }); r = el.getBoundingClientRect(); }
		// 아주 큰 대상(표 전체 등)은 화면 안쪽만 밝힌다
		var top = Math.max(r.top, 8), bottom = Math.min(r.bottom, H - 90), left = Math.max(r.left, 8), right = Math.min(r.right, W - 8);
		hole.style.left = (left - pad) + 'px'; hole.style.top = (top - pad) + 'px';
		hole.style.width = (right - left + pad * 2) + 'px'; hole.style.height = (bottom - top + pad * 2) + 'px';

		// 말풍선은 아래·위 중 넓은 쪽, 가로는 대상 근처에서 화면 밖으로 안 나가게
		var bw = W < 576 ? 230 : 300, below = (H - 90 - bottom) >= (top - 10);
		var cx = (left + right) / 2, bx = Math.min(Math.max(cx + (cx > W / 2 ? -bw - 40 : 60), 16), W - bw - 16);
		var by = below ? Math.min(bottom + pad + 90, H - 190) : Math.max(top - pad - 170, 10);
		bubble.style.left = bx + 'px'; bubble.style.top = by + 'px';
		if (!still) {
			bubble.className = 'eg-bubble' + (s[3] ? ' sec' : '');
			bubble.querySelector('b').textContent = s[1]; bubble.querySelector('span').textContent = s[2];
			void bubble.offsetWidth; bubble.classList.add('show');
		}

		// 화살표: 말풍선 가장자리 → 밝힌 칸 가장자리, 옆으로 휘게
		var sx = bx + (cx > bx + bw / 2 ? bw - 40 : 40), sy = below ? by - 6 : by + 80;
		var tx = Math.min(Math.max(cx, left + 12), right - 12), ty = below ? bottom + pad + 8 : top - pad - 8;
		var qx = (sx + tx) / 2 + (tx > sx ? -60 : 60), qy = (sy + ty) / 2;
		path.setAttribute('d', 'M' + sx + ',' + sy + ' Q' + qx + ',' + qy + ' ' + tx + ',' + ty);
		path.classList.remove('draw'); path.style.setProperty('--len', path.getTotalLength()); void path.getBBox();
		if (still) path.style.strokeDashoffset = 0; else { path.style.strokeDashoffset = ''; path.classList.add('draw'); }

		document.getElementById('egDots').innerHTML = steps.map(function(st, k) { return '<i class="' + (k === i ? 'on' : '') + (st[3] ? ' sec' : '') + '"></i>'; }).join('');
		document.getElementById('egPrev').style.visibility = i ? 'visible' : 'hidden';
		document.getElementById('egNext').textContent = i === steps.length - 1 ? '끝' : '다음';
	}
	function next() { if (i < steps.length - 1) { i++; show(); } else close(); }
	function prev() { if (i > 0) { i--; show(); } }
	fab.addEventListener('click', open);
	document.getElementById('egSkip').addEventListener('click', close);
	document.getElementById('egPrev').addEventListener('click', prev);
	document.getElementById('egNext').addEventListener('click', next);
	// 어두운 곳을 눌러도 다음으로
	$tour.addEventListener('click', function(e) { if (!e.target.closest('.eg-ctrl')) next(); });
	// 팝업의 Esc 닫기보다 먼저 받아서 가이드만 닫는다
	document.addEventListener('keydown', function(e) {
		if ($tour.hidden) return;
		if (e.key === 'Escape') close(); else if (e.key === 'ArrowRight') next(); else if (e.key === 'ArrowLeft') prev(); else return;
		e.preventDefault(); e.stopPropagation();
	}, true);
	window.addEventListener('resize', function() { if (!$tour.hidden) show(true); });
	// 팝업 안 스크롤 등으로 대상이 움직이면 따라간다
	document.addEventListener('scroll', function() { if (!$tour.hidden) show(true); }, true);
})();
</script>
