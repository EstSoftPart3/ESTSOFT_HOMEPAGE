<c:when test="${guidePath eq '/WEB-INF/jsp/bo/system/feedback_list.jsp'}">
EG.page = [
	['#chks', '상태로 거르기', '접수·검토 대기·진행 중·반영·보류·반려 칩을 켜고 꺼요. 처음엔 반영·반려를 빼고 보여요.\n평일 오전 9시 30분·11시, 오후 2시·4시에 Claude 가 새 피드백(코멘트가 달린 건 포함)마다 기획서를 붙여 검토 대기로 바꿔 둬요.'],
	['#flBody', '피드백 고르기', '줄을 누르면 오른쪽에 요청 내용, 기획서(바꿀 것·예상 시간), 처리 내용이 나와요.\n요청자는 모든 관리자가 볼 수 있어서 같은 요청을 겹쳐 쓰지 않게 해 줘요.'],
	['#flHandle', '목록·상세 폭 조절', '목록과 상세 사이 손잡이를 좌우로 끌면 폭이 바뀌고, 놓는 순간 이 브라우저에 저장돼요(다음에 열어도 그 폭).\n손잡이를 누른 뒤 ←·→ 키로도 조절하고, 더블클릭하면 처음 폭(종류 칸까지)으로 돌아가요.'],
	['#flDetail .fl-spec', '기획서 바로 보기', '고른 피드백의 기획서(바뀔 화면 그림과 바꿀 것·테스트할 것·주의할 것)가 이 자리에 바로 보여요.\n칸 안에서 스크롤하고, 오른쪽 위 ⤢ 기획서 크게 보기를 누르면 큰 창으로 열려요.'],
	['textarea[aria-label="기획서 코멘트"]', '기획서에 코멘트', '기획서의 바꿀 것을 보고 더하거나 바꿀 점을 적어요(슈퍼관리자·시스템 운영자, 요청자 본인).\n요청자가 남긴 코멘트는 코멘트 탭에 「요청자」로 표시돼요.\n진행 중인 건이면 확인창이 한 번 더 뜨고, 승인하면 진행이 풀려 접수로 돌아가요.\n남기면 접수로 돌아가고, 다음 처리 때 Claude 가 지금까지의 코멘트를 모두 반영해 기획서를 다시 만들어요.'],
	['.fl-tabs', '개발 내용 · 코멘트 · 변경 로그', '개발 내용: 기획서의 바꿀 것·예상 시간과 진행할 때 적은 개발 반영 내용(개발할 때 보는 글).\n코멘트: 누가 언제 어떤 코멘트를 남겼는지와 반영 여부 — 그 뒤에 기획서가 다시 만들어졌으면 ✔ 반영됨, 아니면 ⏳ 반영 대기.\n변경 로그: 기획서가 만들어지고 바뀐 기록만. 그때 기획서를 누르면 예전 기획서를 다시 볼 수 있어요.'],
	['#flDetail', '진행 · 보류 · 반려', '슈퍼관리자·시스템 운영자에게만 오른쪽 위(#번호 줄)에 버튼이 보여요. 어느 탭에서나 누를 수 있어요.\n진행: 개발 반영 내용을 적으면 다음 처리 때 Claude 가 그대로 개발·배포하고 반영으로 바꿔요.\n보류: 입력 없이 미뤄 둬요. 반려: 사유를 적으면 요청자 피드백 창에 그대로 보여요.']
];
</c:when>
