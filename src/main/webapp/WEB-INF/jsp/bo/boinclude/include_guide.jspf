	['#mcBody', '메일 목록', '메일마다 언제 나가는지, 어느 계정으로 보내는지, 그 계정의 연결 상태와 받는 사람이 보여요.\n회색 받는 사람은 결재자·직원 메일처럼 화면 데이터로 정해져요.'],
	['#mcBody .mc-edit', '설정', '그 메일의 보내는 계정(Gmail·앱 비밀번호)과 받는 사람을 고쳐요.\n받는 사람은 계정 목록에서 고르거나 바깥 주소를 직접 넣어요.'],
	['#btnVerifyAll', '전체 연결 확인', '모든 계정에 Gmail 로그인만 해 보고 연결 상태를 새로 고쳐요. 메일은 보내지 않아요.'],
	['#btnHist', '변경 이력', '누가 언제 어느 메일·계정을 바꿨는지 봐요. 비밀번호 값은 남기지 않아요.']
];
EG.modals.mcModal = [
	['#mAcc', '보내는 계정', '이미 있는 계정을 고르거나 「+ 새 계정 추가」로 만들어요.\n같은 계정을 쓰는 메일이 여럿이면 계정 칸을 고칠 때 모두 바뀌어요.'],
	['#btnPickFrom', '계정에서 고르기', '홈페이지 계정 목록에서 골라 그 메일을 Gmail 주소 칸에 넣어요. 앱 비밀번호는 그 Gmail 주인이 만들어 줘야 해요.'],
	['#mPw', '앱 비밀번호', 'Gmail 로그인 비밀번호가 아니라 구글 계정 보안에서 만드는 16자리예요. 저장하면 다시 보이지 않아요.'],
	['#mFromNm', '보내는 이름', '받는 사람 메일함에 보이는 이름이에요. 같은 계정을 써도 메일마다 따로 정해요.'],
	['#mToWrap', '받는 사람', '파란 칩은 계정(메일을 바꾸면 따라 바뀜), 회색 칩은 직접 넣은 주소예요. 주소를 쓰고 Enter 로 넣어요.'],
	['#btnVerify', '연결 확인', '저장한 뒤 Gmail 에 로그인만 해 봐요. 메일은 보내지 않아요.'],
	['#btnTest', '시험 메일', '저장한 뒤 이 메일의 계정으로 내 메일에 한 통 보내 봐요.']
];
