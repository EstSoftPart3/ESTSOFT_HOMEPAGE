<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%-- 화면 가이드: 우측 하단 버튼 → 지금 화면의 사용법. 화면은 JSP 경로로 고른다. 시크릿 설명은 시크릿 계정(secretViewer)에게만 출력 --%>
<c:set var="guidePath" value="${pageContext.request.servletPath}"/>
<style>
	.eg-fab { position: fixed; right: 22px; bottom: 22px; z-index: 1030; display: flex; align-items: center; gap: 8px; height: 52px; padding: 0 16px 0 14px; border: 0; border-radius: 26px;
		background: rgba(37, 99, 235, .55); color: #fff; font-size: 14px; font-weight: 600; box-shadow: 0 6px 20px rgba(37, 99, 235, .3); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
		cursor: pointer; transition: background .2s, transform .2s, box-shadow .2s; }
	.eg-fab:hover, .eg-fab:focus-visible { background: rgba(37, 99, 235, .95); transform: translateY(-2px); box-shadow: 0 10px 26px rgba(37, 99, 235, .4); outline: none; }
	.eg-fab .q { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: rgba(255,255,255,.25); font-size: 16px; }
	.eg-fab .t { max-width: 0; overflow: hidden; white-space: nowrap; transition: max-width .25s; }
	.eg-fab:hover .t, .eg-fab:focus-visible .t { max-width: 90px; }
	.eg-bg { position: fixed; inset: 0; z-index: 1070; background: rgba(15, 23, 42, .45); display: flex; align-items: center; justify-content: center; padding: 24px; opacity: 0; transition: opacity .2s; }
	.eg-bg[hidden] { display: none; }
	.eg-bg.on { opacity: 1; }
	.eg-box { position: relative; width: min(880px, 100%); max-height: calc(100vh - 48px); overflow: auto; background: #fff; border-radius: 20px; box-shadow: 0 24px 60px rgba(15, 23, 42, .3); transform: translateY(12px) scale(.98); transition: transform .2s; }
	.eg-bg.on .eg-box { transform: none; }
	.eg-head { position: relative; padding: 30px 34px 26px; background: linear-gradient(135deg, #2563eb, #7c3aed); color: #fff; border-radius: 20px 20px 0 0; }
	.eg-head .ic { display: inline-flex; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: 14px; background: rgba(255,255,255,.18); font-size: 24px; margin-bottom: 12px; }
	.eg-head h2 { margin: 0 0 6px; font-size: 24px; font-weight: 700; }
	.eg-head p { margin: 0; font-size: 15px; opacity: .92; line-height: 1.6; }
	/* 스크롤해도 보이게 sticky. float 로 머리 위에 겹친다 */
	.eg-x { position: sticky; top: 14px; float: right; margin: 14px 14px -52px 0; z-index: 2; width: 38px; height: 38px; border: 0; border-radius: 50%; background: rgba(255,255,255,.18); color: #fff; font-size: 20px; line-height: 1; cursor: pointer; }
	.eg-x:hover, .eg-x:focus-visible { background: rgba(255,255,255,.32); outline: none; }
	.eg-body { padding: 26px 34px 32px; }
	.eg-body h3 { font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
	.eg-body h3 + * { margin-bottom: 26px; }
	.eg-steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; counter-reset: eg; }
	.eg-steps li { position: relative; padding: 16px 16px 16px 58px; border: 1px solid #e2e8f0; border-radius: 14px; background: #f8fafc; counter-increment: eg; }
	.eg-steps li::before { content: counter(eg); position: absolute; left: 16px; top: 15px; width: 30px; height: 30px; border-radius: 50%; background: #2563eb; color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; }
	.eg-steps b { display: block; font-size: 14.5px; color: #0f172a; margin-bottom: 4px; }
	.eg-steps span { font-size: 13.5px; color: #475569; line-height: 1.6; }
	.eg-tips { list-style: none; padding: 0; }
	.eg-tips li { position: relative; padding: 11px 14px 11px 40px; border-radius: 12px; background: #fffbeb; color: #78350f; font-size: 13.5px; line-height: 1.6; margin-bottom: 8px; }
	.eg-tips li::before { content: '💡'; position: absolute; left: 14px; top: 11px; }
	.eg-secret { padding: 18px 20px; border-radius: 14px; background: #1e1b4b; color: #e0e7ff; font-size: 13.5px; line-height: 1.7; }
	.eg-secret b { color: #fff; }
	.eg-secret ul { margin: 6px 0 0; padding-left: 18px; }
	.eg-foot { padding: 14px 34px; border-top: 1px solid #e2e8f0; font-size: 12.5px; color: #64748b; text-align: center; }
	kbd.eg { background: #e2e8f0; color: #0f172a; border-radius: 4px; padding: 1px 6px; font-size: 12px; }
	@media (max-width: 576px) { .eg-head, .eg-body { padding-left: 20px; padding-right: 20px; } .eg-fab { right: 14px; bottom: 14px; } }
	@media (prefers-reduced-motion: reduce) { .eg-fab, .eg-bg, .eg-box, .eg-fab .t { transition: none; } }
</style>

<button type="button" class="eg-fab" id="egOpen" aria-haspopup="dialog" aria-controls="egPanel"><span class="q" aria-hidden="true">?</span><span class="t">화면 가이드</span></button>

<div class="eg-bg" id="egPanel" role="dialog" aria-modal="true" aria-labelledby="egTitle" hidden>
	<div class="eg-box">
		<button type="button" class="eg-x" id="egClose" aria-label="가이드 닫기">&times;</button>
		<c:choose>
		<%-- ───────── 투입현황 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/deploy_list.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-user-tie"></i></span><h2 id="egTitle">투입현황</h2><p>누가 어느 고객사·프로젝트에 나가 있는지, 쉬고 있는 사람과 곧 끝나는 사람이 누구인지 한눈에 봅니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>기준월 고르기</b><span>오른쪽 위 ◀ ▶ 로 달을 바꾸면 그 달에 일한 사람만 보입니다.</span></li>
					<li><b>보기 탭 고르기</b><span><b style="display:inline">투입 현황</b>·<b style="display:inline">대기 현황</b>(쉬는 사람)·<b style="display:inline">철수 임박</b>(이번·다음 달 종료)을 눌러 바꿉니다.</span></li>
					<li><b>원하는 사람만 추리기</b><span>정규·수습·특고프리 같은 칩을 켜고 끄거나, 검색창과 고객사·지역·등급 목록으로 좁힙니다.</span></li>
					<li><b>표에서 바로 고치기</b><span>칸을 누르면 그 자리에서 고칠 수 있고, 누가 언제 바꿨는지 이력에 남습니다.</span></li>
					<li><b>사람 자세히 보기</b><span>이름을 누르면 투입 상세가 열려 기간·단가를 고치거나 <b style="display:inline">철수 후 다음 투입</b>을 등록합니다.</span></li>
					<li><b>새 투입 등록</b><span>오른쪽 위 <b style="display:inline">+ 추가</b>를 누르면 표 맨 위에 입력 줄이 생깁니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>표/타임라인 버튼으로 기간을 막대 그래프처럼 볼 수 있습니다.</li>
					<li>머리글을 끌어 칸 순서를 바꿀 수 있고, <b>컬럼 순서 초기화</b>로 원래대로 돌립니다.</li>
					<li>한 사람이 같은 달에 계약이 두 건이면 두 줄로 묶여 보이고, 아랫줄은 └ 표시가 붙습니다.</li>
					<li>✎ 이력 버튼에서 잘못 고친 값을 <b>↶ 되돌리기</b>로 되돌릴 수 있습니다. 💬 메모는 작성자·시간이 자동으로 남습니다.</li>
				</ul>
				<c:if test="${secretViewer}">
				<h3>🔒 시크릿 (시크릿 계정에게만 보이는 안내)</h3>
				<div class="eg-secret">시크릿 계정에 연결된 직원은 <b>시크릿 계정에게만</b> 보이고, 다른 관리자에게는 행·합계·건수·엑셀에서 모두 빠집니다.
					<ul>
						<li>목록 위 <b>🔒 시크릿</b> 칩을 끄면 시크릿 직원을 잠시 숨기고 볼 수 있습니다. 숫자는 시크릿 인원 수입니다.</li>
						<li>시크릿 직원 행에는 🔒 표시가 붙고 위쪽으로 모입니다.</li>
						<li>화면을 다른 사람과 같이 볼 때는 칩을 꺼 두세요.</li>
					</ul>
				</div>
				</c:if>
			</div>
		</c:when>

		<%-- ───────── 급여관리 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/pay_list.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-won-sign"></i></span><h2 id="egTitle">급여관리</h2><p>달마다 직원별 급여·수당·공제·손익을 계산하고, 확인이 끝나면 마감합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>급여 월 고르기</b><span>◀ ▶ 로 달을 고르고, 옆 칸에 <b style="display:inline">지급일자</b>를 넣습니다.</span></li>
					<li><b>공제 불러오기</b><span>급여대장·사업소득대장 엑셀(.xls)을 올리면 공제 금액이 자동으로 들어갑니다.</span></li>
					<li><b>칸 펼쳐 보기</b><span><b style="display:inline">수당·공제·손익 펼치기</b> 버튼이나 머리글 색 띠를 누르면 자세한 칸이 열립니다.</span></li>
					<li><b>값 확인·수정</b><span>칸을 누르면 바로 고쳐지고 이력에 남습니다. <span style="background:#fff3bf;padding:0 4px;border-radius:3px">노란 칸</span>은 자동계산을 사람이 고친 값입니다.</span></li>
					<li><b>확인 사항 정리</b><span>이름 옆 칩(예: 만근미달)을 보고, 확인했으면 ✕ 로 숨깁니다.</span></li>
					<li><b>마감</b><span>모두 확인되면 오른쪽 위 마감 버튼을 누릅니다. 마감 해제는 사유를 남겨야 합니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>위쪽 숫자 카드는 이번 달 인원·합계 요약입니다.</li>
					<li>이름을 누르면 직원 상세 팝업에서 투입 정보와 계약을 같이 봅니다.</li>
					<li>상여는 <b>상여관리</b>에서 조건을 정하고 <b>직원관리</b>에서 사람별로 켜면 자동으로 들어옵니다. 이번 달만 빼려면 상여 칩의 ✕ 를 누릅니다.</li>
					<li>잘못 고쳤으면 ✎ 이력에서 <b>↶ 되돌리기</b>를 누릅니다.</li>
				</ul>
				<c:if test="${secretViewer}">
				<h3>🔒 시크릿 (시크릿 계정에게만 보이는 안내)</h3>
				<div class="eg-secret">시크릿 직원의 급여 행은 <b>시크릿 계정에게만</b> 보이고, 다른 관리자 화면에서는 행·합계·건수·엑셀에서 모두 빠집니다.
					<ul>
						<li>체크 칩 중 <b>🔒 시크릿</b> 칩을 끄면 시크릿 직원을 숨기고 볼 수 있습니다.</li>
						<li>합계 카드는 지금 화면에 보이는 행 기준이라, 칩을 끄면 시크릿 금액이 빠진 합계가 됩니다.</li>
					</ul>
				</div>
				</c:if>
			</div>
		</c:when>

		<%-- ───────── 상여관리 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/bonus_list.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-gift"></i></span><h2 id="egTitle">상여관리</h2><p>만근·근속 상여 같은 지급 조건을 정해 두면 급여관리에 자동으로 들어갑니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>상여 항목 등록</b><span>오른쪽 위 <b style="display:inline">+ 상여 항목 등록</b>을 누릅니다.</span></li>
					<li><b>조건 정하기</b><span>기준과 금액을 넣고, 필요하면 <b style="display:inline">+ 단계 추가</b>로 기간별 금액을 나눕니다.</span></li>
					<li><b>사람에게 켜기</b><span><b style="display:inline">직원관리</b>에서 사람별 상여 칩을 켜야 그 사람에게 적용됩니다.</span></li>
					<li><b>적용 인원 확인</b><span>목록의 <b style="display:inline">n명</b>을 누르면 켜진 직원이 보입니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>상여는 달성한 달의 <b>다음 달 급여</b>에 들어갑니다.</li>
					<li>만근 = 기준일부터 달성일 전날까지 매일 근무, 근속 = 달성일 전날 근무 중. 못 채우면 급여관리에 '만근미달' 칩이 뜹니다.</li>
					<li>사용을 끄면 다음 계산부터 빠지고, 이미 마감된 달은 그대로입니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 매출/매입처 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/partner_list.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-handshake"></i></span><h2 id="egTitle">매출/매입처</h2><p>투입현황에서 고르는 거래처(매출처·매입처)를 등록하고 관리합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>탭으로 보기</b><span>전체·매출처·매입처·사용 중지 탭으로 나눠 봅니다.</span></li>
					<li><b>거래처 등록</b><span>등록 버튼을 누르고 상호·사업자 정보와 매출처·매입처 여부를 고릅니다.</span></li>
					<li><b>서류 붙이기</b><span>사업자등록증 같은 서류를 올리면 칩으로 표시됩니다.</span></li>
					<li><b>수정</b><span>거래처 이름이나 <b style="display:inline">수정</b>을 누르면 정보를 고칠 수 있습니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>삭제는 투입 기록이 없는 거래처만 됩니다.</li>
					<li>기록이 있는 거래처는 <b>사용 중지</b>로 바꾸면 새 입력 목록에서만 빠지고 과거 기록은 남습니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 직원관리 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/staff/staff_list.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-id-card"></i></span><h2 id="egTitle">직원관리</h2><p>직원 명부와 인사카드(개인정보·계좌·서류·프로젝트 이력)를 관리합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>찾기</b><span>재직 상태 탭, 소속 버튼, 직급·정렬 목록으로 원하는 직원을 찾습니다.</span></li>
					<li><b>바로 고치기</b><span>표의 칸을 누르면 그 자리에서 수정됩니다.</span></li>
					<li><b>인사카드 열기</b><span>이름을 누르면 인사카드가 열려 탭별로 정보를 보고 고칩니다.</span></li>
					<li><b>서류 연결</b><span>인사카드에서 구글 드라이브에 있는 서류를 골라 연결하면 글자를 읽어 칸을 채워 줍니다.</span></li>
					<li><b>직원 등록</b><span>오른쪽 위 <b style="display:inline">+ 직원 등록</b> → 등록하면 인사카드가 바로 열립니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>칸 위에 마우스를 올리고 <kbd class="eg">Ctrl</kbd>+<kbd class="eg">C</kbd> 를 누르면 그 칸 값만 복사됩니다. 가려진 주민번호·계좌번호도 원문이 복사됩니다.</li>
					<li>주민번호·계좌번호는 가려져 있고, 👁 버튼을 눌러야 원문이 보입니다.</li>
					<li>상여 항목을 고르면 사람별 상여 칩을 켜고 끌 수 있습니다.</li>
					<li>미제출 서류가 있으면 인사카드 서류 탭에 건수가 표시됩니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 계정관리 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/member/member_list.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-user-shield"></i></span><h2 id="egTitle">계정관리</h2><p>직원에게 로그인 계정을 발급하고, 관리자 권한과 사용 상태를 관리합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>계정 발급</b><span><b style="display:inline">+ 계정 발급</b>을 누릅니다. 아이디는 회사 메일 @ 앞부분입니다.</span></li>
					<li><b>초기 비밀번호 전달</b><span>발급 직후 <b style="display:inline">한 번만</b> 보여 주니 복사해서 본인에게 전달합니다.</span></li>
					<li><b>계정 카드</b><span>이름을 누르면 기본정보·권한정보·비밀번호 탭이 있는 계정 카드가 열립니다.</span></li>
					<li><b>권한 주기</b><span>권한정보 탭에서 권한을 하나라도 주면 관리자 계정이 됩니다.</span></li>
					<li><b>여러 명 한 번에</b><span>체크한 뒤 <b style="display:inline">전체 사용중지·퇴사·삭제</b>를 누릅니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>위쪽 알림의 <b>퇴사한 직원의 사용 중 계정</b>을 누르면 정리할 계정만 모아 봅니다.</li>
					<li>비밀번호 목록에서 '초기 비밀번호'를 고르면 아직 비밀번호를 안 바꾼 사람을 찾습니다.</li>
					<li>주민등록번호와 주소는 계정 카드에서만 볼 수 있습니다.</li>
				</ul>
				<c:if test="${secretViewer}">
				<h3>🔒 시크릿 (시크릿 계정에게만 보이는 안내)</h3>
				<div class="eg-secret">계정 카드의 <b>시크릿</b> 탭에서 시크릿 계정을 켜고 끕니다. 누르는 즉시 저장됩니다.
					<ul>
						<li>시크릿을 켜면 이 계정에 연결된 직원의 투입현황·급여관리 행과 합계·건수·엑셀이 시크릿이 아닌 사람에게 모두 빠집니다.</li>
						<li>시크릿 계정끼리는 서로 보입니다.</li>
						<li>이 탭은 시크릿 계정인 슈퍼관리자에게만 보이고, 내 계정의 시크릿은 다른 시크릿 계정이 바꿔야 합니다.</li>
					</ul>
				</div>
				</c:if>
			</div>
		</c:when>

		<%-- ───────── 면접관리 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/hr/interview_list.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-comments"></i></span><h2 id="egTitle">면접 관리</h2><p>면접자 일정·참석·합격 통보·입사 여부를 기록하고, 결과를 대시보드로 봅니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>기간 고르기</b><span>연도·월·주차를 고르면 그 기간 면접자만 보입니다.</span></li>
					<li><b>찾기</b><span>검색창은 이름·연락처·비고를 <b style="display:inline">모든 연도</b>에서 찾습니다. 경로·참석·통보·입사로 더 좁힐 수 있습니다.</span></li>
					<li><b>등록·수정</b><span><b style="display:inline">등록</b>으로 새 면접자를 넣고, <b style="display:inline">상세</b>로 내용을 고칩니다.</span></li>
					<li><b>교육생으로 넘기기</b><span>입사가 정해지면 상세에서 <b style="display:inline">교육생으로 등록</b>을 누릅니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>맨 위 대시보드는 지금 검색 조건 기준 통계입니다. <b>보고 내용 복사</b>로 메신저에 바로 붙여 넣을 수 있습니다.</li>
					<li>신입면접 배치가 켜져 있으면 캘린더의 면접 일정이 매일 자동으로 들어옵니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 교육생관리 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/hr/trainee_list.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-graduation-cap"></i></span><h2 id="egTitle">교육생 관리</h2><p>입사한 면접자의 교육 진행 상황을 주차별 카드로 관리합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>면접자 가져오기</b><span>입사여부가 '입사'인 면접자를 골라 <b style="display:inline">선택한 면접자 가져오기</b>를 누르면 교육진행중으로 등록됩니다.</span></li>
					<li><b>주차 옮기기</b><span>교육진행중 카드를 끌어서 다른 주차로 옮깁니다.</span></li>
					<li><b>바로 고치기</b><span>카드의 값을 누르면 바로 수정됩니다. <b style="display:inline">상세</b>로 전체 내용을 봅니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>교육일수는 일요일을 뺀 일수입니다.</li>
					<li>연장은 기준 28일을 넘긴 일수입니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 연구일지 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/lab/journal_list.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-flask"></i></span><h2 id="egTitle">연구일지</h2><p>연구 과제를 등록하고, 과제별 연구일지를 쓰고 결재 상태를 확인합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>과제 찾기</b><span>연구팀·과제명·진행 여부를 고르고 <b style="display:inline">조회</b>를 누릅니다.</span></li>
					<li><b>과제 등록</b><span><b style="display:inline">+ 과제 등록</b>에서 연구팀·과제명·기간을 넣습니다.</span></li>
					<li><b>일지 쓰기</b><span>과제 줄의 일지 버튼을 눌러 날짜별 연구일지를 작성합니다.</span></li>
					<li><b>결재 확인</b><span>목록의 결재 상태에서 진행 상황을 봅니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>연구팀·결재라인·연구원은 <b>연구소 관리</b> 화면에서 정합니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 연구소 관리 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/lab/lab_manage.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-microscope"></i></span><h2 id="egTitle">연구소 관리</h2><p>연구팀, 연구원, 결재라인, 서명을 관리합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>연구팀 등록</b><span><b style="display:inline">+ 연구팀 등록</b>으로 팀 이름과 연구 분야를 넣습니다.</span></li>
					<li><b>연구원 지정</b><span>팀을 눌러 들어가 연도별 연구원을 정합니다. 이전·다음 연도로 넘겨 봅니다.</span></li>
					<li><b>결재라인</b><span><b style="display:inline">+ 결재자 추가</b> 후 ⋮⋮ 를 끌거나 ▲▼ 로 순서를 바꿉니다.</span></li>
					<li><b>서명</b><span>서명 칸에 직접 그리고 저장합니다. 다시 그리려면 지우기.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>안 쓰는 팀은 사용을 끄면 연구일지 선택 목록에서 빠집니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 장비대장 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/equipment/equipment_list.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-laptop"></i></span><h2 id="egTitle">장비대장</h2><p>회사 장비를 등록하고 대여·반납·폐기와 대여증서 서명을 처리합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>장비 등록</b><span><b style="display:inline">+ 장비 등록</b>으로 새 장비를 넣습니다.</span></li>
					<li><b>대여</b><span><b style="display:inline">대여 등록</b> → 저장하면 받는 사람에게 대여증서 서명을 요청합니다.</span></li>
					<li><b>반납·처리</b><span>장비를 눌러 반납 완료나 폐기·분실 처리를 합니다.</span></li>
					<li><b>상태별로 보기</b><span>위쪽 탭으로 대여 중·보관·폐기 장비를 나눠 봅니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>브랜드·모델·시리얼·특이사항은 칸을 눌러 바로 고칩니다. 상태와 사용자는 대여·반납으로만 바뀝니다.</li>
					<li><b>장비 비밀번호는 적지 마세요.</b></li>
					<li><b>직인</b>에 회사 도장 이미지(500KB 이하 PNG·JPG)를 올리면 대여증서에 찍힙니다.</li>
					<li>체크한 장비는 <b>라벨 인쇄</b>, 목록 전체는 <b>엑셀 내려받기</b>를 할 수 있습니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 전수조사 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/equipment/audit_list.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-clipboard-check"></i></span><h2 id="egTitle">전수조사</h2><p>장비가 실제로 제자리에 있는지 회차별로 확인합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>응답 확인</b><span>계정이 있는 직원은 홈페이지 '내 장비'에서 직접 응답합니다.</span></li>
					<li><b>수기 입력</b><span>게스트·보관 장비는 담당자가 직접 확인하고 입력합니다.</span></li>
					<li><b>미응답 챙기기</b><span><b style="display:inline">미응답만</b>을 눌러 아직 답이 없는 장비만 봅니다.</span></li>
					<li><b>회차 마감</b><span>확인이 끝나면 <b style="display:inline">회차 마감</b>을 누릅니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>문제가 있는 장비는 이슈로 남기면 장비대장에 표시됩니다.</li>
					<li><b>엑셀 내려받기</b>로 결과를 보고용으로 받을 수 있습니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 캘린더 가져오기 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/calendar/calendar_sync.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-calendar-plus"></i></span><h2 id="egTitle">캘린더 일정 가져오기·분류</h2><p>구글 캘린더 일정을 가져와 분류를 정하고 확정합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>처음 한 번 연동</b><span>'구글 연동 설정'에 클라이언트 ID·시크릿을 넣고 저장합니다. '설정됨'이 뜨면 끝.</span></li>
					<li><b>일정 조회</b><span>시작일·종료일·캘린더를 고르고 <b style="display:inline">조회</b>를 누릅니다.</span></li>
					<li><b>분류 고르기</b><span>가져온 일정마다 분류를 정합니다.</span></li>
					<li><b>확정</b><span>체크한 뒤 <b style="display:inline">선택 확정</b>. 한 번에 고르려면 '미확정 전체 선택'.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>확정한 일정은 <b>확정 일정 분류별 보기</b> 화면에서 모아 봅니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 확정 일정 보기 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/calendar/calendar_list.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-calendar-check"></i></span><h2 id="egTitle">확정 일정 분류별 보기</h2><p>확정한 일정을 분류별로 모아 봅니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>기간 고르기</b><span>시작일·종료일을 고르고 <b style="display:inline">조회</b>를 누릅니다.</span></li>
					<li><b>분류 탭</b><span>위쪽 분류 탭을 눌러 그 분류 일정만 봅니다.</span></li>
					<li><b>확정자 확인</b><span>표에서 장소와 누가 확정했는지 같이 보입니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>일정을 새로 가져오거나 분류를 바꾸려면 <b>캘린더 일정 가져오기·분류</b> 화면으로 갑니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 신입면접 배치 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/batch/interview_batch.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-robot"></i></span><h2 id="egTitle">신입면접 배치</h2><p>구글 캘린더의 면접 일정과 드라이브의 이력서를 매일 자동으로 면접관리에 넣어 줍니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>가져올 곳 등록</b><span>이름, iCal 비공개 주소, 이력서 폴더 주소를 넣고 <b style="display:inline">저장</b>합니다. 여러 개면 <b style="display:inline">새로 추가</b>.</span></li>
					<li><b>구글 계정 연결</b><span>클라이언트 ID·시크릿을 넣고 <b style="display:inline">연결</b>을 눌러 드라이브 계정을 연결합니다.</span></li>
					<li><b>자동 실행 켜기</b><span>'자동 09:00'을 켜면 매일 아침 9시에 가져옵니다.</span></li>
					<li><b>바로 실행</b><span>기다리지 않고 지금 가져오려면 <b style="display:inline">지금 실행</b>.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>실행 기록의 <b>보기</b>를 누르면 몇 건을 넣었는지와 문제 내용이 보입니다.</li>
					<li>클라이언트 ID와 시크릿은 모든 줄에 공통으로 쓰입니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 게시판 관리 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/board/board_list_tabs.jsp' or guidePath eq '/WEB-INF/jsp/bo/board/board_view.jsp' or guidePath eq '/WEB-INF/jsp/bo/board/board_form.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-clipboard-list"></i></span><h2 id="egTitle">게시판 관리</h2><p>공지사항·자유·기술문의·교육일정 게시판의 글을 쓰고 관리합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>게시판 고르기</b><span>위쪽 탭에서 게시판을 고릅니다.</span></li>
					<li><b>걸러 보기</b><span>사용/미사용, 삭제 포함 여부, 블라인드만 보기 버튼으로 목록을 거릅니다.</span></li>
					<li><b>여러 글 한 번에</b><span>체크한 뒤 블라인드·블라인드 해제 같은 버튼을 누릅니다.</span></li>
					<li><b>글 보기·쓰기</b><span>제목을 누르면 글이 열리고, 글쓰기에서 새 글을 올립니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li><b>블라인드</b>는 글을 지우지 않고 홈페이지에서만 가립니다.</li>
					<li>체크박스는 <kbd class="eg">Shift</kbd>+클릭으로 사이를 한 번에 고를 수 있습니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 메뉴 관리 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/system/menu_manage.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-sitemap"></i></span><h2 id="egTitle">메뉴 관리</h2><p>왼쪽 관리자 메뉴의 이름·주소·순서·숨김을 정합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>메뉴 고르기</b><span>목록에서 메뉴를 누르면 오른쪽에 정보가 나옵니다.</span></li>
					<li><b>고치고 저장</b><span>이름·상위 메뉴·화면 주소·아이콘·표시(사용/숨김)를 바꾸고 <b style="display:inline">저장</b>합니다.</span></li>
					<li><b>순서 바꾸기</b><span>목록에서 메뉴를 끌어 놓으면 순서가 바로 저장됩니다.</span></li>
					<li><b>권한 연결</b><span>메뉴를 만든 뒤 <b style="display:inline">권한 관리</b>에서 누가 쓸지 정합니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>새 화면은 <b>접근 경로</b>에 데이터 요청 주소까지 넣어야 권한이 있는 사람이 쓸 수 있습니다.</li>
					<li>하위 메뉴가 있는 메뉴는 지울 수 없습니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 권한 관리 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/system/role_manage.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-key"></i></span><h2 id="egTitle">권한 관리</h2><p>권한(역할)을 만들고, 그 권한이 쓸 메뉴와 사람을 정합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>권한 만들기</b><span>권한 이름을 넣고 <b style="display:inline">저장</b>합니다.</span></li>
					<li><b>메뉴 고르기</b><span>권한을 골라 쓸 수 있는 메뉴를 체크하고 저장합니다.</span></li>
					<li><b>사람 넣기</b><span>계정을 골라 <b style="display:inline">추가</b>, 빼려면 <b style="display:inline">제외</b>.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>슈퍼관리자는 항상 모든 메뉴를 씁니다.</li>
					<li>계정관리에서 관리자로 지정된, 사용 중인 계정만 추가할 수 있습니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 공통코드 ───────── --%>
		<c:when test="${guidePath eq '/WEB-INF/jsp/bo/code/codeList.jsp'}">
			<div class="eg-head"><span class="ic"><i class="fas fa-list-ol"></i></span><h2 id="egTitle">공통코드</h2><p>화면의 선택 목록(고용형태·등급 등)에 쓰는 코드를 관리합니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>상위 코드 고르기</b><span>왼쪽 표에서 코드 묶음을 고르면 오른쪽에 세부 코드가 나옵니다.</span></li>
					<li><b>코드 추가</b><span>각 표의 <b style="display:inline">코드추가</b>를 누르고 값을 넣습니다.</span></li>
					<li><b>고치기</b><span>표의 줄을 눌러 이름이나 순서를 바꿉니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>쓰고 있는 코드를 바꾸면 그 코드를 쓰는 화면의 선택 목록이 같이 바뀌니 신중히 고칩니다.</li>
				</ul>
			</div>
		</c:when>

		<%-- ───────── 그 밖의 화면: 공통 사용법 ───────── --%>
		<c:otherwise>
			<div class="eg-head"><span class="ic"><i class="fas fa-compass"></i></span><h2 id="egTitle">관리자 화면 사용법</h2><p>관리자 화면에서 공통으로 쓰는 기능입니다.</p></div>
			<div class="eg-body">
				<h3>🧭 이렇게 써요</h3>
				<ol class="eg-steps">
					<li><b>메뉴 이동</b><span>왼쪽 메뉴에서 화면을 고릅니다. 내 권한에 있는 메뉴만 보입니다.</span></li>
					<li><b>화면 가이드</b><span>어느 화면이든 오른쪽 아래 <b style="display:inline">?</b> 버튼을 누르면 그 화면 사용법이 나옵니다.</span></li>
					<li><b>바로 수정</b><span>표의 칸을 눌러 바로 고치는 화면이 많습니다. 고친 내용은 자동 저장됩니다.</span></li>
				</ol>
				<h3>✨ 알아두면 좋아요</h3>
				<ul class="eg-tips">
					<li>체크박스는 <kbd class="eg">Shift</kbd>+클릭으로 사이를 한 번에 고를 수 있습니다.</li>
				</ul>
			</div>
		</c:otherwise>
		</c:choose>
		<div class="eg-foot"><kbd class="eg">Esc</kbd> 키나 바깥을 누르면 닫힙니다.</div>
	</div>
</div>

<script>
(function() {
	var bg = document.getElementById('egPanel'), fab = document.getElementById('egOpen');
	function open() { bg.hidden = false; requestAnimationFrame(function() { bg.classList.add('on'); }); document.getElementById('egClose').focus(); }
	function close() { bg.classList.remove('on'); bg.hidden = true; fab.focus(); }
	fab.addEventListener('click', open);
	document.getElementById('egClose').addEventListener('click', close);
	bg.addEventListener('click', function(e) { if (e.target === bg) close(); });
	document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !bg.hidden) close(); });
})();
</script>
