<c:when test="${guidePath eq '/WEB-INF/jsp/bo/staff/staff_list.jsp'}">
EG.page = [
	['.hr-drive-gear', '드라이브 설정', '이 화면에서 구글 드라이브에 올리는 파일의 폴더와 파일 이름 규칙을 정해요. 회사 공통이라 누가 올려도 같은 규칙을 써요.\n{성명} 같은 이름표 버튼을 누르면 칸에 들어가고, 비운 칸은 기본값을 써요. 이미 올린 파일은 그대로예요.'],
