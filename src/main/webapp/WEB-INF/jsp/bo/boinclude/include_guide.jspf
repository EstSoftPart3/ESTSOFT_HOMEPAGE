<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%-- 관리자 화면 가이드 단계. 화면은 JSP 경로로 고른다. 투어 동작은 include_guide_core.jspf.
     시크릿 단계는 시크릿 계정(secretViewer)에게만, 계정 카드 시크릿 탭은 그 탭이 보이는 슈퍼관리자(superUser)에게도 출력한다 --%>
<c:set var="guidePath" value="${pageContext.request.servletPath}"/>
<script>
var EG = { page: [], modals: {} };
<c:choose>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/deploy_list.jsp'}">
EG.page = [
	['#ymBox', '여기서 달을 바꿔요', '◀ ▶ 를 누르거나 달력에서 고르면 그 달에 하루라도 일한 사람만 표에 나와요.\n지난달 투입 내역을 볼 때도 여기서 달만 바꾸면 돼요.'],
	['#btnAdd', '새 투입은 여기!', '누르면 표에 빈 입력 줄이 생겨요. 고객사·프로젝트·기간·단가를 채우고 Enter 를 누르면 저장돼요.\nTab 으로 다음 칸, Esc 로 취소해요.'],
	['#views', '보고 싶은 목록 고르기', '투입 현황: 지금 현장에 나가 있는 사람\n대기 현황: 재직 중인데 투입이 없는 사람(외부업체 제외)\n철수 임박: 이번 달·다음 달에 끝나는 사람\n숫자는 각 목록의 인원이에요.'],
	<c:if test="${secretViewer}">['#secretBox', '시크릿 직원', '시크릿 계정에 연결된 직원은 시크릿 계정에게만 보이고, 다른 관리자 화면·합계·엑셀에서는 아예 빠져요.\n이 칩을 끄면 잠깐 숨길 수 있어요. 화면을 다른 사람과 같이 볼 땐 꺼 두세요.', 1],</c:if>
	['#chks', '눌러서 켜고 끄기', '정규·수습·특고프리·사업자·외부업체 칩을 눌러 켜고 꺼요. 켜 둔 고용형태만 표에 나와요.\n전체 선택/해제 버튼으로 한 번에 바꿀 수 있어요.'],
	['[data-view="timeline"]', '타임라인으로 보기', '표 대신 사람별 투입 기간을 막대 그래프로 보여 줘요.\n누가 언제 끝나고 비는지 한눈에 볼 때 좋아요. 표 버튼을 누르면 돌아와요.'],
	['.dp-bar', '이름으로 찾기', '검색창에 성명·프로젝트·고객사 일부만 쳐도 바로 걸러져요.\n옆 목록으로 고객사·매출처·근무지역·등급을 골라 더 좁힐 수 있어요.'],
	['#dpHead', '머리글로 정렬·순서 바꾸기', '머리글의 ↕ 를 누르면 그 칸 기준으로 정렬돼요.\n머리글을 좌우로 끌면 칸 순서가 바뀌고 내 계정에 저장돼요. 원래대로는 컬럼 순서 초기화.'],
	['#dpBody .dp-name', '이름을 누르면', '그 사람의 투입 상세 팝업이 열려요.\n계약 정보를 고치거나, 지난 프로젝트 이력을 보거나, 철수 후 다음 투입을 등록할 수 있어요.'],
	['#dpBody .pl-btn', '메모 · 수정 이력', '표의 칸은 누르면 그 자리에서 바로 고쳐지고, 누가 언제 무엇을 바꿨는지 ✎ 이력에 자동으로 남아요.\n잘못 고쳤으면 이력에서 되돌리기를 누르세요. 💬 는 메모예요.']
];
EG.modals.detailModal = [
	['#detailFields', '계약 정보', '형태·등급·매출처·매입처·기간·단가를 여기서 고쳐요.\n고친 뒤 아래 저장을 눌러야 표에 반영돼요.'],
	['#histBody', '지난 프로젝트', '이 사람이 지금까지 거쳐 온 투입 이력이에요.\n다음 현장을 고를 때 경력 참고용으로 보세요.'],
	['#detailModal .modal-footer .btn-outline-secondary', '철수하고 다음 현장으로', '지금 투입의 철수일과 다음 투입을 한 번에 등록해요.\n지금 계약 값이 미리 채워져서 바뀐 것만 고치면 돼요.'],
	['#detailModal .modal-footer .btn-primary', '다 고쳤으면 저장', '저장해야 표와 급여 계산에 반영돼요.\n바뀐 내용은 수정 이력에 남아요.'],
	['#detailModal .modal-footer .btn-outline-danger', '잘못 넣은 투입만 삭제', '실수로 넣은 투입 건을 지워요. 지우면 되돌릴 수 없어요.\n끝난 투입은 지우지 말고 철수일만 넣으세요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/pay_list.jsp'}">
EG.page = [
	['#ym', '급여 달 고르기', '◀ ▶ 로 급여를 계산할 달을 바꿔요.\n그 달의 투입·단가·상여가 자동으로 계산돼서 표에 나와요.'],
	['#payDt', '지급일 넣기', '이번 달 급여를 실제로 주는 날짜예요.\n엑셀과 마감 기록에 같이 남아요.'],
	['#btnImport', '공제는 엑셀로 한 번에', '급여대장·사업소득대장 엑셀(.xls)을 올리면 사번·코드로 직원을 찾아 공제 금액만 채워 줘요.\n지급액은 덮어쓰지 않고 맞는지 대조만 해요.'],
	['#kpis', '이번 달 요약', '인원·지급 합계·손익 같은 숫자를 한눈에 보여 줘요.\n아래 표에서 켜 둔 구분 기준으로 계산돼요.'],
	['#chks', '눌러서 켜고 끄기', '고용형태 칩을 켜고 꺼서 보고 싶은 사람만 표에 남겨요.\n확인 사항 칩을 켜면 확인이 필요한 사람만 모아 볼 수 있어요.'],
	<c:if test="${secretViewer}">['#chks .pl-chip.secret', '시크릿 직원', '시크릿 직원의 급여는 시크릿 계정에게만 보이고, 다른 관리자에게는 행·합계·엑셀에서 모두 빠져요.\n칩을 끄면 잠깐 숨기고, 위 합계도 그만큼 빠져요.', 1],</c:if>
	['[data-t="show-allow"]', '칸 펼치기', '수당·공제·손익 칸은 평소엔 접혀 있어요. 같은 색 버튼이나 머리글의 색 띠를 누르면 자세한 칸이 펼쳐져요.\n다시 누르면 접혀요.'],
	['#lBody .dp-name', '이름을 누르면', '직원 상세 팝업이 열려서 투입·계약 정보를 같이 볼 수 있어요.\n금액이 왜 이렇게 나왔는지 확인할 때 써요.'],
	['#lBody .pl-btn', '메모 · 수정 이력', '금액 칸은 눌러서 바로 고칠 수 있고, 고친 칸은 노란색으로 표시돼요.\n누가 언제 바꿨는지 ✎ 이력에 남고, 거기서 되돌릴 수 있어요.'],
	['#btnClose', '다 확인했으면 마감', '마감하면 이 달 금액이 고정돼서 더 이상 바뀌지 않아요.\n마감을 풀 때는 사유를 적어야 하고, 이력에 남아요.']
];
EG.modals.detailModal = [
	['#detailTabs', '보고 싶은 정보 고르기', '탭을 눌러 투입·계약·급여 정보를 바꿔 봐요.'],
	['#detailBody', '직원 상세', '이 사람의 투입 기간·단가·계약 내용이에요.\n급여 금액이 이상하면 여기서 원인을 찾아보세요.']
];
EG.modals.importModal = [
	['#importFiles', '엑셀 파일 고르기', '급여대장과 사업소득대장 파일(.xls)을 함께 골라요. 여러 개를 한 번에 고를 수 있어요.'],
	['#importResult', '미리 보기', '누가 어떤 직원으로 연결됐는지, 금액이 맞는지 먼저 보여 줘요.\n연결 안 된 사람이 있으면 사번·코드를 확인하세요.'],
	['#btnApply', '반영', '미리 보기가 맞으면 눌러요. 공제 금액만 들어가고 지급액은 그대로예요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/bonus_list.jsp'}">
EG.page = [
	['#btnNew', '상여 항목 만들기', '만근 상여·추천 상여 같은 지급 조건을 새로 만들어요.\n여기선 조건만 정하고, 누구에게 줄지는 직원관리에서 사람별로 켜요.'],
	['#bList', '상여 목록', '기준일, 몇 개월에 얼마를 주는지, 받는 사람(본인/추천인)이 보여요.\n줄의 수정 버튼으로 조건을 고쳐요.'],
	['#bList .btn-link', '적용 인원', '이 상여가 켜진 직원 수예요. 누르면 누구인지 보여요.\n켜고 끄는 건 직원관리 목록의 상여 칩에서 해요.']
];
EG.modals.bModal = [
	['#bNm', '상여 이름', '급여관리 상여 칸과 직원관리 칩에 이 이름으로 나와요.'],
	['#bTarget', '받는 사람', '본인: 조건을 채운 직원이 받아요.\n추천인: 그 직원을 추천한 사람이 받아요(기준일은 추천한 인재 것).'],
	['#bBase', '기준일', '몇 개월을 셀 때 시작하는 날이에요. 입사일 또는 계약(투입) 시작일 중에서 골라요.'],
	['#bSteps', '단계별 금액', '기준일부터 몇 개월을 채우면 얼마를 줄지 단계로 적어요. 0 개월은 계약할 때 바로 주는 금액이에요.\n만근 조건은 하루도 빠짐없이 근무해야 해요.'],
	['#btnStep', '단계 추가', '3개월·6개월처럼 여러 번 나눠 줄 때 단계를 더해요.'],
	['#bModal .modal-footer .btn-primary', '저장', '다음 급여 계산부터 적용돼요. 이미 마감된 달은 바뀌지 않아요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/partner_list.jsp'}">
EG.page = [
	['[onclick="openForm(null);"]', '거래처 등록', '투입현황에서 고르는 매출처(우리가 돈을 받는 곳)·매입처(우리가 돈을 주는 곳)를 새로 넣어요.'],
	['#tabs', '구분별로 보기', '전체·매출처·매입처·사용 중지 탭으로 나눠 봐요.\n숫자는 각 구분의 거래처 수예요.'],
	['#keyword', '찾기', '거래처명·사업자번호·담당자 일부만 쳐도 바로 걸러져요.'],
	['#body .dp-name', '이름을 누르면', '거래처 정보를 보고 고칠 수 있어요.\n투입 기록이 있는 거래처는 지울 수 없고, 사용 중지로 바꾸면 새 입력 목록에서만 빠져요.']
];
EG.modals.formModal = [
	['#drop', '서류 올리기', '사업자등록증·통장 사본 같은 파일을 여기로 끌어다 놓거나 눌러서 골라요.\n올린 서류는 아래 칩으로 보여요.'],
	['#bizFields', '사업자 정보', '상호·사업자번호·대표자·주소를 넣어요. 상호는 꼭 넣어야 해요.'],
	['#typeField', '매출처 / 매입처', '이 거래처가 어느 쪽인지 골라요. 둘 다 체크할 수도 있어요.\n체크한 쪽 목록에만 나와요.'],
	['#formModal .modal-footer .btn-primary', '저장', '저장하면 투입현황의 매출처·매입처 선택 목록에 바로 나와요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/staff/staff_list.jsp'}">
EG.page = [
	['#keyword', '이름으로 찾기', '성명·연락처·메일·부서·메모 어느 것이든 일부만 쳐도 바로 걸러져요.\n옆 목록으로 소속·부서·직급, 정렬 순서도 바꿀 수 있어요.'],
	['[onclick="openNew();"]', '직원 등록', '새로 들어온 직원을 넣어요. 이름과 기본 정보만 넣고 등록하면 인사카드가 바로 열려서 나머지를 채울 수 있어요.'],
	['#tabs', '재직 상태별로', '재직·대기·퇴사 탭으로 나눠 봐요.\n숫자는 각 상태의 인원이에요.'],
	['#orgSeg', '소속 빠르게 고르기', '정규직·프리처럼 소속을 한 번에 골라요. 전체를 누르면 다시 다 보여요.'],
	['#listBody .st-name', '이름을 누르면', '인사카드가 열려요. 개인정보·계좌·학력·자격·서류·프로젝트 이력을 탭별로 보고 고쳐요.'],
	['#listBody', '칸을 누르면 바로 수정', '표의 칸을 누르면 그 자리에서 고쳐져요.\n칸 위에 마우스를 올리고 Ctrl+C 를 누르면 그 칸 값만 복사돼요. 가려진 주민번호·계좌번호도 원문으로 복사돼요.']
];
EG.modals.cardModal = [
	['#cardBody [role="tablist"]', '탭으로 정보 고르기', '탭을 눌러 기본정보·학력·자격·서류·프로젝트 이력 등을 바꿔 봐요.'],
	['#cardBody', '수정 버튼으로 고치기', '각 묶음 오른쪽 수정 버튼을 눌러 고쳐요.\n주민번호·계좌번호는 가려져 있고, 눈 모양을 눌러야 원문이 보여요. 서류는 구글 드라이브에 저장돼요.'],
	['#btnStatus', '재직 상태 바꾸기', '퇴사로 옮기거나 재직으로 되돌려요. 퇴사로 옮기면 퇴사 탭으로 가요.'],
	['#cardModal .modal-footer .btn-outline-danger', '삭제', '잘못 등록한 직원만 지워요. 지우면 되돌릴 수 없어요.\n그만둔 직원은 지우지 말고 퇴사로 옮기세요.']
];
EG.modals.newModal = [
	['#newFields', '기본 정보 입력', '성명은 꼭 넣고, 재직 상태·소속·부서는 아는 만큼 넣어요. 나머지는 인사카드에서 채워도 돼요.'],
	['#newModal .modal-footer .btn-primary', '등록', '등록하면 인사카드가 이어서 열려요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/member/member_list.jsp'}">
EG.page = [
	['#alerts', '확인할 일', '퇴사한 직원의 계정이 아직 살아 있는 것처럼 정리가 필요한 계정을 알려 줘요.\n누르면 그 계정만 모아 보여요.'],
	['#keyword', '찾기', '이름·아이디·이메일 일부만 쳐도 걸러져요.\n옆 비밀번호 목록에서 초기 비밀번호를 고르면 아직 비밀번호를 안 바꾼 사람만 보여요.'],
	['[onclick="openIssue();"]', '계정 발급', '재직자를 골라 로그인 계정을 만들어요. 여러 명을 한 번에 발급할 수 있어요.\n초기 비밀번호는 발급 직후 한 번만 보여 줘요.'],
	['#tabs', '계정 구분', '전체·직원·관리자 등으로 나눠 봐요. 체크하면 위에 일괄 사용중지·퇴사·삭제 버튼이 나와요.'],
	['#listBody .ac-link', '이름을 누르면', '계정 카드가 열려요. 연결 직원, 권한, 비밀번호 재발급을 여기서 해요.'],
