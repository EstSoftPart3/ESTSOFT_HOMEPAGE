EG.modals.cardModal = [
	['#cardBody > ul', '탭으로 정보 고르기', '기초정보, 학력/교육, 영업정보, 수행이력, 서류, 메모, 보유 장비 탭이 있어요.\n탭 이름 뒤 숫자는 건수이고, 서류 탭에는 미제출 건수가 보여요.'],
	['#cardBody > ul', '수행이력 탭', '프로젝트 이력을 표로 보고 고쳐요. 투입현황에 등록된 건은 「사내 투입 연동」 으로 자동으로 나와요.\n고친 내용은 「새 버전으로 저장」 을 눌러야 버전으로 남고, 바뀐 게 없으면 버전이 올라가지 않아요.\n「✨ 프로필 자동생성」 은 필수 기술·연차 등을 골라 제출용 가필 버전을 만들어요(순정은 그대로).\n「워드 받기」 는 순정 최신·가필 최신·고른 버전 중 골라 회사 양식 이력카드를 만들어 줘요. 기술 스택 종합은 영업정보 탭에 자동으로 모여요.'],
	<c:if test="${secretViewer or superUser}">['#cardBody > ul', '🔒 시크릿 탭', '맨 끝 시크릿 탭에서 이 직원을 시크릿으로 켜고 꺼요. 켜면 직원관리·투입현황·급여관리에서 시크릿 계정에게만 보여요.\n로그인 계정이 없는 직원도 켤 수 있고, 누르는 즉시 저장돼요.', 1],</c:if>
	['#cardBody', '수정 버튼으로 고치기', '각 묶음 오른쪽 수정 버튼을 눌러 고쳐요.\n주민번호·계좌번호는 가려져 있고, 눈 모양을 눌러야 원문이 보여요. 서류는 구글 드라이브에 저장돼요.'],
	['#btnStatus', '재직 상태 바꾸기', '퇴사로 옮기거나 재직으로 되돌려요. 옆 버튼으로 대기로도 옮길 수 있어요.'],
	['#cardModal .modal-footer .btn-outline-danger', '삭제', '잘못 등록한 직원만 지워요. 지우면 되돌릴 수 없어요.\n그만둔 직원은 지우지 말고 퇴사로 옮기세요.']
];
