<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%-- 관리자 화면 가이드 단계. 화면은 JSP 경로로 고른다. 투어 동작은 include_guide_core.jspf.
     시크릿 단계는 시크릿 계정(secretViewer)에게만, 시크릿 탭(계정 카드·인사카드)은 그 탭이 보이는 슈퍼관리자(superUser)에게도 출력한다.
     화면의 버튼·칸·팝업을 바꾸면 여기 단계도 같이 고친다(대상이 없어진 단계는 조용히 건너뛰어져서 눈에 안 띈다) --%>
<c:set var="guidePath" value="${pageContext.request.servletPath}"/>
<script>
var EG = { page: [], modals: {} };
<c:choose>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/home/home.jsp'}">
EG.page = [
	['aside a.bo-home', '관리자 홈', '로그인하거나 왼쪽 메뉴의 홈을 누르면 이 화면이 열려요.\n내가 권한을 가진 메뉴의 카드만 보이고, 열 때 한 번 불러와요(새로고침으로 다시 불러와요).'],
	['#hmKpis', '숫자 한눈에 보기', '재직·투입 중·대기·이번 주 면접·교육 진행 인원이에요.\n숫자 칸을 누르면 그 화면이 해당 탭으로 열려요(대기 → 투입현황 대기 현황).'],
	['#hmTodoCard', '오늘 확인할 일', '급여 확인 필요, 철수 임박, 수습 해제, 내 결재 차례, 장비·계정 정리할 것을 모아 보여 줘요.\n0건인 항목은 숨겨지고, 줄 끝 › 를 누르면 그 화면의 그 목록으로 가요.'],
	['#hmCards .hm-link', '이름·번호를 누르면 바로가기', '파란 굵은 글씨는 그 사람·장비·면접자 상세로 바로 가요(직원은 인사카드, 면접자는 상세 창).\n바로가기는 위쪽 화면 탭으로 열려서 대시보드는 그대로 남아 있어요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/deploy_list.jsp'}">
EG.page = [
	['#ymBox', '여기서 달을 바꿔요', '◀ ▶ 를 누르거나 달력에서 고르면 그 달에 하루라도 일한 사람만 표에 나와요.\n지난달 투입 내역을 볼 때도 여기서 달만 바꾸면 돼요.'],
	['#btnAdd', '새 투입은 여기!', '누르면 표에 빈 입력 줄이 생겨요. 고객사·프로젝트·기간·단가를 채우고 Enter 를 누르면 저장돼요.\nTab 으로 다음 칸, Esc 로 취소해요.'],
	['#views', '보고 싶은 목록 고르기', '투입 현황: 지금 현장에 나가 있는 사람\n대기 현황: 재직 중인데 투입이 없는 사람(외부업체 제외)\n철수 임박: 이번 달·다음 달에 끝나는 사람\n내근직: 투입 상세 팝업에서 내근직을 켠 사람(다른 목록에서는 빠져요)\n숫자는 각 목록의 인원이에요. 투입 상세 팝업의 철수 처리를 누르면 철수일이 들어가고 대기 현황으로 옮겨져요.'],
	<c:if test="${secretViewer}">['#secretBox', '시크릿 직원', '시크릿 직원은 시크릿 계정에게만 보이고, 다른 관리자 화면·합계·엑셀에서는 아예 빠져요.\n이 칩을 끄면 잠깐 숨길 수 있어요. 화면을 다른 사람과 같이 볼 땐 꺼 두세요.', 1],</c:if>
	['#chks', '눌러서 켜고 끄기', '고용형태 칩을 눌러 켜고 꺼요. 켜 둔 형태만 표에 나와요. 칩 이름과 순서는 공통코드에서 정해요.\n전체 선택/해제 버튼으로 한 번에 바꿀 수 있어요.'],
	['[data-view="timeline"]', '타임라인으로 보기', '표 대신 사람별 투입 기간을 막대 그래프로 보여 줘요.\n누가 언제 끝나고 비는지 한눈에 볼 때 좋아요. 표 버튼을 누르면 돌아와요.'],
	['.dp-bar', '이름으로 찾기', '검색창에 성명·프로젝트·고객사 일부만 쳐도 바로 걸러져요.\n옆 목록으로 고객사·매출처·근무지역·등급을 골라 더 좁힐 수 있어요.'],
	['#dpHead', '머리글로 정렬·순서 바꾸기', '머리글의 ↕ 를 누르면 그 칸 기준으로 정렬돼요.\n머리글을 좌우로 끌면 칸 순서가 바뀌고 내 계정에 저장돼요. 원래대로는 컬럼 순서 초기화.'],
	['#dpHead th[data-c="SALE_PRICE"]', '매출단가 · 계약단가', '연두색이 매출단가(받는 돈), 주황색이 계약단가(주는 돈)예요.\n그 달에 일부만 근무하면 월 금액에 줄이 그어지고 일할 금액이 같이 보여요. 🤝 는 고객사 직접계약이고, 눌러서 넣거나 고쳐요.'],
	['#dpBody .pl-dup-arrow', '같은 달 다른 계약', '이름 앞 ▸ 는 같은 달에 계약이 더 있다는 표시예요. 누르면 └ 줄로 펼쳐져요.\n수습과 정규는 한 줄로 합쳐서 정규(수습 D-n)로 보여요.'],
	['#dpBody .dp-name', '이름을 누르면', '그 사람의 투입 상세 팝업이 열려요.\n계약 정보를 고치거나, 지난 프로젝트 이력을 보거나, 철수 후 다음 투입을 등록할 수 있어요.'],
	['#dpBody .pl-btn', '메모 · 수정 이력', '표의 칸은 누르면 그 자리에서 바로 고쳐지고, 누가 언제 무엇을 바꿨는지 ✎ 이력에 자동으로 남아요.\n잘못 고쳤으면 이력에서 되돌리기를 누르세요. 💬 는 메모예요.']
];
EG.modals.detailModal = [
	['#detailFields', '계약 정보', '형태·등급·매출처·매입처·기간·단가를 여기서 고쳐요.\n고친 뒤 아래 저장을 눌러야 표에 반영돼요.'],
	['#histBody', '지난 프로젝트', '이 사람이 지금까지 거쳐 온 투입 이력이에요.\n다음 현장을 고를 때 경력 참고용으로 보세요.'],
	['#detailModal .modal-footer .btn-outline-secondary', '철수하고 다음 현장으로', '지금 투입의 철수일과 다음 투입을 한 번에 등록해요.\n지금 계약 값이 미리 채워져서 바뀐 것만 고치면 돼요.'],
	['#detailModal .modal-footer .btn-primary', '다 고쳤으면 저장', '저장해야 표와 급여 계산에 반영돼요.\n바뀐 내용은 수정 이력에 남아요.'],
	['#detailModal .modal-footer .btn-outline-danger', '잘못 넣은 투입만 삭제', '실수로 넣은 투입 건을 지워요. 지우면 되돌릴 수 없어요.\n끝난 투입은 지우지 말고 철수일만 넣으세요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/pay_list.jsp'}">
EG.page = [
	['#ym', '급여 달 고르기', '◀ ▶ 로 급여를 계산할 달을 바꿔요.\n그 달의 투입·단가·상여가 자동으로 계산돼서 표에 나와요.'],
	['#payDt', '지급일 넣기', '이번 달 급여를 실제로 주는 날짜예요. 기본은 다음 달 15일이에요.\n급여명세서와 마감 기록에 같이 남아요.'],
	['#btnImport', '공제는 엑셀로 한 번에', '급여대장·사업소득대장 엑셀(.xls)을 올리면 사번·코드로 직원을 찾아 공제 금액만 채워 줘요.\n지급액은 덮어쓰지 않고 맞는지 대조만 해요.'],
	['#kpis', '이번 달 요약', '인원·지급 합계·손익 같은 숫자를 한눈에 보여 줘요. 다른 계약(매입) 합계는 따로 나와요.\n아래 표에서 켜 둔 구분 기준으로 계산돼요.'],
	['#chks', '눌러서 켜고 끄기', '고용형태 칩을 켜고 꺼서 보고 싶은 사람만 표에 남겨요.\n확인 사항 칩을 켜면 확인이 필요한 사람만 모아 볼 수 있어요.'],
	<c:if test="${secretViewer}">['#chks .pl-chip.secret', '시크릿 직원', '시크릿 직원의 급여는 시크릿 계정에게만 보이고, 다른 관리자에게는 행·합계·엑셀에서 모두 빠져요.\n칩을 끄면 잠깐 숨기고, 위 합계도 그만큼 빠져요.', 1],</c:if>
	['[data-t="show-allow"]', '칸 펼치기', '수당·공제·손익 칸은 평소엔 접혀 있어요. 같은 색 버튼이나 머리글의 색 띠를 누르면 자세한 칸이 펼쳐져요.\n다시 누르면 접혀요.'],
	['#lHead .pl-calc-btn', '🧮 자동 계산 칸', '머리글에 🧮 가 있는 칸은 자동으로 계산돼요. 🧮 에 마우스를 올리면 계산식이 보이고, 누르면 수습급여·식대 같은 계산 기준값을 고칠 수 있어요.\n기준값을 바꾸면 마감 안 된 달만 다시 계산돼요.'],
	['#pickAll', '줄 체크', '체크한 사람의 줄이 파란 테두리로 표시돼요. 여러 명을 눈으로 비교할 때 써요.\n보기용이라 저장되지 않고, 달을 바꾸면 풀려요.'],
	['#lBody .pl-dup-arrow', '같은 달 다른 계약', '이름 앞 ▸ 를 누르면 그 사람의 다른 계약 줄이 펼쳐져요.\n다른 계약(기타·외부)은 매입처에 주는 돈이라 우리 급여와 급여명세서에는 들어가지 않아요.'],
	['#lBody .dp-name', '이름을 누르면', '직원 상세 팝업이 열려서 투입·계약 정보를 같이 볼 수 있어요.\n금액이 왜 이렇게 나왔는지 확인할 때 써요.'],
	['#lBody .pl-btn', '메모 · 수정 이력', '점선 밑줄이 있는 칸은 눌러서 바로 고칠 수 있어요. 형태·고객사·근무기간·매출단가는 투입현황에서 고쳐요.\n누가 언제 바꿨는지 ✎ 이력에 남고, 거기서 되돌릴 수 있어요.'],
	['#btnClose', '다 확인했으면 마감', '마감하면 이 달 금액이 고정돼서 더 이상 바뀌지 않아요. 마감해야 급여명세서를 보낼 수 있어요.\n마감을 풀 때는 사유를 적어야 하고, 이력에 남아요.']
];
EG.modals.detailModal = [
	['#detailTabs', '보고 싶은 정보 고르기', '탭을 눌러 투입·계약·급여 정보를 바꿔 봐요.'],
	['#detailBody', '직원 상세', '이 사람의 투입 기간·단가·계약 내용이에요.\n급여 금액이 이상하면 여기서 원인을 찾아보세요.']
];
EG.modals.importModal = [
	['#importFiles', '엑셀 파일 고르기', '급여대장과 사업소득대장 파일(.xls)을 함께 골라요. 여러 개를 한 번에 고를 수 있어요.'],
	['#importResult', '미리 보기', '누가 어떤 직원으로 연결됐는지, 금액이 맞는지 먼저 보여 줘요.\n연결 안 된 사람이 있으면 사번·코드를 확인하세요.'],
	['#btnApply', '반영', '미리 보기가 맞으면 눌러요. 공제 금액만 들어가고 지급액은 그대로예요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/trade_all.jsp'}">
EG.page = [
	['#ym', '여기서 달을 바꿔요', '◀ ▶ 를 누르거나 달력에서 고르면 그 달의 투입·매출·매입·급여가 한 번에 나와요.'],
	['#kpis', '이번 달 한눈에', '매출·매입·급여·영업이익과 투입 인원, 철수 예정, 세금계산서 발급 현황이에요.\n아래에서 보기나 칩을 바꾸면 숫자도 같이 바뀌어요.'],
	['#views', '보고 싶은 것만 골라요', '전체·투입 중·철수 예정·대기·내근직·일반 건으로 줄을 걸러요.\n「거래처별」을 누르면 거래처 한 줄에 매출·매입·차액이 나란히 나와요.'],
	['#chks', '눌러서 켜고 끄기', '고용형태와 일반 건, 확인 필요 칩으로 보고 싶은 줄만 남겨요.\n맨 앞 버튼으로 한 번에 전체 선택·해제해요.'],
	['#taHead', '색 띠를 누르면 접혀요', '투입·매출·매입·급여·손익 색 띠를 누르면 그 묶음이 접히고 대표 칸 하나만 남아요.\n「모두 펴기 / 모두 접기」 버튼도 있고, 접은 상태는 이 브라우저에 기억돼요.'],
	['#taBody', '한 줄에 다 보여요', '사람 한 줄에 투입 → 매출 → 매입 → 급여 → 손익이 이어져요.\n점선 밑줄 금액은 눌러서 바로 고치고, 성명을 누르면 투입 상세와 급여 명세가 팝업으로 열려요.\n투입현황·급여관리와 같은 데이터라 어느 쪽에서 고쳐도 똑같이 바뀌어요.'],
	['#btnSale', '투입 말고 다른 매출·매입', '임대료·장비·용역처럼 투입에서 자동으로 나오지 않는 건은 「일반 매출」「일반 매입」으로 직접 넣어요.'],
	['#btnClosePay', '마감은 두 가지', '급여 마감과 매출·매입 마감이 따로예요.\n매출·매입을 마감하면 일반 건과 금액을 고칠 수 없고, 세금계산서 묶기·발급 표시는 계속 돼요.']
];
EG.modals.formModal = [
	['#PARTNER_SQ', '거래처 고르기', '등록된 거래처를 골라요.\n목록에 없으면 맨 아래 「직접 입력」을 고르고 이름을 적어요.'],
	['#AMT', '공급가액', '부가세를 뺀 금액을 적어요. 세액과 합계금액은 옆 칸에 자동으로 나와요.'],
	['#REPEAT_ON', '매달 반복', '임대료처럼 매달 같은 건은 체크하고 「언제까지」 달을 골라요.\n비워 두면 끌 때까지 매달 만들어요. 그 달 건을 지우면 반복도 그 달부터 멈춰요.']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/trade_list.jsp' and invoiceOnly}">
EG.page = [
	['#ym', '여기서 달을 바꿔요', '◀ ▶ 를 누르거나 달력에서 고르면 그 달의 매출 건만 나와요.\n세금계산서는 지난달 것을 끊으니까 처음에는 지난달이 열려 있어요.'],
	['#btnExcel', '엑셀로 내려받기', '지금 고른 달을 계산서 엑셀과 같은 칸 배치로 내려받아요.\n묶어 둔 대로 묶음마다 공급가액·세액·합계금액이 붙어 나와요.'],
	['#chips', '미발급·발급 완료', '칩을 꺼서 아직 발급하지 않은 계산서만, 또는 발급한 계산서만 볼 수 있어요.'],
	['#invBody', '계산서 묶기', '매출 건을 거래처별로 몇 행씩 묶는 곳이에요. 정렬과 「한 장에 몇 행」을 정해 「다시 묶기」를 누르고, 행을 끌거나 나누기·합치기로 장마다 행 수를 바꿔요.\n값 옆의 작은 복사 버튼은 그 값만, 「전체 복사」는 보이는 계산서를 한 번에 복사해요.\n건을 넣거나 금액을 고치는 일은 「매출·매입 현황」에서 해요.']
