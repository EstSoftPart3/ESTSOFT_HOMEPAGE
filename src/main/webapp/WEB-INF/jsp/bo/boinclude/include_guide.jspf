	['#detailBody', '직원 상세', '투입 · 계약 내용을 같이 봐요']
];
EG.modals.importModal = [
	['#importFiles', '엑셀 파일 고르기', '급여대장 · 사업소득대장을 같이 골라요'],
	['#importResult', '미리 보기', '누가 연결됐는지 확인해요'],
	['#btnApply', '반영', '공제 금액만 들어가요']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/bonus_list.jsp'}">
