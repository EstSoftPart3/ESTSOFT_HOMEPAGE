<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%-- 화면 가이드 투어: 우측 하단 ? → 화면을 어둡게 하고 실제 버튼·칸을 하나씩 밝혀 화살표와 말풍선으로 설명.
     열린 팝업이 있으면 그 팝업 설명. 단계 = [대상 선택자, 제목, 한 줄, 시크릿]. 대상이 화면에 없으면 그 단계는 건너뜀.
     시크릿 단계는 시크릿 계정(secretViewer)일 때만 출력한다 --%>
<c:set var="guidePath" value="${pageContext.request.servletPath}"/>
<link href="https://fonts.googleapis.com/css2?family=Gaegu:wght@700&display=swap" rel="stylesheet">
<style>
	.eg-fab { position: fixed; right: 22px; bottom: 22px; z-index: 1060; width: 52px; height: 52px; border: 0; border-radius: 50%; background: rgba(37, 99, 235, .55); color: #fff;
		font-size: 22px; font-weight: 700; cursor: pointer; box-shadow: 0 6px 20px rgba(37, 99, 235, .3); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); transition: background .2s, transform .2s; }
	.eg-fab:hover, .eg-fab:focus-visible { background: rgba(37, 99, 235, .95); transform: translateY(-2px); outline: none; }
	.eg-fab::after { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 2px solid rgba(37, 99, 235, .45); animation: eg-ping 2.2s infinite; pointer-events: none; }
	@keyframes eg-ping { 0% { transform: scale(.9); opacity: 1 } 100% { transform: scale(1.35); opacity: 0 } }
	.eg-tour { position: fixed; inset: 0; z-index: 1080; }
	.eg-tour[hidden] { display: none; }
	.eg-hole { position: fixed; border-radius: 10px; box-shadow: 0 0 0 9999px rgba(15, 23, 42, .62); transition: all .45s cubic-bezier(.65, 0, .35, 1); pointer-events: none; }
	.eg-hole::after { content: ''; position: absolute; inset: -4px; border: 3px solid #fde047; border-radius: 12px; animation: eg-glow 1.4s ease-in-out infinite; }
	@keyframes eg-glow { 50% { box-shadow: 0 0 18px 4px rgba(253, 224, 71, .7) } }
	.eg-arrow { position: fixed; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
	.eg-arrow path { fill: none; stroke: #fde047; stroke-width: 3.5; stroke-linecap: round; }
	.eg-arrow path.draw { stroke-dasharray: var(--len); stroke-dashoffset: var(--len); animation: eg-draw .5s .35s ease-out forwards; }
	@keyframes eg-draw { to { stroke-dashoffset: 0 } }
	.eg-bubble { position: fixed; width: 300px; font-family: 'Gaegu', 'Malgun Gothic', cursive; color: #fff; opacity: 0; transform: translateY(8px) rotate(-1.5deg); pointer-events: none; }
	.eg-bubble.show { animation: eg-pop .4s .65s ease-out forwards; }
	@keyframes eg-pop { to { opacity: 1; transform: none } }
	.eg-bubble b { display: block; font-size: 30px; line-height: 1.1; color: #fde047; text-shadow: 0 2px 8px rgba(0, 0, 0, .45); }
	.eg-bubble span { display: block; font-size: 22px; line-height: 1.3; margin-top: 4px; text-shadow: 0 2px 8px rgba(0, 0, 0, .55); }
	.eg-bubble.sec b { color: #c4b5fd; }
	.eg-ctrl { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%); display: flex; align-items: center; gap: 14px; background: rgba(255, 255, 255, .97); border-radius: 30px;
		padding: 8px 10px 8px 18px; box-shadow: 0 8px 30px rgba(0, 0, 0, .3); font-size: 13px; white-space: nowrap; }
	.eg-dots { display: flex; gap: 6px; }
	.eg-dots i { width: 8px; height: 8px; border-radius: 50%; background: #cbd5e1; transition: .3s; }
	.eg-dots i.on { background: #2563eb; width: 22px; border-radius: 4px; }
	.eg-dots i.sec { background: #c4b5fd; } .eg-dots i.sec.on { background: #4338ca; }
	.eg-ctrl button { border: 0; border-radius: 20px; padding: 7px 14px; cursor: pointer; font-size: 13px; }
	.eg-ctrl .skip { background: none; color: #64748b; } .eg-ctrl .prev { background: #e2e8f0; color: #334155; } .eg-ctrl .next { background: #2563eb; color: #fff; font-weight: 700; }
	.eg-ctrl .what { color: #64748b; font-size: 12px; }
	@media (max-width: 576px) { .eg-bubble { width: 230px; } .eg-bubble b { font-size: 24px; } .eg-bubble span { font-size: 18px; } .eg-ctrl .what { display: none; } }
	@media (prefers-reduced-motion: reduce) { .eg-hole, .eg-fab::after { transition: none; animation: none; } .eg-arrow path.draw, .eg-bubble.show { animation-duration: .01s; animation-delay: 0s; } }
</style>

<button type="button" class="eg-fab" id="egOpen" aria-label="화면 가이드" title="화면 가이드">?</button>

<div class="eg-tour" id="egTour" role="dialog" aria-modal="true" aria-label="화면 가이드" hidden>
	<div class="eg-hole" id="egHole"></div>
	<svg class="eg-arrow" aria-hidden="true"><defs><marker id="egHead" markerWidth="10" markerHeight="10" refX="6" refY="5" orient="auto"><path d="M0,0 L8,5 L0,10" style="fill:none;stroke:#fde047;stroke-width:2.5"/></marker></defs><path id="egPath" marker-end="url(#egHead)"/></svg>
	<div class="eg-bubble" id="egBubble" aria-live="polite"><b></b><span></span></div>
	<div class="eg-ctrl"><span class="what" id="egWhat"></span><div class="eg-dots" id="egDots"></div><button type="button" class="skip" id="egSkip">그만 보기</button><button type="button" class="prev" id="egPrev">이전</button><button type="button" class="next" id="egNext">다음</button></div>
</div>

<script>
var EG = { page: [], modals: {} };
<c:choose>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/deploy_list.jsp'}">
EG.page = [
	['#ymBox', '여기서 달을 바꿔요', '그 달에 일한 사람만 보여요'],
	['#btnAdd', '새 투입은 여기!', '입력 줄이 생겨요. Enter 로 저장'],
	['#views', '보고 싶은 목록 고르기', '일하는 중 · 쉬는 사람 · 곧 끝나는 사람'],
	<c:if test="${secretViewer}">['#secretBox', '시크릿 직원', '끄면 잠깐 숨겨요. 시크릿 계정에만 보여요', 1],</c:if>
	['#chks', '눌러서 켜고 끄기', '켜 둔 고용형태만 표에 나와요'],
	['[data-view="timeline"]', '타임라인으로 보기', '기간을 막대 그래프로 봐요'],
	['.dp-bar', '이름으로 찾기', '고객사 · 지역 · 등급으로도 좁혀요'],
	['#dpHead', '머리글을 끌어서 순서 바꾸기', '내 계정에 저장돼요'],
	['#dpBody .dp-name', '이름을 누르면', '투입 상세 팝업이 열려요'],
	['#dpBody .pl-btn', '메모 · 수정 이력', '칸을 고치면 자동으로 남고, 여기서 되돌려요']
];
EG.modals.detailModal = [
	['#detailFields', '계약 정보', '칸을 고치고 저장을 눌러요'],
	['#histBody', '지난 프로젝트', '이 사람이 거쳐 온 투입 이력'],
	['#detailModal .modal-footer .btn-outline-secondary', '철수하고 다음 현장으로', '끝나는 날과 새 투입을 한 번에'],
	['#detailModal .modal-footer .btn-primary', '다 고쳤으면 저장', '저장해야 표에 반영돼요'],
	['#detailModal .modal-footer .btn-outline-danger', '잘못 넣은 투입만 삭제', '지우면 되돌릴 수 없어요']
];
</c:when>
<c:when test="${guidePath eq '/WEB-INF/jsp/bo/deploy/pay_list.jsp'}">
EG.page = [
	['#ym', '급여 달 고르기', '◀ ▶ 로 달을 바꿔요'],
	['#payDt', '지급일 넣기', '이번 달 급여 주는 날'],
	['#btnImport', '공제는 엑셀로 한 번에', '급여대장 파일을 올리면 자동으로 들어가요'],
	['#kpis', '이번 달 요약', '인원과 합계를 한눈에'],
	['#chks', '눌러서 켜고 끄기', '보고 싶은 구분만 표에 나와요'],
	<c:if test="${secretViewer}">['#chks .pl-chip.secret', '시크릿 직원', '끄면 잠깐 숨겨요. 합계에서도 빠져요', 1],</c:if>
	['[data-t="show-allow"]', '칸 펼치기', '수당 · 공제 · 손익 칸을 열어 봐요'],
	['#lBody .dp-name', '이름을 누르면', '직원 상세 팝업이 열려요'],
	['#lBody .pl-btn', '메모 · 수정 이력', '칸을 고치면 남고, 여기서 되돌려요'],
	['#btnClose', '다 확인했으면 마감', '마감을 풀 땐 사유를 남겨요']
