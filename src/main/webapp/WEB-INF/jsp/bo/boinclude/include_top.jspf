	<script type="text/javascript" src="/resources/navereditor/js/SE2B_Configuration_Service.js" charset="utf-8"></script>	<!-- 설정 파일 -->
	<script type="text/javascript" src="/resources/navereditor/js/SE2B_Configuration_General.js" charset="utf-8"></script>	<!-- 설정 파일 -->
	<script type="text/javascript" src="/resources/navereditor/js/SE2BasicCreator.js" charset="utf-8"></script>
	
	<script src='/resources/navereditor/js/smarteditor2.min.js' charset='utf-8'></script>
	<script src='/resources/navereditor/photo_uploader/plugin/hp_SE2M_AttachQuickPhoto.js' charset='utf-8'></script>
  
</head>

<script type="text/javascript">

	function logout() {
		if (!confirm("로그아웃 하시겠습니까?")) {
	        return false;
	    } else {
	    	location.href='/admin/logout.do';
	    }
	}

</script>