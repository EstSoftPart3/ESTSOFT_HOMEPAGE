<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>주식회사 이에스티소프트</title>
  <!-- Tell the browser to be responsive to screen width -->
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="shortcut icon" href="/resources/img/favicon.ico">
  <link rel="icon" href="/resources/img/favicon.ico">


  <!-- Font Awesome -->
  <link rel="stylesheet" href="/resources/bo/plugins/fontawesome-free/css/all.min.css">
  <!-- Ionicons -->
  <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
  <!-- DataTables -->
  <link rel="stylesheet" href="/resources/bo/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
  <link rel="stylesheet" href="/resources/bo/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
  <!-- Theme style -->
  <link rel="stylesheet" href="/resources/bo/dist/css/adminlte.min.css">
  
  <!-- Google Font: Source Sans Pro -->
  <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet">

  <!-- CK에디터 -->
  <!-- <script src="https://cdn.ckeditor.com/ckeditor5/29.1.0/classic/ckeditor.js"></script> -->
  <!--
  <script src="https://cdn.ckeditor.com/ckeditor5/34.0.0/decoupled-document/ckeditor.js"></script>
  <link rel="stylesheet" href="/resources/css/content-styles.css" type="text/css">
  <script src="https://cdn.ckeditor.com/ckeditor5/34.0.0/classic/translations/ko.js"></script>
  -->
  <!-- <link rel="stylesheet" type="text/css" href="/resources/plugins/ckBuild/styles.css"> -->
  <link rel="stylesheet" href="/resources/bo/css/content-styles.css" type="text/css">
  
  <!--2022-03-10 추가 -->	
  <style type="text/css">
  	
  	/* 탭(bo-tabs.js) 안에 뜬 화면: 상단·왼쪽 메뉴·바닥글은 바깥 틀 것만 쓴다 */
  	html.in-tab .main-header, html.in-tab .main-sidebar, html.in-tab .main-footer { display: none !important; }
  	html.in-tab .content-wrapper { margin: 0 !important; }
  	.bTitle{ font-size:15px; }
  	.sTitle{ font-size:12px; height:30px; }
  	/* 모든 표 머리글 틀고정. :where 로 우선순위 0 이라 화면별 머리글 색·고정이 그대로 이긴다 */
  	:where(.table) > :where(thead) > :where(tr) > :where(th) { position: sticky; top: 0; z-index: 2; background-color: #fff; box-shadow: inset 0 -1px 0 #dee2e6; }
  	/* 가로 스크롤 상자 안에서도 고정되게 세로 스크롤을 상자 안으로 넣는다 */
  	:where(.table-responsive) { max-height: 80vh; overflow-y: auto; }
  	/* 표는 ui-table.js 가 스크롤 상자에 넣는다(.cal-panel 의 overflow:hidden 안에서도 머리글 고정·가로 스크롤) */
  	.tbl-scroll { max-height: 80vh; overflow: auto; }
  	/* 칸은 내용 폭에 맞추고 줄바꿈하지 않는다. 문단·이미지·입력칸이 든 칸은 제외. 아주 긴 글은 …(올리면 전체) */
  	:where(.table th, .table td):not(:has(p, br, img, ul, ol, table, textarea)) { white-space: nowrap; }
  	.td-cut { display: inline-block; max-width: 360px; overflow: hidden; text-overflow: ellipsis; vertical-align: bottom; }
  	/* 표 줄 간격·제목 여백을 줄여 한 화면에 줄을 더 보인다 */
  	.table th, .table td { padding: .35rem .55rem; }
  	.content-wrapper > .content > .card-header { padding-top: .45rem; padding-bottom: .45rem; }
  	/* 머리글 정렬 */
  	th.th-sort { cursor: pointer; user-select: none; }
  	th.th-sort:hover::after, th.th-sort:focus::after { content: ' ↕'; color: #9aa4ac; font-size: 10px; }
  	th.th-sort[aria-sort=ascending]::after { content: ' ▲'; color: #0b6e8a; font-size: 10px; }
  	th.th-sort[aria-sort=descending]::after { content: ' ▼'; color: #0b6e8a; font-size: 10px; }
  	/* 검색필터 접기: 접으면 검색어·기간·버튼만 한 줄, 라벨 숨김 */
  	.flt-closed { padding-top: 6px !important; padding-bottom: 6px !important; }
  	.flt-closed .flt-more, .flt-closed .form-row label { display: none; }
  	.flt-closed > .form-row:first-child > * { flex: 0 0 auto; width: auto; max-width: none; margin-bottom: 0 !important; }
  	.flt-closed input[type=search] { min-width: 260px; }
  	.flt-tg { margin-left: auto; }
  	/* ui-table.js 가 칸 맨 위로 올린 버튼 줄 */
  	.bo-act-top { margin: 0 0 .6rem !important; }

  </style>
  
  <script>
  	// 바깥 틀(bo-tabs.js)의 탭 안에서 열렸으면 그리기 전에 표시해 둔다
  	// ?embed=1: 다른 화면의 팝업(iframe) 안에 띄운 화면도 같은 방식으로 메뉴를 숨긴다(매출·매입 현황)
  	try { if (/[?&]embed=1\b/.test(location.search) || (window.top !== window.self && window.top.BO_TABS)) document.documentElement.className += ' in-tab'; } catch (e) {}
  </script>
  <link href="/resources/navereditor/css/smart_editor2.css" rel="stylesheet" type="text/css">
	
	<!-- 네이버 에디터 -->
