  <!-- <link rel="stylesheet" type="text/css" href="/resources/plugins/ckBuild/styles.css"> -->
  <link rel="stylesheet" href="/resources/bo/css/content-styles.css" type="text/css">
  
  <!--2022-03-10 추가 -->	
  <style type="text/css">
  	
  	/* 탭(bo-tabs.js) 안에 뜬 화면: 상단·왼쪽 메뉴·바닥글은 바깥 틀 것만 쓴다 */
  	html.in-tab .main-header, html.in-tab .main-sidebar, html.in-tab .main-footer { display: none !important; }
  	html.in-tab .content-wrapper { margin: 0 !important; }
  	.bTitle{ font-size:15px; }
  	.sTitle{ font-size:12px; height:30px; }
  	/* 모든 표 머리글 틀고정. :where 로 우선순위 0 이라 화면별 머리글 색·고정이 그대로 이긴다 */
  	:where(.table) > :where(thead) > :where(tr) > :where(th) { position: sticky; top: 0; z-index: 2; background-color: #fff; box-shadow: inset 0 -1px 0 #dee2e6; }
  	/* 가로 스크롤 상자 안에서도 고정되게 세로 스크롤을 상자 안으로 넣는다 */
  	:where(.table-responsive) { max-height: 80vh; overflow-y: auto; }
  	/* 표는 ui-table.js 가 스크롤 상자에 넣는다(.cal-panel 의 overflow:hidden 안에서도 머리글 고정·가로 스크롤) */
  	.tbl-scroll { max-height: 80vh; overflow: auto; }
  	/* 칸은 내용 폭에 맞추고 줄바꿈하지 않는다. 문단·이미지·입력칸이 든 칸은 제외. 아주 긴 글은 …(올리면 전체) */
  	:where(.table th, .table td):not(:has(p, br, img, ul, ol, table, textarea)) { white-space: nowrap; }
  	.td-cut { display: inline-block; max-width: 360px; overflow: hidden; text-overflow: ellipsis; vertical-align: bottom; }
  	/* 표 줄 간격·제목 여백을 줄여 한 화면에 줄을 더 보인다 */
  	.table th, .table td { padding: .35rem .55rem; }
  	.content-wrapper > .content > .card-header { padding-top: .45rem; padding-bottom: .45rem; }
  	/* 머리글 정렬 */
  	th.th-sort { cursor: pointer; user-select: none; }
  	th.th-sort:hover::after, th.th-sort:focus::after { content: ' ↕'; color: #9aa4ac; font-size: 10px; }
  	th.th-sort[aria-sort=ascending]::after { content: ' ▲'; color: #0b6e8a; font-size: 10px; }
  	th.th-sort[aria-sort=descending]::after { content: ' ▼'; color: #0b6e8a; font-size: 10px; }
  	/* 검색필터 접기: 접으면 검색어·기간·버튼만 한 줄, 라벨 숨김 */
  	.flt-closed { padding-top: 6px !important; padding-bottom: 6px !important; }
  	.flt-closed .flt-more, .flt-closed .form-row label { display: none; }
  	.flt-closed > .form-row:first-child > * { flex: 0 0 auto; width: auto; max-width: none; margin-bottom: 0 !important; }
  	.flt-closed input[type=search] { min-width: 260px; }
  	.flt-tg { margin-left: auto; }
  	/* ui-table.js 가 칸 맨 위로 올린 버튼 줄 */
  	.bo-act-top { margin: 0 0 .6rem !important; }
  	/* 피드백·업데이트 내역(bo-feedback.js) */
  	.main-header .bo-fb { position: relative; border-color: #0b6e8a; color: #0b6e8a !important; background: #eef9fc; margin-right: 8px; }
  	.bo-fb .fb-dot { position: absolute; top: -6px; right: -6px; min-width: 18px; padding: 0 5px; border-radius: 999px; background: #e0a800; color: #111; font-size: 10.5px; line-height: 18px; font-weight: 700; text-align: center; }
  	/* 색 배지: 모든 화면 한 벌(화면별 이름은 그대로 쓴다). 색: ok·good 초록, warn 노랑, bad 빨강, rent·info 파랑 */
  	.fb-pill, .eq-pill, .dp-pill, .sys-pill, .hm-pill { display: inline-block; padding: 0 8px; border-radius: 10px; font-size: 11px; font-weight: 700; background: #eef1f4; color: #444; white-space: nowrap; }
  	:is(.fb-pill, .eq-pill, .dp-pill, .sys-pill, .hm-pill):is(.ok, .good) { background: #e6f6ea; color: #17692f; }
  	:is(.fb-pill, .eq-pill, .dp-pill, .sys-pill, .hm-pill).warn { background: #fff5dc; color: #7a5600; }
  	:is(.fb-pill, .eq-pill, .dp-pill, .sys-pill, .hm-pill).bad { background: #fdeaea; color: #a32020; }
  	:is(.fb-pill, .eq-pill, .dp-pill, .sys-pill, .hm-pill):is(.rent, .info) { background: #dff3f9; color: #0b6e8a; }
  	/* 체크 칩: 모든 화면 한 벌. 칩 줄 여백(.pl-chks 등)만 화면에 둔다 */
  	.pl-chip { display: inline-flex; gap: 6px; align-items: center; padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(17,17,17,.15); font-weight: 700; font-size: 12.5px; color: #444; cursor: pointer; user-select: none; margin: 0; background: #fff; }
  	.pl-chip input { margin: 0; cursor: pointer; }
  	.pl-chip .cnt { background: rgba(17,17,17,.08); border-radius: 999px; padding: 0 7px; font-size: 11px; }
  	.pl-chip.on { border-color: #0b6e8a; background: #eef9fc; color: #0b6e8a; }
  	.pl-chip.secret.on { border-color: #6b3fa0; background: #f4effc; color: #6b3fa0; }
  	.pl-chip.alert.on { border-color: #a32020; background: #fdeaea; color: #a32020; }
  	.fb-seg { display: flex; gap: 4px; margin: 12px 0 8px; }
  	.fb-seg button { border: 1px solid rgba(17,17,17,.15); background: #fff; border-radius: 999px; padding: 2px 12px; font-size: 12px; font-weight: 700; color: #444; }
  	.fb-seg button.on { background: #111; border-color: #111; color: #fff; }
  	.fb-list { max-height: 45vh; overflow-y: auto; }
  	.fb-it { border: 1px solid rgba(17,17,17,.1); border-radius: 8px; padding: 7px 10px; margin-bottom: 6px; font-size: 13px; }
  	.fb-who { display: flex; gap: 8px; align-items: center; font-size: 11.5px; color: #5f6b75; } .fb-who .fb-pill { margin-left: auto; }
  	.fb-txt { white-space: pre-wrap; } .fb-why { color: #a32020; font-size: 12px; white-space: pre-wrap; } .fb-mute { color: #8a949c; }
  	.fb-meta { color: #5f6b75; font-size: 12px; margin-bottom: 8px; }
  	.fb-req { border: 1px solid #f0d58a; background: #fffaeb; border-radius: 8px; padding: 7px 12px; font-size: 12.5px; margin-bottom: 10px; } .fb-req b { color: #7a5600; }
  	.fb-spec { width: 100%; border: 1px solid rgba(17,17,17,.12); border-radius: 8px; background: #fff; margin-bottom: 10px; }
  	.fb-three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; font-size: 12.5px; }
  	.fb-three > div { border: 1px solid rgba(17,17,17,.12); border-radius: 8px; padding: 8px 10px; } .fb-three b { display: block; margin-bottom: 4px; } .fb-three ul { margin: 0; padding-left: 18px; }
  	.fb-new { display: inline-block; margin-left: 4px; padding: 0 5px; border-radius: 999px; background: #e0a800; color: #111; font-size: 10px; font-weight: 700; line-height: 15px; }
  	@media (max-width: 767px) { .fb-three { grid-template-columns: 1fr; } .main-header .bo-fb { padding: 6px 9px; } }

  	/* ── 전체 모양 다듬기(2026-11-13): 글꼴·주요 색(청록 #0b6e8a) 한 벌, 화면 제목, 표, 입력칸, 팝업, 바닥글 ── */
  	body, .tooltip, .popover, .bootbox, button, input, select, textarea { font-family: "Pretendard Variable", Pretendard, "Source Sans Pro", "Malgun Gothic", sans-serif; }
  	body { -webkit-font-smoothing: antialiased; letter-spacing: -.1px; }
  	.content-wrapper { background: #f4f6f9; }
  	/* 화면 제목 줄: 밑줄 대신 여백, 제목은 조금 크게 */
  	.content-wrapper > .content > .card-header { border-bottom: 0; background: transparent; padding: .9rem 1.25rem .2rem; }
  	.content-wrapper > .content > .card-header .card-title, .content-wrapper > .content > .card-header .bTitle { font-size: 18px; color: #111; letter-spacing: -.3px; }
  	/* 주 버튼: 부트스트랩 파랑 → 청록으로 통일 */
  	.btn-primary { background-color: #0b6e8a; border-color: #0b6e8a; }
  	.btn-primary:hover, .btn-primary:focus, .btn-primary:not(:disabled):not(.disabled):active { background-color: #095a71; border-color: #095a71; }
  	.btn-primary:focus, .btn-outline-primary:focus { box-shadow: 0 0 0 .2rem rgba(11,110,138,.25); }
  	.btn-outline-primary { color: #0b6e8a; border-color: #0b6e8a; }
  	.btn-outline-primary:hover, .btn-outline-primary:not(:disabled):not(.disabled):active { background-color: #0b6e8a; border-color: #0b6e8a; color: #fff; }
  	.btn-outline-secondary { color: #4a545c; border-color: #ced4da; background: #fff; }
  	.btn-outline-secondary:hover { background: #f1f3f5; border-color: #adb5bd; color: #111; }
  	.btn { border-radius: 6px; transition: background-color .15s, border-color .15s, color .15s, box-shadow .15s; }
  	.btn-sm { border-radius: 6px; }
  	/* 입력칸: 둥글게, 초점은 청록 */
  	.form-control { border-color: #d5dbe0; border-radius: 6px; }
  	.form-control:focus { border-color: #0b6e8a; box-shadow: 0 0 0 .2rem rgba(11,110,138,.15); }
  	.form-control::placeholder { color: #a3acb4; }
  	.custom-control-input:checked ~ .custom-control-label::before { background-color: #0b6e8a; border-color: #0b6e8a; }
  	input[type=checkbox], input[type=radio] { accent-color: #0b6e8a; }
  	/* 표: 머리글은 옅은 회색 바탕·작은 진회색 글씨, 줄 경계는 옅게, 올리면 청록 바탕 */
  	.table { color: #222; }
  	.table thead th { font-size: 12.5px; font-weight: 600; color: #4a545c; border-bottom-width: 1px; }
  	:where(.table) > :where(thead) > :where(tr) > :where(th) { background-color: #f7f9fa; box-shadow: inset 0 -1px 0 #e3e7ea; }
  	.table td, .table th { border-top-color: #edf0f2; }
  	.table-hover tbody tr:hover { background-color: #f1f9fb; }
  	/* 팝업: 둥글고 그림자 */
  	.modal-content { border: 0; border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,.18); }
  	.modal-header { border-bottom-color: #edf0f2; padding: .85rem 1.1rem; }
  	.modal-header .modal-title { font-size: 16px; font-weight: 700; }
  	.modal-footer { border-top-color: #edf0f2; background: #fafbfc; border-radius: 0 0 12px 12px; }
  	/* 바닥글: 작고 옅게 */
  	.main-footer { padding: .55rem 1rem; font-size: 12px; color: #8a949c; background: #fff; border-top-color: #e9ecef; }
  	.main-footer strong { font-weight: 600; } .main-footer a { color: #5f6b75 !important; }
  	/* 얇은 스크롤바 */
  	.tbl-scroll, .table-responsive, .modal-body { scrollbar-width: thin; scrollbar-color: #c5cdd3 transparent; }

  </style>
  
  <script>
  	// 바깥 틀(bo-tabs.js)의 탭 안에서 열렸으면 그리기 전에 표시해 둔다
  	// ?embed=1: 다른 화면의 팝업(iframe) 안에 띄운 화면도 같은 방식으로 메뉴를 숨긴다(매출·매입 현황)
  	try { if (/[?&]embed=1\b/.test(location.search) || (window.top !== window.self && window.top.BO_TABS)) document.documentElement.className += ' in-tab'; } catch (e) {}
  </script>
  <link href="/resources/navereditor/css/smart_editor2.css" rel="stylesheet" type="text/css">
	
	<!-- 네이버 에디터 -->
	<script type="text/javascript" src="/resources/navereditor/js/jindo.min.js" charset="utf-8"></script>
	<script type="text/javascript" src="/resources/navereditor/js/jindo_component.js" charset="utf-8"></script>
	<script type="text/javascript" src="/resources/navereditor/js/SE2B_Configuration_Service.js" charset="utf-8"></script>	<!-- 설정 파일 -->
	<script type="text/javascript" src="/resources/navereditor/js/SE2B_Configuration_General.js" charset="utf-8"></script>	<!-- 설정 파일 -->
	<script type="text/javascript" src="/resources/navereditor/js/SE2BasicCreator.js" charset="utf-8"></script>
	
	<script src='/resources/navereditor/js/smarteditor2.min.js' charset='utf-8'></script>
	<script src='/resources/navereditor/photo_uploader/plugin/hp_SE2M_AttachQuickPhoto.js' charset='utf-8'></script>
  
</head>

<script type="text/javascript">

	function logout() {
		if (!confirm("로그아웃 하시겠습니까?")) {
	        return false;
	    } else {
	    	location.href='/admin/logout.do';
	    }
	}

</script>