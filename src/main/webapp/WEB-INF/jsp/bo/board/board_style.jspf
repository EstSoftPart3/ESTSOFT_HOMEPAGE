<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%-- 게시판 상세·작성 화면 공통 스타일 (calendar_style.jspf 위에 얹는다) --%>
<style>
	.brd-crumb { font-size: 12px; color: #6c757d; margin-bottom: 10px; }
	.brd-crumb a { color: #16a0c4; }
	.brd-head { padding: 16px 20px; border-bottom: 1px solid rgba(17,17,17,.06); }
	.brd-title { font-size: 19px; font-weight: 700; margin: 0 0 6px; word-break: break-word; }
	.brd-meta { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; color: #6c757d; }
	.brd-extra { display: flex; flex-wrap: wrap; gap: 20px; padding: 10px 20px; font-size: 13px; background: #fafbfc; border-bottom: 1px solid rgba(17,17,17,.06); }
	.brd-red { background: #fdecee; color: #dc3545; }
	.brd-body { display: block; width: 100%; height: 160px; border: 0; }
	.brd-bar { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; padding: 12px 20px; background: #fafbfc; border-top: 1px solid rgba(17,17,17,.06); }
	.brd-bar.sticky { position: sticky; bottom: 0; z-index: 5; }
	.brd-thread { display: flex; gap: 10px; align-items: center; font-size: 13px; padding: 8px 20px; }
	.brd-thread .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.brd-thread .m { color: #6c757d; font-size: 12px; white-space: nowrap; }
	.brd-thread.active-row { background: #eef9fc; font-weight: 600; }
	.brd-form { padding: 18px 20px 6px; }
	.brd-form .form-group { display: grid; grid-template-columns: 90px 1fr; gap: 10px; align-items: center; }
	.brd-form .form-group > label { margin: 0; font-size: 12px; font-weight: 600; color: #555; }
	.brd-form .form-group.top { align-items: start; }
	.brd-quote { margin: 14px 20px 0; border-left: 3px solid #16a0c4; background: #f6fbfd; border-radius: 0 6px 6px 0; font-size: 13px; }
	.brd-quote summary { padding: 9px 14px; cursor: pointer; color: #555; }
	.brd-quote .brd-body { border-top: 1px solid rgba(17,17,17,.06); background: #fff; }
	@media (max-width: 767px) { .brd-form .form-group { grid-template-columns: 1fr; gap: 4px; } }
</style>
