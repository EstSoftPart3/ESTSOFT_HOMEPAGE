<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%-- 업무툴(캘린더) 화면 공통 스타일 --%>
<style>
	.cal-page .card-body { background: #f4f6f9; }
	.cal-panel { background: #fff; border: 1px solid rgba(17,17,17,.08); border-radius: 10px; margin-bottom: 14px; box-shadow: 0 1px 2px rgba(0,0,0,.04); overflow: hidden; }
	.cal-panel-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; padding: 10px 14px; font-weight: 600; font-size: 14px; border-bottom: 1px solid rgba(17,17,17,.06); }
	.cal-panel-head[data-toggle] { cursor: pointer; }
	.cal-panel-body { padding: 12px 14px 6px; }
	.cal-panel label { font-size: 12px; color: #555; margin-bottom: 3px; }
	.cal-table { font-size: 13px; }
	.cal-table thead th { background: #fafbfc; font-weight: 600; color: #444; border-top: 0; }
	.cal-table td { vertical-align: middle; }
	.cal-table .cal-title { font-weight: 500; color: #111; }
	.cal-table tr.is-confirmed { background: #f6fbf7; }
	.cal-empty { text-align: center; color: #888; padding: 32px 0 !important; }

	/* 분류별 보기 탭 */
	.cate-tabs { display: flex; flex-wrap: wrap; gap: 6px; padding: 12px 14px; }
	.cate-tab { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(17,17,17,.12); background: #fff; color: #444; font-size: 13px; font-weight: 600; cursor: pointer; }
	.cate-tab:hover { background: rgba(22,213,255,.12); }
	.cate-tab.active { background: #111; border-color: #111; color: #fff; }
	.cate-tab .cnt { min-width: 20px; padding: 1px 6px; border-radius: 999px; background: rgba(17,17,17,.08); font-size: 11px; text-align: center; }
	.cate-tab.active .cnt { background: rgba(255,255,255,.25); }
	.cate-badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; background: #eef1f4; color: #333; }
</style>
